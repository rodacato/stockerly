<% content_for(:title, "#{t(".titulo")} | Stockerly") %>

<main class="flex-1 flex flex-col items-center py-10 px-4">
  <div class="w-full max-w-2xl">
    <%= render "onboarding/step_header", step: 2 %>

    <div class="mb-8">
      <h1 class="font-display text-3xl font-bold text-fg-default leading-tight mb-2"><%= t(".titulo") %></h1>
      <p class="text-fg-subtle"><%= t(".subtitulo") %></p>
    </div>

    <%= form_with url: onboarding_save_assets_path, method: :post, class: "mb-10" do |f| %>
      <% @catalog.each do |category_key, assets| %>
        <div class="mb-6">
          <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-fg-subtle mb-3">
            <%= Administration::Domain::AssetCatalog.category_label(category_key) %>
          </h2>
          <div class="space-y-2">
            <% assets.each do |asset| %>
              <% default_selected = Administration::Domain::AssetCatalog::DEFAULT_SELECTED.include?(asset[:symbol]) %>
              <label class="flex items-center gap-3 p-4 rounded-xl border cursor-pointer transition-all
                            <%= default_selected ? 'border-primary bg-primary-muted' : 'border-border-default bg-bg-surface hover:border-primary' %>">
                <input type="checkbox" name="symbols[]" value="<%= asset[:symbol] %>"
                       <%= 'checked' if default_selected %>
                       class="size-5 rounded-full border-border-default text-primary focus:ring-primary">
                <span class="font-mono font-bold text-sm text-fg-default"><%= asset[:symbol] %></span>
                <span class="text-sm text-fg-subtle truncate flex-1"><%= asset[:name] %></span>
                <% if asset[:exchange] %>
                  <span class="font-mono text-xs text-fg-subtle uppercase shrink-0"><%= asset[:exchange] %></span>
                <% end %>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex items-center justify-between pt-6">
        <%= link_to onboarding_integrations_path, class: "inline-flex items-center gap-1 text-sm font-medium text-fg-subtle hover:text-primary transition-colors" do %>
          <span class="material-symbols-outlined text-base">arrow_back</span>
          <%= t(".atras") %>
        <% end %>
        <div class="flex items-center gap-4">
          <%= link_to t(".omitir"), onboarding_complete_path, class: "text-sm font-medium text-fg-subtle hover:text-primary transition-colors" %>
          <button type="submit" class="bg-primary hover:bg-primary-hover text-white font-bold py-3 px-8 rounded-xl transition-all shadow-lg">
            <%= t(".continuar") %>
          </button>
        </div>
      </div>
    <% end %>
  </div>
</main>

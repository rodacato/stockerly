<% content_for(:title, "#{t(".titulo")} | Stockerly") %>

<main class="flex-1 flex flex-col items-center py-10 px-4">
  <div class="w-full max-w-2xl">
    <%= render "onboarding/step_header", step: 4 %>

    <div class="mb-8 text-center">
      <div class="size-16 rounded-full bg-positive-bg flex items-center justify-center mx-auto mb-4">
        <%= icon_svg "check", class: "text-4xl text-positive" %>
      </div>
      <h1 class="font-display text-3xl font-bold text-fg-default leading-tight mb-2"><%= t(".titulo") %></h1>
      <p class="text-fg-subtle"><%= t(".subtitulo") %></p>
    </div>

    <div class="space-y-3 mb-10">
      <div class="<%= card_classes("flex items-center gap-4 p-4") %>">
        <div class="size-12 rounded-lg bg-primary-muted flex items-center justify-center shrink-0">
          <%= icon_svg "database", class: "text-2xl text-primary" %>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-xl font-bold text-fg-default"><%= @integrations_configured %>/<%= @integrations_total %></p>
          <p class="text-sm text-fg-subtle"><%= t(".integraciones") %></p>
        </div>
      </div>

      <div class="<%= card_classes("flex items-center gap-4 p-4") %>">
        <div class="size-12 rounded-lg bg-positive-bg flex items-center justify-center shrink-0">
          <%= icon_svg "monitoring", class: "text-2xl text-positive" %>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-xl font-bold text-fg-default"><%= @assets_count %></p>
          <p class="text-sm text-fg-subtle"><%= t(".activos") %></p>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center gap-3">
      <%= button_to onboarding_launch_path, method: :post, form_class: "w-full",
            class: button_classes(:primary, :lg, "flex w-full items-center justify-center gap-2 shadow-lg") do %>
        <%= t(".lanzar") %>
        <%= icon_svg "rocket_launch", class: "text-lg", "aria-hidden": "true" %>
      <% end %>
      <%= button_to t(".sin_sincronizar"), onboarding_launch_path(launch_sync: "false"), method: :post,
            class: "text-sm font-medium text-fg-subtle hover:text-primary-fg transition-colors py-2" %>
      <%= link_to onboarding_security_path, class: "inline-flex items-center gap-1 text-sm font-medium text-fg-subtle hover:text-primary-fg transition-colors" do %>
        <%= icon_svg "arrow_back", class: "text-base" %>
        <%= t(".atras") %>
      <% end %>
    </div>
  </div>
</main>

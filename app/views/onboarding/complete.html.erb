<% content_for(:title, "#{t(".titulo")} | Stockerly") %>

<main class="flex-1 flex flex-col items-center py-10 px-4">
  <div class="w-full max-w-2xl">
    <%= render "onboarding/step_header", step: 3 %>

    <div class="mb-8 text-center">
      <div class="size-16 rounded-full bg-positive/10 flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-4xl text-positive">check</span>
      </div>
      <h1 class="font-display text-3xl font-bold text-fg-default leading-tight mb-2"><%= t(".titulo") %></h1>
      <p class="text-fg-subtle"><%= t(".subtitulo") %></p>
    </div>

    <div class="space-y-3 mb-10">
      <div class="flex items-center gap-4 bg-bg-surface rounded-xl border border-border-default p-4">
        <div class="size-12 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl text-primary">database</span>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-xl font-bold text-fg-default"><%= @integrations_configured %>/<%= @integrations_total %></p>
          <p class="text-sm text-fg-subtle"><%= t(".integraciones") %></p>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-bg-surface rounded-xl border border-border-default p-4">
        <div class="size-12 rounded-lg bg-positive/10 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl text-positive">monitoring</span>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-xl font-bold text-fg-default"><%= @assets_count %></p>
          <p class="text-sm text-fg-subtle"><%= t(".activos") %></p>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-bg-surface rounded-xl border border-border-default p-4">
        <div class="size-12 rounded-lg bg-warning/10 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl text-warning">sync</span>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-xl font-bold text-fg-default"><%= t(".listo") %></p>
          <p class="text-sm text-fg-subtle"><%= t(".sync") %></p>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center gap-3">
      <%= button_to onboarding_launch_path, method: :post, form_class: "w-full",
            class: "flex w-full h-14 items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl shadow-lg shadow-primary/20 transition-all" do %>
        <%= t(".lanzar") %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">rocket_launch</span>
      <% end %>
      <%= button_to t(".sin_sincronizar"), onboarding_launch_path(launch_sync: "false"), method: :post,
            class: "text-sm font-medium text-fg-subtle hover:text-primary transition-colors py-2" %>
      <%= link_to onboarding_assets_path, class: "inline-flex items-center gap-1 text-sm font-medium text-fg-subtle hover:text-primary transition-colors" do %>
        <span class="material-symbols-outlined text-base">arrow_back</span>
        <%= t(".atras") %>
      <% end %>
    </div>
  </div>
</main>

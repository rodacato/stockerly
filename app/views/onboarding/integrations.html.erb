<% content_for(:title, "#{t(".titulo")} | Stockerly") %>

<main class="flex-1 flex flex-col items-center py-10 px-4">
  <div class="w-full max-w-2xl">
    <%= render "onboarding/step_header", step: 1 %>

    <div class="mb-8">
      <h1 class="font-display text-3xl font-bold text-fg-default leading-tight mb-2"><%= t(".titulo") %></h1>
      <p class="text-fg-subtle"><%= t(".subtitulo") %></p>
    </div>

    <%= form_with url: onboarding_save_integrations_path, method: :patch, class: "space-y-3 mb-10" do |f| %>
      <% keyed, public_sources = @integrations.partition { |i| MarketData::Domain::ProviderDirectory.for(i.provider_name)&.requires_key } %>

      <% keyed.each do |integration| %>
        <% info = MarketData::Domain::ProviderDirectory.for(integration.provider_name) %>
        <div class="bg-bg-surface rounded-xl border border-border-default p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-xl text-primary">database</span>
            </div>
            <div class="min-w-0">
              <p class="font-semibold text-fg-default"><%= integration.provider_name %></p>
              <p class="font-mono text-xs text-fg-subtle uppercase tracking-wider"><%= integration.provider_type %></p>
            </div>
          </div>

          <% if info&.description %>
            <p class="text-sm text-fg-subtle mb-2"><%= info.description %></p>
          <% end %>

          <%# The key is skippable, so the screen has to say what skipping costs. %>
          <% if info&.without %>
            <p class="flex items-start gap-2 rounded-lg bg-bg-muted px-3 py-2 mb-3 text-sm text-fg-subtle">
              <span class="material-symbols-outlined text-base" aria-hidden="true">block</span>
              <span><%= t(".sin_esta_llave") %> <%= info.without %></span>
            </p>
          <% end %>

          <label class="block text-sm text-fg-subtle mb-1" for="api_key_<%= integration.id %>"><%= t(".api_key") %></label>
          <input type="text" id="api_key_<%= integration.id %>" name="api_keys[<%= integration.id %>]" autocomplete="off"
                 placeholder="<%= t('.api_key_placeholder', provider: integration.provider_name) %>"
                 class="w-full px-3 py-2.5 text-sm bg-bg-canvas border border-border-default rounded-lg text-fg-default placeholder:text-fg-subtle outline-none focus:ring-2 focus:ring-primary">
          <% if info&.url %>
            <a href="<%= info.url %>" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1 mt-2 text-sm font-semibold text-primary hover:underline">
              <%= t(".donde_consigo") %>
              <span class="material-symbols-outlined text-sm">open_in_new</span>
            </a>
          <% end %>
        </div>
      <% end %>

      <% if public_sources.any? %>
        <div class="rounded-xl bg-bg-muted p-5">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-fg-subtle mb-4"><%= t(".publicas") %></p>
          <div class="space-y-4">
            <% public_sources.each do |integration| %>
              <% info = MarketData::Domain::ProviderDirectory.for(integration.provider_name) %>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-lg text-positive mt-0.5">check_circle</span>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-fg-default"><%= integration.provider_name %></p>
                  <% if info&.description %>
                    <p class="text-sm text-fg-subtle"><%= info.description %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex items-center justify-between pt-6">
        <%= link_to t(".omitir"), onboarding_assets_path, class: "text-sm font-medium text-fg-subtle hover:text-primary transition-colors" %>
        <button type="submit" class="bg-primary hover:bg-primary/90 text-white font-bold py-3 px-8 rounded-xl transition-all shadow-lg shadow-primary/25">
          <%= t(".continuar") %>
        </button>
      </div>
    <% end %>
  </div>
</main>

<%# Usage: render "onboarding/step_header", step: 1 %>
<% total = OnboardingController::STEPS %>
<%# Steps behind the reader, not the ordinal of the one on screen: step 1 opens
    empty and the bar only fills at the hand-off. Step 3 is drawn by three
    screens on purpose (D122), so it deliberately sits still across them. %>
<% percent = ((step - 1) * 100 / total) %>
<div class="mb-10">
  <div class="flex justify-between items-baseline mb-3">
    <span class="font-mono text-xs uppercase tracking-widest text-fg-subtle">
      <%= t(".paso", step: step, total: total) %>
    </span>
    <span class="font-mono text-xs text-fg-subtle"><%= percent %>%</span>
  </div>
  <div class="h-1.5 w-full bg-bg-muted rounded-full overflow-hidden">
    <div class="h-full bg-primary rounded-full transition-all" style="width: <%= percent %>%"></div>
  </div>
</div>

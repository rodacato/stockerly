<%# One notice as a card, per `reglas-bandeja`. Turbo-Stream prepend targets
    this too, so the id stays. %>
<% unread = !notification.read? %>
<li id="<%= dom_id(notification) %>" class="<%= card_classes("flex items-start gap-3 p-4") %>">
  <span class="flex size-10 shrink-0 items-center justify-center rounded-lg <%= notification_icon_style(notification) %>">
    <span class="material-symbols-outlined text-xl" aria-hidden="true"><%= notification_icon(notification) %></span>
  </span>

  <div class="min-w-0 flex-1">
    <p class="<%= unread ? 'font-semibold text-fg-default' : 'text-fg-subtle' %>"><%= notification.title %></p>
    <% if notification.body.present? %>
      <p class="text-sm text-fg-subtle"><%= notification.body %></p>
    <% end %>
    <p class="font-mono text-xs text-fg-subtle"><%= format_notification_time(notification) %></p>
  </div>

  <% if unread %>
    <%= button_to mark_as_read_notification_path(notification), method: :patch, form_class: "shrink-0",
          class: "flex size-8 items-center justify-center rounded-full text-primary",
          aria: { label: t("notifications.index.marcar_leida") } do %>
      <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
    <% end %>
  <% end %>
</li>

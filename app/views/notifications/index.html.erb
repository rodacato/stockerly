<% content_for :page_title, t(".titulo") %>
<% content_for :header_bar do %>
  <%= render "components/header_bar", title: t(".titulo"), back_path: alerts_path %>
<% end %>

<div class="mx-auto flex max-w-3xl flex-col gap-6">
  <div class="flex items-baseline justify-between gap-3">
    <p class="text-fg-subtle"><%= t(".descripcion") %></p>
    <% if @counts[:unread].to_i.positive? %>
      <%= button_to t(".marcar_todas"), mark_all_read_notifications_path, method: :patch,
            form_class: "shrink-0",
            class: "text-sm font-semibold text-primary hover:underline" %>
    <% end %>
  </div>

  <%# Four buckets, one per thing the app has to say. The enum already drew
      this line; the old filter collapsed three of its values into one. %>
  <div class="flex flex-wrap gap-2">
    <% [ [ "todos", t(".todas"), @counts[:all] ],
         [ "alertas", t(".alertas"), @counts[:alertas] ],
         [ "reportes", t(".reportes"), @counts[:reportes] ],
         [ "cetes", t(".cetes"), @counts[:cetes] ] ].each do |slug, label, count| %>
      <% on = (@tipo == slug) %>
      <%= link_to notifications_path(tipo: slug, estado: @estado),
            class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm transition-colors #{on ? 'border-primary bg-primary-muted font-semibold text-primary' : 'border-border-default text-fg-default'}" do %>
        <%= label %>
        <span class="font-mono text-xs"><%= count.to_i %></span>
      <% end %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div id="notifications" class="flex flex-col gap-6">
      <%# The first group is the newest, so a live arrival belongs at its head —
          that is why it, and only it, carries the Turbo Stream target. %>
      <% group_notifications_by_date(@notifications).each_with_index do |(heading, notices), index| %>
        <section class="flex flex-col gap-3">
          <h2 class="font-mono text-xs uppercase tracking-widest text-fg-subtle"><%= heading %></h2>
          <%= tag.ul id: ("notifications_list" if index.zero?), class: "flex flex-col gap-3" do %>
            <%= render partial: "notifications/notification_row", collection: notices, as: :notification %>
          <% end %>
        </section>
      <% end %>
    </div>

    <% if @counts[:read].to_i.positive? %>
      <%= button_to destroy_read_notifications_path, method: :delete,
            form: { data: { turbo_confirm: t(".confirmar_borrado") }, class: "self-center" },
            class: "inline-flex items-center gap-2 text-sm font-medium text-fg-subtle transition-colors hover:text-negative" do %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">delete</span>
        <%= t(".borrar_leidas") %>
      <% end %>
    <% end %>
  <% else %>
    <%# An empty bucket is not an empty inbox. Saying "nothing here yet" while
        two notices sit one chip away is a lie the filter would tell daily. %>
    <p class="rounded-xl border border-border-default bg-bg-surface p-6 text-center text-sm text-fg-subtle">
      <%= @counts[:all].to_i.positive? ? t(".sin_coincidencias") : t(".vacio") %>
    </p>
  <% end %>
</div>

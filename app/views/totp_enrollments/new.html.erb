<% content_for :page_title, t(".titulo") %>
<% content_for :header_bar do %>
  <%= render "components/header_bar", title: t(".titulo"), back_path: @return_path %>
<% end %>

<div class="mx-auto flex max-w-md flex-col gap-6">
  <p class="text-sm text-fg-subtle"><%= t(".subtitulo") %></p>

  <%= render "shared/flash_alert", message: take_flash(:alert) %>

  <div class="<%= card_classes("flex flex-col items-center gap-4 p-5") %>">
    <%# White plate under the QR on purpose: a dark surface behind the modules
        breaks the contrast every scanner depends on. %>
    <div class="rounded-xl bg-white p-3 [&_svg]:size-48">
      <%= totp_qr_svg(@enrollment[:provisioning_uri]) %>
    </div>

    <div class="flex w-full flex-col gap-1.5 border-t border-border-default pt-4 text-center">
      <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle"><%= t(".clave_manual") %></p>
      <p class="select-all font-mono text-sm font-semibold tracking-wider text-fg-default">
        <%= @enrollment[:formatted_secret] %>
      </p>
    </div>
  </div>

  <%= form_with url: totp_enrollment_path, method: :post, class: "flex flex-col gap-4" do %>
    <label class="flex flex-col gap-1.5">
      <span class="text-sm text-fg-subtle"><%= t(".codigo") %></span>
      <%= tag.input type: "text", name: "code", inputmode: "numeric", autocomplete: "one-time-code",
                    pattern: "[0-9]*", maxlength: 6, required: true, autofocus: true, placeholder: "000000",
                    class: field_classes(:lg, "text-center font-mono text-2xl! tracking-[0.4em]") %>
    </label>

    <button type="submit"
            class="<%= button_classes(:primary, :lg, "w-full") %>">
      <%= t(".activar") %>
    </button>
  <% end %>

  <%= link_to t(".ahora_no"), @return_path, class: "text-center text-sm text-fg-subtle hover:underline" %>
</div>

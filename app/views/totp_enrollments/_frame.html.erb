<%# Enrolment opens from Ajustes or from the wizard's security step, and wears
    the frame of whichever it came from (D122) — unless the caller asks for
    `chromeless`, which the codes screen does from both doors (D148): it takes
    the bare frame and drops the step header with it.
    Locals: title, subtitle, subtitle_tone, body, chromeless (default false). %>
<% chromeless = local_assigns.fetch(:chromeless, false) %>
<% if current_user.onboarded? && !chromeless %>
  <% content_for :header_bar do %>
    <%= render "components/header_bar", title: title, back_path: @return_path %>
  <% end %>

  <div class="mx-auto flex max-w-md flex-col gap-6">
    <p class="text-sm <%= subtitle_tone %>"><%= subtitle %></p>
    <%= body %>
  </div>
<% else %>
  <% content_for(:title, "#{title} | Stockerly") %>

  <main class="flex-1 flex flex-col items-center py-10 px-4">
    <div class="w-full max-w-2xl">
      <% unless chromeless %>
        <%= render "onboarding/step_header", step: 3 %>
      <% end %>

      <div class="mb-8">
        <h1 class="font-display text-3xl font-bold text-fg-default leading-tight mb-2"><%= title %></h1>
        <p class="text-fg-subtle"><%= subtitle %></p>
      </div>

      <div class="flex flex-col gap-6">
        <%= body %>
      </div>
    </div>
  </main>
<% end %>

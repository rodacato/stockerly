<% content_for(:title, t(".title")) %>

<main class="flex-1 flex flex-col items-center py-12 px-4">
  <div class="w-full max-w-[900px] space-y-8">
    <%# Greeting %>
    <div>
      <h1 class="text-3xl font-bold text-fg-default tracking-tight"><%= t(".saludo", name: current_user.full_name.split.first) %></h1>
      <p class="text-sm text-fg-subtle mt-2"><%= t(".subtitulo") %></p>
    </div>

    <%# Context card + starting guide %>
    <%= render "shared/welcome_body" %>

    <%# Primary CTA %>
    <%= button_to complete_welcome_path,
          method: :post,
          class: "w-full inline-flex items-center justify-center gap-2 cursor-pointer rounded-lg bg-primary px-4 py-3 font-semibold text-fg-inverse transition-colors hover:bg-primary-hover" do %>
      <span><%= t(".cta") %></span>
      <span class="material-symbols-outlined text-lg">arrow_forward</span>
    <% end %>
  </div>
</main>

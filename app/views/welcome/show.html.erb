<% content_for(:title, t(".title")) %>

<main class="flex-1 flex flex-col items-center py-12 px-4">
  <div class="w-full max-w-[900px] space-y-8">
    <%# Greeting %>
    <div>
      <h1 class="font-display text-3xl font-bold text-fg-default tracking-tight"><%= t(".saludo", name: first_name_of(current_user)) %></h1>
      <p class="text-sm text-fg-subtle mt-2"><%= t(".subtitulo") %></p>
    </div>

    <%# Context card + starting guide %>
    <%= render "shared/welcome_body", complete: true %>

    <%# Primary CTA %>
    <%= button_to complete_welcome_path,
          method: :post,
          class: button_classes(:primary, :lg, "w-full inline-flex items-center justify-center gap-2 cursor-pointer") do %>
      <span><%= t(".cta") %></span>
      <%= icon_svg "arrow_forward", class: "text-lg" %>
    <% end %>
  </div>
</main>

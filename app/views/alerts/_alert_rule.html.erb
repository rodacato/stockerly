<%# One rule as a card, per `reglas-lista`. It was a <tr> in a six-column table
    that overflowed a phone — the last column was cut mid-word.
    locals: (rule:) %>
<% is_active = rule.active? %>
<% explainer = alert_rule_explainer(rule) %>
<%= tag.li id: dom_id(rule), class: card_classes("relative flex flex-col gap-1 p-4"),
           data: (explainer ? { controller: "metric-tooltip" } : {}) do %>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2 min-w-0">
      <span class="font-mono font-bold text-fg-default"><%= alert_rule_scope_label(rule) %></span>
      <% unless rule.marketwide? %>
        <span class="rounded-full bg-bg-muted px-2 py-0.5 text-xs text-fg-subtle"><%= alert_rule_kind_label(rule) %></span>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-1">
      <%= link_to edit_alert_path(rule),
            data: { turbo_frame: "rule_sheet", turbo_action: "advance" },
            class: "flex size-8 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-fg-default",
            aria: { label: t("alerts.index.editar") } do %>
        <%= icon_svg "edit", class: "text-lg", "aria-hidden": "true" %>
      <% end %>

      <%= button_to toggle_alert_path(rule), method: :patch, form_class: "inline-flex",
            class: "flex size-8 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-fg-default",
            aria: { label: is_active ? t("alerts.index.pausar") : t("alerts.index.activar") } do %>
        <%= icon_svg((is_active ? "pause" : "play_arrow"), class: "text-lg", "aria-hidden": "true") %>
      <% end %>

      <%= button_to alert_path(rule), method: :delete,
            form: { data: { turbo_confirm: t("alerts.index.confirmar_borrado") } },
            class: "flex size-8 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-negative",
            aria: { label: t("alerts.index.eliminar") } do %>
        <%= icon_svg "delete", class: "text-lg", "aria-hidden": "true" %>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-1.5">
    <p class="font-semibold text-fg-default"><%= alert_condition_label(rule) %></p>
    <% if explainer %>
      <button type="button" data-action="click->metric-tooltip#toggle"
              class="shrink-0 cursor-help text-fg-subtle transition-colors hover:text-primary"
              aria-label="<%= t("alerts.index.explicacion_detalle", condition: alert_condition_label(rule)) %>">
        <%= icon_svg "info", class: "text-sm", "aria-hidden": "true" %>
      </button>
    <% end %>
  </div>
  <p class="text-sm text-fg-subtle"><%= alert_condition_summary(rule) %></p>

  <p class="font-mono text-sm font-semibold text-fg-default">
    <% if rule.last_triggered_at %>
      <%= t("alerts.index.disparo_hace", when: time_ago_in_words(rule.last_triggered_at)) %>
    <% else %>
      <%= t("alerts.index.nunca_disparo") %>
    <% end %>
  </p>

  <% cadence = alert_check_cadence_label(rule) if is_active %>
  <% if cadence %>
    <p class="text-sm text-fg-subtle"><%= cadence %></p>
  <% end %>

  <%# cooldown_minutes has been on the model since it was created and no screen
      ever showed it. %>
  <p class="font-mono text-xs text-fg-subtle">
    <%= is_active ? t("alerts.index.activa") : t("alerts.index.pausada") %>
    ·
    <%= alert_cooldown_label(rule) %>
  </p>

  <% if explainer %>
    <div data-metric-tooltip-target="popover"
         class="absolute left-0 top-full z-20 mt-1 hidden w-full overflow-hidden rounded-xl border border-border-default bg-bg-surface shadow-xl">
      <div class="flex items-center justify-between gap-2 border-b border-border-default px-4 py-3">
        <h3 class="flex items-center gap-2 text-sm font-semibold text-fg-default">
          <%= icon_svg "school", class: "text-lg text-primary", "aria-hidden": "true" %>
          <%= alert_condition_label(rule) %>
        </h3>
        <button type="button" data-action="click->metric-tooltip#close"
                class="text-fg-subtle transition-colors hover:text-fg-default"
                aria-label="<%= t("alerts.index.explicacion_cerrar") %>">
          <%= icon_svg "close", class: "text-lg", "aria-hidden": "true" %>
        </button>
      </div>
      <p class="p-4 text-sm leading-relaxed text-fg-default"><%= explainer %></p>
    </div>
  <% end %>
<% end %>

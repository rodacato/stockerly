<%# Read-only mirror of the delivery preferences. The switches live in /profile,
    which is the one place that persists them; duplicating them here produced
    toggles that moved and saved nothing. %>
<%# locals: (preference:) %>
<section class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-5 py-5 shadow-sm">
  <h2 class="text-base font-semibold tracking-tight text-slate-900 dark:text-white mb-1">Cómo te aviso</h2>
  <p class="text-[11.5px] text-slate-500 dark:text-slate-400 mb-3">Los avisos siempre llegan a tu campana. El correo es opcional.</p>

  <%
    channels = [
      { label: "Resumen diario por correo",  sub: "Un solo correo a las 18:30 CDMX",              on: preference&.email_digest },
      { label: "Avisos urgentes por correo", sub: "Un correo aparte al disparar una regla",       on: preference&.urgent_email }
    ]
  %>
  <div class="flex flex-col">
    <% channels.each_with_index do |channel, i| %>
      <div class="flex items-center gap-4 py-3 <%= 'border-t border-slate-200 dark:border-slate-700' if i.positive? %>">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-slate-900 dark:text-white"><%= channel[:label] %></p>
          <p class="mt-0.5 text-[11.5px] text-slate-500 dark:text-slate-400"><%= channel[:sub] %></p>
        </div>
        <% on_classes  = "bg-success/10 text-success-fg dark:bg-success/20 dark:text-success" %>
        <% off_classes = "bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400" %>
        <span class="shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= channel[:on] ? on_classes : off_classes %>">
          <%= channel[:on] ? "Activado" : "Desactivado" %>
        </span>
      </div>
    <% end %>
  </div>

  <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
    <span class="material-symbols-outlined text-[14px]">mail</span>
    <% if current_user&.email.present? %>
      <span>Los correos llegan a</span>
      <span class="font-mono font-medium text-slate-700 dark:text-slate-200"><%= current_user.email %></span>
    <% end %>
    <span class="flex-1"></span>
    <%= link_to "Cambiar en Ajustes →", profile_path, class: "font-medium text-primary hover:underline" %>
  </div>
</section>

<%# "Últimos disparos" per `reglas-lista`: what actually fired, linking to the
    inbox that holds the rest. locals: (events:) %>
<section class="flex flex-col gap-3">
  <div class="flex items-baseline justify-between gap-3">
    <h2 class="font-display text-2xl font-bold text-fg-default"><%= t("alerts.index.ultimos_disparos") %></h2>
    <%= link_to t("alerts.index.ver_bandeja"), notifications_path,
                class: "text-sm font-semibold text-primary hover:underline" %>
  </div>

  <% if events.any? %>
    <ul class="<%= card_classes("flex flex-col gap-3 p-4") %>">
      <% events.each do |event| %>
        <li class="grid grid-cols-[8px_1fr] gap-3">
          <span class="mt-2 size-2 rounded-full <%= alert_event_accent(event) %>" aria-hidden="true"></span>
          <div class="min-w-0">
            <p class="text-sm text-fg-default"><%= event.message %></p>
            <p class="font-mono text-xs text-fg-subtle"><%= alert_event_when(event) %></p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="<%= card_classes("p-4 text-sm text-fg-subtle") %>">
      <%= t("alerts.index.sin_disparos") %>
    </p>
  <% end %>
</section>

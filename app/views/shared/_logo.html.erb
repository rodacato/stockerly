<%# The Stockerly wordmark, inline so it ships with the HTML that already had
    to load (ADR-028): the candle takes the brand token, the word takes the text
    colour, and one source draws every contrast the two files used to.
    Locals: height_class (default "h-9"), alt_text (default "Stockerly"). %>
<svg viewBox="0 0 174 40" role="img"
     aria-label="<%= local_assigns.fetch(:alt_text, "Stockerly") %>"
     class="<%= local_assigns.fetch(:height_class, "h-9") %> w-auto">
  <g transform="scale(.625)" color="var(--color-primary)"><%= raw BrandAssets.svg_body("glyph") %></g>
  <%= raw BrandAssets.svg_body("lettering") %>
</svg>

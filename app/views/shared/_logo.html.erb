<%# Canonical Stockerly wordmark for themed chrome: it follows light/dark.
    Surfaces that need a fixed variant call `brand_logo(:light | :dark)`
    directly — this partial owns the render, the helper owns the filenames.
    Locals: height_class (default "h-9"), alt_text (default "Stockerly"). %>
<% height_class = local_assigns.fetch(:height_class, "h-9") %>
<% alt_text     = local_assigns.fetch(:alt_text, "Stockerly") %>
<%= image_tag brand_logo(:light), alt: alt_text, class: "#{height_class} w-auto dark:hidden" %>
<%= image_tag brand_logo(:dark),  alt: alt_text, class: "#{height_class} w-auto hidden dark:block" %>

<%# Shared body between /welcome and /help. Context note + 3 starting guide cards + support footer. %>

<%# Context card %>
<div class="rounded-2xl bg-primary-muted p-5 flex gap-4">
  <div class="size-8 shrink-0 flex items-center justify-center text-primary mt-0.5">
    <%= render "shared/logo_mark" %>
  </div>
  <div class="min-w-0">
    <h2 class="text-lg font-semibold text-fg-default mb-1.5"><%= t(".desarrollo_titulo") %></h2>
    <p class="text-sm text-fg-default leading-relaxed"><%= t(".desarrollo_cuerpo") %></p>
  </div>
</div>

<%# Starting guide — 3 cards %>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
  <% [
    { icon: "add_chart",            title: t(".guia_movimiento_titulo"), body: t(".guia_movimiento_cuerpo"), href: portfolio_path },
    { icon: "visibility",           title: t(".guia_watchlist_titulo"),  body: t(".guia_watchlist_cuerpo"),  href: assets_path },
    { icon: "notifications_active", title: t(".guia_regla_titulo"),      body: t(".guia_regla_cuerpo"),      href: alerts_path }
  ].each do |card| %>
    <%= link_to card[:href], class: "group flex flex-col p-5 rounded-2xl bg-bg-surface border border-border-default hover:border-primary hover:bg-bg-muted transition-colors no-underline text-fg-default" do %>
      <div class="size-8 rounded-lg bg-bg-muted text-fg-default inline-flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-lg"><%= card[:icon] %></span>
      </div>
      <h3 class="text-base font-semibold text-fg-default mb-1.5"><%= card[:title] %></h3>
      <p class="text-sm text-fg-subtle leading-relaxed flex-1"><%= card[:body] %></p>
      <span class="text-fg-subtle group-hover:text-primary transition-colors mt-3 inline-flex items-center text-sm">
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </span>
    <% end %>
  <% end %>
</div>

<%# Support footer %>
<div class="text-sm text-fg-subtle space-y-1.5">
  <p><%= t(".bug_pregunta") %> <%= link_to t(".bug_enlace"), Stockerly::ISSUES_URL, target: "_blank", rel: "noopener noreferrer", class: "text-primary border-b border-primary transition-colors" %></p>
  <p><%= t(".contacto_pregunta") %> <%= mail_to Stockerly::SUPPORT_EMAIL, nil, class: "text-primary border-b border-primary transition-colors" %>.</p>
</div>

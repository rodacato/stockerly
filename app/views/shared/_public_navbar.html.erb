<header class="sticky top-0 z-50 w-full border-b border-border-default bg-white/80 dark:bg-bg-canvas/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-18 items-center justify-between">
      <%# Logo %>
      <%= link_to root_path, class: "flex items-center gap-2" do %>
        <%= render "shared/logo" %>
      <% end %>

      <%# Auth Buttons %>
      <div class="flex items-center gap-4">
        <% if logged_in? %>
          <%= link_to current_user.full_name, dashboard_path, class: "hidden sm:flex items-center gap-1.5 text-sm font-medium text-fg-subtle hover:text-primary transition-colors" %>
          <%= button_to "Logout", logout_path, method: :delete, class: "px-4 py-2 text-sm font-semibold text-fg-default hover:bg-bg-muted rounded-lg transition-all" %>
        <% else %>
          <%= link_to "Login", login_path, class: "bg-primary text-white px-5 py-2.5 text-sm font-bold rounded-lg hover:bg-primary-hover shadow-sm transition-all" %>
        <% end %>

        <%# Mobile Menu Toggle %>
        <button class="md:hidden p-2 text-fg-subtle hover:text-primary transition-colors" data-controller="mobile-menu" data-action="click->mobile-menu#toggle">
          <span class="material-symbols-outlined text-2xl">menu</span>
        </button>
      </div>
    </div>

    <%# Mobile Nav %>
    <nav class="hidden md:hidden pb-4 space-y-2" data-mobile-menu-target="menu">
      <% if logged_in? %>
        <%= link_to "Panorama", dashboard_path, class: "block px-3 py-2 text-sm font-medium text-fg-subtle hover:text-primary hover:bg-bg-muted rounded-lg transition-colors" %>
        <%= button_to "Logout", logout_path, method: :delete, class: "block w-full text-left px-3 py-2 text-sm font-medium text-fg-subtle hover:text-primary hover:bg-bg-muted rounded-lg transition-colors" %>
      <% else %>
        <%= link_to "Login", login_path, class: "block px-3 py-2 text-sm font-medium text-fg-subtle hover:text-primary hover:bg-bg-muted rounded-lg transition-colors sm:hidden" %>
      <% end %>
    </nav>
  </div>
</header>

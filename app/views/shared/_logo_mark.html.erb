<%# The symbol alone, inline so it inherits currentColor — an image_tag cannot
    be tinted. Canonical geometry lives in design/brand/glyph.svg.
    Locals: size_class (default "w-7 h-7"). %>
<svg viewBox="0 0 64 64" class="<%= local_assigns.fetch(:size_class, "w-7 h-7") %>" aria-hidden="true">
  <%= brand_svg_body("glyph") %>
</svg>

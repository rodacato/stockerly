<%# Locals: name, label, type; value, placeholder, autocomplete, autofocus optional.
    One shape for every auth input, so the four screens cannot drift apart.
    A password input also gets the reveal toggle, so no screen has to opt in. %>
<% password = type.to_s == "password" %>
<label class="flex flex-col gap-1.5">
  <span class="text-sm text-fg-subtle"><%= label %></span>
  <%= tag.div class: "relative", data: { controller: ("password-visibility" if password) } do %>
    <%= tag.input type: type,
                  name: name,
                  id: name,
                  value: local_assigns[:value],
                  placeholder: local_assigns[:placeholder],
                  autocomplete: local_assigns[:autocomplete],
                  autofocus: local_assigns[:autofocus],
                  required: true,
                  data: { password_visibility_target: ("input" if password) },
                  class: field_classes(:lg, class_names("w-full focus:border-primary", "pr-12": password)) %>
    <% if password %>
      <button type="button"
              aria-pressed="false"
              aria-label="<%= t("auth.mostrar_contrasena") %>"
              data-password-visibility-target="button"
              data-action="password-visibility#toggle"
              class="absolute inset-y-0 right-0 flex w-12 items-center justify-center rounded-r-xl text-fg-subtle hover:text-fg-default aria-pressed:text-primary-fg focus:outline-none focus-visible:ring-2 focus-visible:ring-focus">
        <%= icon_svg "visibility", class: "text-xl", "aria-hidden": "true" %>
      </button>
    <% end %>
  <% end %>
</label>

<% content_for :page_title, t(".titulo") %>
<% content_for :header_bar do %>
  <%= render "components/header_bar", title: t(".titulo"), back_path: settings_path %>
<% end %>

<div class="mx-auto flex w-full max-w-xl flex-col gap-5">
  <p class="text-sm text-fg-subtle"><%= t(".descripcion") %></p>

  <section class="<%= card_classes("flex flex-col gap-4 p-5") %>">
    <%= form_with url: change_password_path, method: :patch, scope: :password_change, class: "flex flex-col gap-4" do |f| %>
      <% [ [ :current_password, "current-password" ],
           [ :password, "new-password" ],
           [ :password_confirmation, "new-password" ] ].each do |field, autocomplete| %>
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-semibold uppercase tracking-wide text-fg-subtle"><%= t(".#{field}") %></span>
          <%= f.password_field field, required: true, autocomplete: autocomplete,
                               class: field_classes(:md, "w-full") %>
        </label>
      <% end %>

      <%= f.submit t(".guardar"), class: button_classes(:primary, :md, "cursor-pointer") %>
    <% end %>
  </section>
</div>

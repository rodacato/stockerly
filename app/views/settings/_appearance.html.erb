<%# Locals: user. Two segmented pills that now commit alike (D58): theme
    applies from localStorage, currency PATCHes on select. Neither waits for a
    button — the currency form used to, and a choice you can make and forget to
    submit leaves you reading MXN while believing you switched.
    The theme lives in localStorage, so the server cannot know which of the
    three is on; its controller selects one as soon as it connects. %>
<section class="flex flex-col gap-3">
  <h2 class="font-display text-lg font-bold tracking-tight text-fg-default">
    <%= t("settings.show.tema") %>
  </h2>

  <div class="<%= card_classes("flex flex-col gap-4 p-4") %>">
    <div data-controller="theme" data-theme-storage-key-value="stockerly.theme">
      <%= render "components/segmented",
                 label: t("settings.show.tema_control"),
                 options: { "light" => t("settings.show.tema_claro"),
                            "dark" => t("settings.show.tema_oscuro"),
                            "system" => t("settings.show.tema_sistema") }.map { |mode, label|
                   [ label, { data: { theme_target: "option", theme_mode: mode,
                                      action: "click->theme#select" } }, false ]
                 } %>
    </div>

    <div class="flex flex-col gap-2">
      <p class="text-xs text-fg-subtle"><%= t("settings.show.moneda") %></p>
      <%# MXN first: the product is MXN-first and the local currency reads
          first. SUPPORTED_CURRENCIES is ordered for validation, not display. %>
      <div data-controller="choice" data-choice-url-value="<%= update_currency_path %>"
           data-choice-param-value="profile[preferred_currency]">
        <%= render "components/segmented",
                   label: t("settings.show.moneda"),
                   options: [ "MXN", "USD" ].map { |code|
                     [ code, { data: { choice_target: "option", choice_value: code,
                                       action: "click->choice#select" } },
                       user.preferred_currency == code ]
                   } %>
      </div>
    </div>

    <%# Fixed for the whole instance: every date on every screen is rendered in
        this zone, so naming it is what makes a timestamp readable. %>
    <div class="flex items-baseline justify-between gap-3">
      <p class="text-xs text-fg-subtle"><%= t("settings.show.zona_horaria") %></p>
      <span class="text-right font-mono text-sm text-fg-default">
        <%= t("settings.show.zona_horaria_valor") %>
      </span>
    </div>
  </div>
</section>

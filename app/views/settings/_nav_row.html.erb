<%# Locals: title, description, path, icon; badge optional. %>
<%= link_to path, class: "flex items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-3.5 transition-colors hover:border-border-strong" do %>
  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-bg-muted">
    <span class="material-symbols-outlined text-xl text-fg-subtle" aria-hidden="true"><%= icon %></span>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-semibold text-fg-default"><%= title %></span>
    <span class="block text-xs text-fg-subtle"><%= description %></span>
  </span>
  <% if local_assigns[:badge] %>
    <span class="shrink-0 font-mono text-xs text-fg-subtle"><%= badge %></span>
  <% end %>
  <span class="material-symbols-outlined shrink-0 text-xl text-fg-subtle" aria-hidden="true">chevron_right</span>
<% end %>

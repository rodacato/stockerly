<% content_for :page_title, t(".titulo") %>

<div class="flex flex-col gap-8">
  <section class="<%= card_classes("flex items-center gap-4 p-5") %>">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary-muted font-display text-lg font-bold text-primary">
      <%= @user.full_name.to_s.strip.first&.upcase || "?" %>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block font-display text-base font-semibold text-fg-default"><%= @user.full_name %></span>
      <span class="block truncate text-sm text-fg-subtle"><%= @user.email %></span>
    </span>
    <span class="shrink-0 rounded-full bg-bg-muted px-3 py-1 text-xs text-fg-subtle"><%= t(".unica_cuenta") %></span>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".cuenta") %></h2>
    <%= render "settings/nav_row", icon: "person", path: edit_account_settings_path,
               title: t(".nombre_correo"), description: t(".nombre_correo_desc") %>
    <%= render "settings/nav_row", icon: "lock", path: edit_password_settings_path,
               title: t(".contrasena"), description: t(".contrasena_desc") %>
    <%# D52's Seguridad row. The description reads the account's real state, so
        the row says whether the factor is on rather than only offering it. %>
    <%= render "settings/nav_row", icon: "verified_user",
               path: @user.otp_enrolled? ? recovery_codes_path : totp_enrollment_path,
               title: t(".dos_pasos"),
               description: @user.otp_enrolled? ? t(".dos_pasos_activa", count: @user.unused_recovery_codes_count) : t(".dos_pasos_desc") %>
  </section>

  <%= render "settings/appearance", user: @user %>

  <section class="flex flex-col gap-3">
    <div>
      <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".avisos_titulo") %></h2>
      <p class="mt-1 text-sm text-fg-subtle"><%= t(".avisos_campana") %></p>
    </div>
    <%= render "settings/notification_switches", preferences: @preferences %>
  </section>

  <section class="flex flex-col gap-3">
    <div>
      <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".instancia_titulo") %></h2>
      <p class="mt-1 text-sm text-fg-subtle"><%= t(".instancia_cuerpo") %></p>
    </div>
    <%= render "settings/nav_row", icon: "power", path: admin_integrations_path,
               title: t(".integraciones"), description: t(".integraciones_desc"), badge: @integrations_count %>
    <%= render "settings/nav_row", icon: "receipt_long", path: admin_logs_path,
               title: t(".registros"), description: t(".registros_desc") %>
    <%= render "settings/nav_row", icon: "monitor_heart", path: admin_settings_path,
               title: t(".estado"), description: t(".estado_desc") %>
    <%# No failed-jobs badge: it lives in another database, and counting it on
        every hub load put a cross-database query in the request path for a
        number Mission Control shows accurately the moment you open it. %>
    <%= render "settings/nav_row", icon: "checklist", path: "/admin/jobs",
               title: t(".trabajos"), description: t(".trabajos_desc") %>
    <%# ADR-020: only when the switch is on — the row is the developer surface,
        not a permanent part of the hub. %>
    <% if @developer_mode %>
      <%= render "settings/nav_row", icon: "bug_report", path: admin_errors_path,
                 title: t(".errores"), description: t(".errores_desc") %>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".datos_titulo") %></h2>
    <%# The hub's door to the importer. Assets already has one, but the data a
        person wants to load is what this section is about. %>
    <%= render "settings/nav_row", icon: "upload_file", path: new_trade_import_path,
               title: t(".importar"), description: t(".importar_desc") %>
    <div class="<%= card_classes("p-5") %>">
      <p class="text-sm text-fg-subtle"><%= t(".datos_cuerpo") %></p>

      <%# Two doors, because they undo different amounts. Clearing the movements
          is what a re-import needs; deleting the account is what leaving needs. %>
      <div class="mt-5 border-t border-border-default pt-5">
        <p class="text-sm font-semibold text-fg-default"><%= t(".borrar_trading") %></p>
        <p class="mt-1 text-xs text-fg-subtle"><%= t(".borrar_trading_desc") %></p>
        <p class="mt-2 font-mono text-xs text-fg-subtle">
          <%= t(".borrar_trading_conteo",
                operaciones: @trading_counts[:trades].to_i,
                posiciones: @trading_counts[:positions].to_i,
                snapshots: @trading_counts[:snapshots].to_i) %>
        </p>
        <%= button_to t(".borrar_trading_cta"), trading_data_settings_path, method: :delete,
                      disabled: @trading_counts.values.sum.zero?,
                      form: { data: { turbo_confirm: t(".borrar_trading_confirmar",
                                                       operaciones: @trading_counts[:trades].to_i) } },
                      class: "mt-3 rounded-xl border border-border-default px-4 py-2 text-sm font-semibold text-fg-default transition-colors hover:border-border-strong disabled:cursor-not-allowed disabled:opacity-40" %>
      </div>

      <div class="mt-5 border-t border-border-default pt-5">
        <p class="text-sm font-semibold text-negative"><%= t(".borrar_cuenta") %></p>
        <p class="mt-1 text-xs text-fg-subtle"><%= t(".borrar_cuenta_desc") %></p>
        <%= button_to t(".borrar_cuenta_cta"), account_settings_path, method: :delete,
                      form: { data: { turbo_confirm: t(".borrar_cuenta_confirmar") } },
                      class: "mt-3 rounded-xl border border-negative px-4 py-2 text-sm font-semibold text-negative transition-colors hover:bg-negative-bg" %>
      </div>
    </div>
  </section>

  <%= button_to logout_path, method: :delete,
                class: "flex w-full items-center justify-center gap-2 rounded-2xl border border-border-default bg-bg-surface px-4 py-3.5 text-sm font-semibold text-fg-default transition-colors hover:border-border-strong" do %>
    <span class="material-symbols-outlined text-lg" aria-hidden="true">logout</span>
    <%= t(".cerrar_sesion") %>
  <% end %>
</div>

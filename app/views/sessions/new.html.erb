<% content_for(:title, "#{t("auth.login.titulo")} | Stockerly") %>

<div class="flex flex-col gap-6">
  <%= render "shared/auth_header", title: t("auth.login.titulo"), subtitle: t("auth.login.subtitulo") %>

  <%# The "sign in to continue" nudge is a redirect artifact, not an error — it
      already shows as a flash, and repeating it here reads as a failed attempt. %>
  <% nudge = flash[:alert]&.start_with?("Inicia sesión para continuar", "Please sign in") %>
  <%= render "shared/flash_alert", message: (flash[:alert] unless nudge) %>

  <%= form_with url: login_path, method: :post, class: "flex flex-col gap-4" do %>
    <%= render "shared/auth_field", name: "email", type: "email", label: t("auth.correo"),
               value: params[:email], placeholder: t("auth.correo_placeholder"),
               autocomplete: "email", autofocus: true %>
    <%= render "shared/auth_field", name: "password", type: "password",
               label: t("auth.contrasena"), autocomplete: "current-password" %>

    <button type="submit"
            class="<%= button_classes(:primary, :lg, "mt-2 w-full") %>">
      <%= t("auth.login.submit") %>
    </button>
  <% end %>

  <p class="text-center text-sm">
    <%= link_to "#{t("auth.login.olvidaste")} #{t("auth.login.recuperala")}", forgot_password_path,
                class: "font-medium text-primary hover:underline" %>
  </p>

  <p class="text-center text-xs text-fg-subtle">
    <%# Rails treats an _html key as safe, so the links interpolate without
        html_safe on our side. %>
    <%= t("auth.login.terminos_html",
          terms: link_to(t("auth.terminos"), terms_path, class: "underline"),
          privacy: link_to(t("auth.privacidad"), privacy_path, class: "underline")) %>
  </p>
</div>

<% content_for(:title, "#{t('.titulo')} | Stockerly") %>

<div class="flex flex-col gap-6">
  <%= render "shared/auth_header", title: t(".titulo"), subtitle: t(".subtitulo") %>

  <%= render "shared/flash_alert", message: take_flash(:alert) %>

  <%= form_with url: recovery_code_path, method: :post, class: "flex flex-col gap-4" do %>
    <label class="flex flex-col gap-1.5">
      <span class="text-sm text-fg-subtle"><%= t(".codigo") %></span>
      <%= tag.input type: "text", name: "code", autocomplete: "off", autofocus: true, required: true,
                    placeholder: t(".placeholder"), spellcheck: "false",
                    class: field_classes(:lg, "text-center font-mono text-lg! tracking-widest") %>
    </label>

    <button type="submit"
            class="<%= button_classes(:primary, :lg, "mt-2 w-full") %>">
      <%= t(".entrar") %>
    </button>
  <% end %>

  <div class="flex flex-col gap-2 text-center text-sm">
    <%= link_to t(".volver_verificacion"), two_factor_path, class: "font-medium text-primary hover:underline" %>
    <%= link_to t("auth.volver"), login_path, class: "text-fg-subtle hover:underline" %>
  </div>
</div>

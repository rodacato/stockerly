<%# Replaces the mobile TopBar — the artboards draw one bar or the other, never
    both — so this carries the h1 that `layouts/app` otherwise emits sr-only. %>
<header class="sticky top-0 z-40 flex items-center gap-3 border-b border-border-default bg-bg-surface px-5 py-3 lg:hidden">
  <%= link_to back_path, class: "-ml-2 flex size-11 shrink-0 items-center justify-center rounded-lg text-fg-default transition-colors hover:bg-bg-muted",
        aria: { label: t("nav.regresar") } do %>
    <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_back</span>
  <% end %>

  <h1 class="min-w-0 flex-1 truncate font-display text-lg font-bold tracking-tight text-fg-default"><%= title %></h1>
</header>

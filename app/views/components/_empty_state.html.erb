<%# Parameters: icon, title; description (optional), cta_text (optional),
    cta_path (optional), cta_method (optional — :post renders a button, anything
    else a link), size (optional — :block fills a screen, :inline fits a section
    inside a column), tone (optional — :wash is the soft brand fill of D165) %>
<%
  description = local_assigns[:description]
  wash = local_assigns[:tone] == :wash
  cta =
    if local_assigns[:cta_text] && local_assigns[:cta_path]
      cta_class = button_classes(:primary, :sm, "inline-flex items-center gap-2")
      if local_assigns[:cta_method] == :post
        button_to(cta_text, cta_path, class: cta_class)
      else
        link_to(cta_text, cta_path, class: cta_class)
      end
    end
%>
<% if local_assigns.fetch(:size, :block) == :inline %>
  <div class="flex items-center gap-3 rounded-2xl border border-dashed border-border-default px-4 py-5">
    <%= icon_svg icon, class: "shrink-0 text-2xl text-fg-subtle", "aria-hidden": "true" %>
    <div class="min-w-0 flex-1">
      <h3 class="text-sm text-fg-default"><%= title %></h3>
      <% if description.present? %>
        <p class="mt-0.5 text-xs text-fg-subtle"><%= description %></p>
      <% end %>
      <%= cta %>
    </div>
  </div>
<% else %>
  <div class="<%= class_names("flex flex-col items-center justify-center rounded-2xl px-4 py-16 text-center",
                              "bg-primary-muted": wash, "border border-dashed border-border-default": !wash) %>">
    <%= icon_svg icon, class: "mb-4 text-6xl #{wash ? 'text-primary-fg' : 'text-border-strong'}", "aria-hidden": "true" %>
    <h3 class="mb-2 font-display text-lg font-semibold text-fg-default"><%= title %></h3>
    <% if description.present? %>
      <p class="<%= class_names("mb-6 max-w-[320px] text-sm", "text-fg-default": wash, "text-fg-subtle": !wash) %>"><%= description %></p>
    <% end %>
    <%= cta %>
  </div>
<% end %>

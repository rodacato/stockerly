<%# Locals: position, declared_currency; optional maturity_days, context
    No state chip and no confluence dots, and that is now a decision rather
    than a gap (#586): the semáforo was retired when combining its lights
    measured no better than the strongest one alone, and a per-row chip was
    rejected because the edge behind it is measured inside a basket that
    returns twice the index before any signal. The state lives on the detail,
    where the reading that produced it is beside it.
    D69: the row owns two emphasis slots and the context says which number
    fills the first one. A fixed-income row about to mature reports that
    instead of a day move it does not have.
    ADR-021: `change` is the computed day change and may be nil.
    D141: the radar sets a converted market value beside a watchlist row's
    unconverted quote, so its list declares no currency and every value here
    names its own. `declared_currency` still governs every other context. %>
<% maturity_days = local_assigns[:maturity_days] %>
<% context = local_assigns.fetch(:context, :cartera) %>
<% asset = position.asset %>
<% change = local_assigns[:change] %>
<% amount, amount_currency = position_amount(position, declared_currency) %>
<% value_text = context == :radar ? format_currency_mx(amount, currency: amount_currency, precision: 0) : money_cell(amount, currency: amount_currency, declared: declared_currency, precision: 0) %>
<% value_slot = { text: value_text, color: "text-fg-default" } %>
<% move_slot = maturity_days ? { text: t("comun.vencimiento", count: maturity_days), color: "text-warning-fg" } : day_change_slot(change) %>
<% primary, secondary = context == :radar ? [ move_slot, value_slot.merge(color: "text-fg-subtle") ] : [ value_slot, move_slot ] %>
<%= link_to market_asset_path(asset.symbol),
            class: "flex items-center gap-4 rounded-2xl border border-border-default bg-bg-surface px-4 py-3.5 transition-colors hover:border-border-strong" do %>
  <div class="min-w-0 flex-1">
    <p class="font-mono text-sm font-bold text-fg-default"><%= asset.symbol %></p>
    <%# Wraps rather than truncates: the subtitle carries a state phrase, not a
        date, and a clipped explanation is worse than a taller row (D46). %>
    <p class="text-xs text-fg-subtle">
      <%= asset.name %> · <%= t("assets.index.titulos", count: format_shares(position.shares)) %>
    </p>
  </div>

  <div class="w-20 shrink-0">
    <%= render "components/sparkline", heights: sparkline_heights(local_assigns[:closes]) %>
  </div>

  <div class="shrink-0 text-right">
    <p class="font-mono text-sm font-bold <%= primary[:color] %>"><%= primary[:text] %></p>
    <p class="font-mono text-xs <%= secondary[:color] %>"><%= secondary[:text] %></p>
  </div>
<% end %>

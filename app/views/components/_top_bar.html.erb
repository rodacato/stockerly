<header class="sticky top-0 z-40 flex items-center justify-between gap-4 border-b border-border-default bg-bg-surface px-5 py-4 lg:hidden">
  <%= link_to dashboard_path, "aria-label": t("nav.ir_al_panorama"), class: "flex items-center" do %>
    <%= render "shared/logo", height_class: "h-7" %>
  <% end %>

  <%= link_to notifications_path, class: "relative -mr-2 flex size-11 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-primary" do %>
    <span class="material-symbols-outlined text-xl" aria-hidden="true">notifications</span>
    <%= render "components/notification_badge", unread_count: navbar_unread_count %>
  <% end %>
</header>

<%# Usage: render "components/donut_chart", segments: [{label: "Tecnología", pct: 45, color: "var(--color-chart-1)"}, ...] %>
<%# Segment colors must come from the --color-chart-* token set, never raw hex. %>
<% segments ||= [] %>

<%
  gradient_stops = []
  cumulative = 0
  segments.each do |seg|
    gradient_stops << "#{seg[:color]} #{cumulative}% #{cumulative + seg[:pct]}%"
    cumulative += seg[:pct]
  end
%>

<div class="flex flex-col items-center">
  <%# The hole takes the card's own surface, so it reads as a hole in both themes. %>
  <div class="relative size-48">
    <div class="size-48 rounded-full border-8 border-border-default"
         style="background: conic-gradient(<%= gradient_stops.join(', ') %>);">
    </div>
    <div class="absolute inset-0 m-auto size-32 rounded-full bg-bg-surface"></div>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-3 w-full">
    <% segments.each do |seg| %>
      <div class="flex items-center gap-2">
        <span class="size-3 rounded-full shrink-0" style="background-color: <%= seg[:color] %>;"></span>
        <span class="text-xs text-fg-subtle"><%= seg[:label] %></span>
        <span class="text-xs font-bold text-fg-default ml-auto"><%= seg[:pct] %>%</span>
      </div>
    <% end %>
  </div>
</div>

<%# The price block, broadcast on its own. MarketData::Handlers::BroadcastPriceUpdate
    replaces this element by id when a sync moves the number, so everything it
    reads must come from the locals — a broadcast renders outside a request and
    has no current_user.
    Locals: asset, user, change (the computed day change, ADR-021; may be nil). %>
<% change = local_assigns[:change] %>
<% approximate = approximate_in_preferred(asset, user) %>

<div id="asset_price_<%= asset.id %>">
  <% if asset.current_price %>
    <p class="flex flex-wrap items-baseline gap-x-2 break-words font-display text-3xl font-bold tracking-tight text-fg-default sm:text-4xl">
      <%= number_with_precision(asset.current_price, precision: asset.asset_type_fixed_income? ? 4 : 2, delimiter: ",") %>
      <span class="font-mono text-lg font-medium text-fg-subtle"><%= asset.currency %></span>
    </p>

    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
      <% if approximate %>
        <span class="text-fg-subtle">≈ <%= approximate %></span>
      <% end %>
      <% if change %>
        <span class="<%= gain_color(change) %>"><%= signed_percent(change) %> · <%= t(".periodo") %></span>
      <% else %>
        <span class="text-fg-subtle"><%= t("market.header.sin_cambio_dia") %></span>
      <% end %>
      <% if asset.price_updated_at %>
        <span class="text-fg-subtle"><%= t(".actualizado", date: absolute_stamp(asset.price_updated_at)) %></span>
      <% end %>
    </div>

    <%# The artboard has no provenance line. Keeping it: where a number came
        from is not decoration on a screen whose job is being checkable. %>
    <p class="mt-2 text-[11px] text-fg-subtle"><%= asset_data_source_caption(asset) %></p>
  <% else %>
    <p class="text-sm text-fg-subtle"><%= t("market.header.sin_precio") %></p>
  <% end %>
  <% if !asset.last_sync_ok? %>
    <p class="mt-2 text-xs text-warning-fg"><%= t(".error_proveedor") %></p>
  <% elsif asset.current_price && asset.price_stale? %>
    <p class="mt-2 text-xs text-warning-fg"><%= t(".desactualizado", minutes: Asset::STALE_AFTER.in_minutes.to_i) %></p>
  <% end %>
</div>

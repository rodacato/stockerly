<% content_for :page_title, t(".titulo") %>
<% content_for :own_heading, true %>

<div class="mx-auto flex max-w-3xl flex-col gap-6">
  <%# Both artboards head this screen with its own name — unlike Panorama and
      Activos, whose first block introduces itself. It is hidden at lg, where the
      desktop bar already carries the title. %>
  <div class="flex flex-col gap-0.5">
    <h1 class="font-display text-3xl font-bold tracking-tight text-fg-default lg:hidden"><%= t(".titulo") %></h1>
    <p class="text-fg-subtle"><%= @has_world_data ? t(".descripcion") : t(".sin_datos") %></p>
  </div>

  <%# Olas and titulares read Alpaca (D31); the Calendario needs no credential.
      Until Alpaca is connected the screen says which block needs what, rather
      than showing empty cards that look broken. Reportes was dropped from the
      product (D47), not left waiting. %>
  <% unless @has_world_data %>
    <%# The artboard sets the body copy in primary over primary-muted, which
        measures 3.68:1 in light and 4.22:1 in dark — under the AA floor for
        body text. The accent stays on the heading and the link, where large
        text and UI components only owe 3:1 (D41). %>
    <section class="flex flex-col items-start gap-2 rounded-2xl bg-primary-muted p-5">
      <h2 class="font-display text-lg font-bold tracking-tight text-primary"><%= t(".conecta_titulo") %></h2>
      <p class="text-fg-default"><%= t(".conecta_cuerpo") %></p>
      <%= link_to admin_integrations_path, class: "font-semibold text-primary hover:underline" do %>
        <%= t(".conecta_cta") %> <span aria-hidden="true">→</span>
      <% end %>
    </section>
  <% end %>

  <%# Olas — the baskets ranked over the window since your last visit (D31).
      Shown only when the warm job has something: an empty list here means the
      job has not run or Alpaca is not connected, and the notice above already
      says which. %>
  <% if @waves.any? %>
    <section class="flex flex-col gap-3">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".olas_titulo") %></h2>
        <p class="font-mono text-xs text-fg-subtle"><%= t(".olas_desde", since: l(@waves_since, format: :short)) %></p>
      </div>

      <ul class="flex flex-col gap-3">
        <% @waves.first(5).each do |wave| %>
          <li class="flex items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-3">
            <div class="min-w-0 flex-1">
              <p class="font-display text-sm font-bold text-fg-default"><%= wave.symbol %></p>
              <p class="text-xs text-fg-subtle"><%= wave.name %></p>
              <%# Neutral in both states by design: colouring "sin exposición"
                  would read as act here, which ADR-0001 forbids (D31). %>
              <span class="mt-1 inline-flex rounded-full bg-bg-muted px-2 py-0.5 font-mono text-[10px] text-fg-subtle">
                <%= wave_exposure(wave, @owned_symbols) %>
              </span>
            </div>

            <%= render "components/sparkline", direction: nil,
                  heights: sparkline_heights(wave.closes) %>

            <div class="shrink-0 text-right">
              <p class="font-mono text-sm font-bold <%= wave.change_percent.negative? ? "text-negative" : "text-positive" %>">
                <%= number_to_percentage(wave.change_percent, precision: 1, format: "%n%") %>
              </p>
              <% if wave.vs_baseline %>
                <p class="font-mono text-xs text-fg-subtle">
                  <%= t(".olas_vs", baseline: MarketData::Discover::BasketCatalogue.baseline,
                        value: number_with_precision(wave.vs_baseline, precision: 1)) %>
                </p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <%# The artboard links to "las 17 canastas"; there is no screen behind
          that yet, so the count is stated rather than linked. %>
      <p class="text-xs text-fg-subtle"><%= t(".olas_total", count: @waves.size) %></p>
    </section>
  <% end %>

  <%# Titulares — five and never a feed (D31). Filtered to the baskets, so it
      reads as why a wave moved rather than as a news river. %>
  <% if @headlines.any? %>
    <section class="flex flex-col gap-3">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".titulares_titulo") %></h2>
        <p class="font-mono text-xs text-fg-subtle"><%= t(".titulares_meta") %></p>
      </div>

      <ul class="flex flex-col divide-y divide-border-default rounded-2xl border border-border-default bg-bg-surface px-4">
        <% @headlines.each do |headline| %>
          <li class="flex flex-col gap-1 py-3">
            <% if headline[:url].present? %>
              <%= link_to headline[:title], headline[:url], target: "_blank", rel: "noopener",
                    class: "font-semibold text-fg-default hover:text-primary" %>
            <% else %>
              <p class="font-semibold text-fg-default"><%= headline[:title] %></p>
            <% end %>
            <p class="font-mono text-xs text-fg-subtle">
              <%= [ headline[:related_ticker], headline[:source],
                    (t(".titulares_hace", time: time_ago_in_words(headline[:published_at])) if headline[:published_at]) ].compact.join(" · ") %>
            </p>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="flex flex-col gap-3">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".calendario_titulo") %></h2>
      <p class="font-mono text-xs text-fg-subtle"><%= t(".calendario_meta", horizon: @calendar_horizon) %></p>
    </div>

    <% if @calendar_exhausted %>
      <%# D33: a calendar that runs out says so. Rendering nothing here would
          leave the one credential-free block looking as broken as the others. %>
      <div class="flex flex-col items-start gap-2 rounded-2xl border border-border-default bg-bg-surface p-5">
        <p class="text-sm text-fg-subtle"><%= t(".calendario_agotado", horizon: @calendar_horizon) %></p>
        <div class="flex gap-4">
          <% @calendar_sources.each do |name, url| %>
            <%= link_to name.to_s.titleize, url, class: "text-sm font-semibold text-primary hover:underline",
                  target: "_blank", rel: "noopener" %>
          <% end %>
        </div>
      </div>
    <% else %>
      <ul class="flex flex-col gap-1 rounded-2xl border border-border-default bg-bg-surface px-5 py-4">
        <% @calendar.each do |event| %>
          <li class="flex items-baseline gap-4 py-1.5">
            <time datetime="<%= event.date.iso8601 %>" class="shrink-0 font-mono text-sm text-fg-subtle">
              <%= l(event.date, format: :calendar) %>
            </time>
            <p class="text-fg-default">
              <%= event.source %> — <%= event.title %>
              <% if event.tentative %>
                <span class="font-mono text-xs text-fg-subtle"><%= t(".tentativa") %></span>
              <% end %>
            </p>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>

<% content_for :page_title, t("assets.tracked.titulo") %>

<div data-controller="reveal" class="flex flex-col gap-5 lg:flex-row lg:items-start">
  <div class="flex min-w-0 flex-1 flex-col gap-4">
    <div class="flex items-center justify-between gap-3">
      <p class="text-sm text-fg-subtle"><%= t("assets.tracked.conteo", count: @assets.size) %></p>
      <button type="button" data-action="reveal#toggle"
              class="<%= button_classes(:primary, :sm, "inline-flex shrink-0 items-center gap-1.5") %>">
        <span class="material-symbols-outlined text-base" aria-hidden="true">add</span>
        <%= t("assets.tracked.agregar") %>
      </button>
    </div>

    <%= render "assets/track_form" %>

    <%# Filters what you already track — a different control from the typeahead
        in the form above, which searches the catalogue to add. %>
    <%= form_with url: tracked_assets_path, method: :get, data: { turbo_action: "advance" },
          class: "relative" do %>
      <label for="tracked_query" class="sr-only"><%= t("assets.tracked.filtrar", count: @total) %></label>
      <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-base text-fg-subtle" aria-hidden="true">search</span>
      <input type="search" id="tracked_query" name="q" value="<%= @query %>" autocomplete="off"
             placeholder="<%= t("assets.tracked.filtrar", count: @total) %>"
             class="w-full rounded-lg border border-border-default bg-bg-canvas py-2.5 pl-10 pr-3 text-sm text-fg-default placeholder:text-fg-subtle focus:outline-none focus:ring-2 focus:ring-focus" />
    <% end %>

    <% if @assets.any? %>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @assets.each do |asset| %>
          <%= render "assets/tracked_row",
                     asset: asset,
                     tier: tracked_tier(asset, held_ids: @held_ids, followed_ids: @followed_ids) %>
        <% end %>
      </div>
    <% elsif @query %>
      <%= render "components/empty_state",
                 icon: "search_off",
                 title: t("assets.tracked.sin_resultados_titulo"),
                 description: t("assets.tracked.sin_resultados", query: @query) %>
    <% else %>
      <%= render "components/empty_state",
                 icon: "radar",
                 title: t("assets.tracked.titulo"),
                 description: t("assets.tracked.vacio") %>
    <% end %>
  </div>

  <aside class="<%= card_classes("flex w-full shrink-0 flex-col gap-3 p-5 lg:w-80") %>">
    <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle"><%= t("assets.tracked.presupuesto_titulo") %></p>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <p class="font-display text-3xl font-bold tracking-tight text-fg-default">
        <%= @budget.unlimited? ? t("assets.tracked.presupuesto_sin_limite") : t("assets.tracked.presupuesto_llamadas", count: @budget.remaining) %>
      </p>
      <span class="rounded-full bg-warning-bg px-2.5 py-0.5 text-xs font-medium text-warning-fg">
        <%= t("assets.tracked.conteo", count: @total) %>
      </span>
    </div>

    <%# The ladder in spend order (D9): one bar, segmented by tier, because the
        question the panel answers is who gets synced first — not how much quota
        is spent, which the line below already states. No cutoff marker: a
        statements sync spends three calls and the day's queue is only the stale
        assets, so "the budget runs out here" is precision the data lacks. %>
    <% eligible = @tier_counts.values.sum %>
    <% if eligible.positive? %>
      <div class="flex h-2 gap-0.5 overflow-hidden rounded-full bg-bg-muted">
        <% [ [ :held, "bg-primary" ], [ :followed, "bg-primary-hover" ] ].each do |tier, fill| %>
          <div class="<%= fill %>" style="width: <%= (@tier_counts[tier] * 100.0 / eligible).round(1) %>%"></div>
        <% end %>
      </div>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        <% [ [ :held, "bg-primary" ], [ :followed, "bg-primary-hover" ], [ :tracked, "bg-bg-muted" ] ].each do |tier, dot| %>
          <li class="flex items-center gap-1.5 text-xs text-fg-subtle">
            <span class="size-2 shrink-0 rounded-full <%= dot %>" aria-hidden="true"></span>
            <%= t("assets.tracked.tier_conteo", count: @tier_counts[tier], tier: t("assets.tracked.tier_#{tier}")) %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <p class="text-xs text-fg-subtle"><%= t("assets.tracked.orden_de_gasto") %></p>
    <p class="text-xs text-fg-subtle">
      <%= @budget.exhausted? ? t("assets.tracked.presupuesto_agotado") : t("assets.tracked.presupuesto_detalle", used: @budget.used, limit: @budget.limit) %>
    </p>
    <p class="text-xs text-fg-subtle"><%= t("assets.tracked.intro") %></p>
  </aside>
</div>

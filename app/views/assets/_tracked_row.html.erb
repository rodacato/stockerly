<%# Locals: asset, tier (:held | :followed | :tracked) %>
<%# A sourceless asset is NOT dimmed the way a paused one is: pausing is the
    owner's choice, this is the instance failing, and the two must not read
    alike (D46). %>
<% unnamed = asset.last_sync_error == SyncBulkBmvJob::UNNAMED %>
<div class="flex flex-col gap-3 rounded-2xl border bg-bg-surface px-4 py-3 <%= unnamed ? "border-warning" : "border-border-default" %> <%= "opacity-60" unless asset.active? %>">
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <p class="font-mono text-sm font-bold text-fg-default"><%= asset.symbol %></p>
        <span class="rounded-full bg-bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-fg-subtle">
          <%= t("assets.tracked.tier_#{tier}") %>
        </span>
        <% unless asset.active? %>
          <span class="whitespace-nowrap text-[10px] font-semibold uppercase tracking-wide text-warning-fg"><%= t("assets.tracked.en_pausa") %></span>
        <% end %>
      </div>
      <%# Wraps rather than truncates: the state phrase is longer than a date,
          and a clipped explanation is worse than a taller row. %>
      <p class="text-xs <%= unnamed ? "text-warning" : "text-fg-subtle" %>">
        <%= asset.name %> · <%= asset_type_label_es(asset.asset_type) %><%= " · #{t('assets.tracked.sin_fuente')}" if unnamed %>
      </p>
    </div>

    <% if tier == :tracked %>
      <%= button_to watchlist_items_path(asset_id: asset.id),
                    method: :post,
                    class: "shrink-0 rounded-lg bg-primary-muted px-3 py-1.5 text-xs font-semibold text-primary transition-colors hover:bg-primary hover:text-fg-inverse" do %>
        <%= t("assets.tracked.seguir") %>
      <% end %>
    <% end %>

    <%= button_to toggle_sync_asset_path(asset),
                  method: :patch,
                  class: "shrink-0 rounded-lg border border-border-default px-3 py-1.5 text-xs font-semibold text-fg-subtle transition-colors hover:border-border-strong hover:text-fg-default" do %>
      <%= asset.active? ? t("assets.tracked.pausar") : t("assets.tracked.reanudar") %>
    <% end %>

    <%# Pausing frees budget; this drops the asset out of the catalogue for good,
        which is why it confirms and the pause above does not. %>
    <%= button_to untrack_asset_path(asset), method: :delete,
                  form: { class: "inline-flex", data: { turbo_confirm: t("assets.tracked.confirmar_eliminar", symbol: asset.symbol) } },
                  class: "flex size-8 shrink-0 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-negative",
                  aria: { label: t("assets.tracked.eliminar") } do %>
      <span class="material-symbols-outlined text-base" aria-hidden="true">delete</span>
    <% end %>
  </div>

  <% if unnamed && (source = tracked_price_source(asset)) %>
    <div class="flex flex-col gap-2 rounded-xl bg-warning-bg px-3 py-2.5">
      <p class="text-xs text-warning-fg"><%= t("assets.tracked.sin_fuente_detalle", provider: source, symbol: asset.symbol_for(source)) %></p>
      <%= form_with url: map_source_symbol_asset_path(asset), method: :patch, class: "flex flex-wrap items-center gap-2" do |f| %>
        <%= f.hidden_field :provider, value: source %>
        <%= f.text_field :symbol, value: asset.symbol_for(source), autocomplete: "off",
              aria: { label: t("assets.tracked.sin_fuente_campo", provider: source) },
              class: "min-w-[140px] flex-1 rounded-lg border border-border-default bg-bg-canvas px-3 py-2 font-mono text-sm text-fg-default focus:outline-none focus:ring-2 focus:ring-primary/20" %>
        <%= f.submit t("assets.tracked.probar"),
              class: "cursor-pointer rounded-lg bg-warning-fg px-3 py-2 text-sm font-semibold text-bg-surface" %>
      <% end %>
      <p class="text-[11px] text-warning-fg"><%= t("assets.tracked.sin_fuente_promesa") %></p>
    </div>
  <% end %>
</div>

<% content_for :page_title, t("assets.index.titulo") %>
<%# Only declare the currency when the figures really are in it. %>
<% content_for :page_subtitle, t("assets.index.valor_de_mercado", currency: @currency) if @summary %>

<div class="flex flex-col gap-5">
  <% if @summary %>
    <section class="<%= card_classes("flex flex-wrap items-end justify-between gap-4 p-5") %>">
      <div class="flex flex-col gap-2">
        <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle">
          <%= t("assets.index.valor_de_mercado", currency: @currency) %>
        </p>
        <p class="font-display text-3xl font-bold tracking-tight text-fg-default">
          <%= format_currency_mx(@summary.total_value, currency: @currency, precision: 0) %>
        </p>
        <p class="text-xs text-fg-subtle">
          <%= t("assets.index.invertido", amount: format_currency_mx(@summary.total_invested, currency: @currency, precision: 0)) %>
        </p>
      </div>

      <% gain = @summary.unrealized_gain %>
      <% tone = case day_change_direction(gain.absolute)
         when :down then "bg-negative-bg text-negative-fg"
         when :flat then "bg-bg-muted text-fg-subtle"
         else "bg-positive-bg text-positive-fg"
         end %>
      <span class="shrink-0 rounded-full px-3 py-1.5 font-mono text-xs font-semibold <%= tone %>">
        <%= t("assets.index.no_realizada", amount: format_currency_mx(gain.absolute, currency: @currency, precision: 0)) %>
      </span>
    </section>
  <% elsif @fx_unavailable %>
    <section class="flex items-start gap-3 rounded-2xl border border-warning bg-warning-bg p-4">
      <%= icon_svg "currency_exchange", class: "text-xl text-warning-fg", "aria-hidden": "true" %>
      <div>
        <p class="text-sm font-semibold text-warning-fg"><%= t("comun.sin_tc_titulo") %></p>
        <p class="mt-0.5 text-xs text-warning-fg"><%= t("comun.sin_tc_cuerpo") %></p>
      </div>
    </section>
  <% end %>

  <%= render "components/sheet_dialog", frame_id: "trade_sheet", url: new_trade_path, label: t("trades.new.titulo") %>

  <%= render "components/segmented",
             label: t("assets.index.titulo"),
             options: [
               [ t("assets.index.cartera"), assets_path, @tab == "cartera" ],
               [ t("assets.index.watchlist"), assets_path(tab: "watchlist"), @tab == "watchlist" ]
             ] %>

  <% if @tab == "cartera" %>
    <% if @positions.any? %>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <% @positions.each do |position| %>
          <%= render "components/asset_row", position: position, declared_currency: @currency,
                     closes: @sparkline_closes[position.asset_id],
                     change: @day_changes[position.asset_id] %>
        <% end %>
      </div>
    <% else %>
      <%= render "components/empty_state",
                 icon: "account_balance_wallet",
                 title: t("assets.index.vacio_cartera_titulo"),
                 description: t("assets.index.vacio_cartera_cuerpo"),
                 cta_text: t("assets.index.importar"),
                 cta_path: new_trade_import_path %>
    <% end %>
  <% else %>
    <% if @watchlist_items.any? %>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <% @watchlist_items.each do |item| %>
          <%= render "components/watch_row", item: item, gap: @watchlist_gaps[item.asset.symbol],
                     closes: @sparkline_closes[item.asset_id],
                     change: @day_changes[item.asset_id] %>
        <% end %>
      </div>
    <% else %>
      <%= render "components/empty_state",
                 icon: "visibility",
                 title: t("assets.index.vacio_watchlist_titulo"),
                 description: t("assets.index.vacio_watchlist_cuerpo") %>
    <% end %>
  <% end %>

  <%# Historial (D60) and the importer (ACT-1) sit beside Tracked (D9), so both
      stay reachable once holdings exist. %>
  <%= render "settings/nav_row", icon: "receipt_long", path: positions_path,
             title: t("positions.index.titulo"), description: t("assets.index.ver_historial_desc") %>
  <%= render "settings/nav_row", icon: "upload_file", path: new_trade_import_path,
             title: t("assets.index.importar"), description: t("assets.index.importar_desc") %>
  <%= render "settings/nav_row", icon: "radar", path: tracked_assets_path,
             title: t("assets.index.ver_tracked"), description: t("assets.index.ver_tracked_desc") %>
</div>

<% content_for :page_title, t("assets.index.titulo") %>
<%# Only declare the currency when the figures really are in it. %>
<% content_for :page_subtitle, t("assets.index.valor_de_mercado", currency: @currency) if @summary %>

<div class="flex flex-col gap-5">
  <% if @summary %>
    <section class="flex flex-wrap items-end justify-between gap-4 rounded-2xl border border-border-default bg-bg-surface p-5">
      <div class="flex flex-col gap-2">
        <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle">
          <%= t("assets.index.valor_de_mercado", currency: @currency) %>
        </p>
        <p class="font-display text-3xl font-bold tracking-tight text-fg-default">
          <%= format_currency_mx(@summary.total_value, currency: @currency, precision: 0) %>
        </p>
        <p class="text-xs text-fg-subtle">
          <%= t("assets.index.invertido", amount: format_currency_mx(@summary.total_invested, currency: @currency, precision: 0)) %>
          ·
          <%= t("assets.index.no_realizada", amount: format_currency_mx(@summary.unrealized_gain.absolute, currency: @currency, precision: 0)) %>
        </p>
      </div>
    </section>
  <% elsif @fx_unavailable %>
    <section class="flex items-start gap-3 rounded-2xl border border-warning bg-warning-bg p-4">
      <span class="material-symbols-outlined text-xl text-warning-fg" aria-hidden="true">currency_exchange</span>
      <div>
        <p class="text-sm font-semibold text-warning-fg"><%= t("comun.sin_tc_titulo") %></p>
        <p class="mt-0.5 text-xs text-warning-fg"><%= t("comun.sin_tc_cuerpo") %></p>
      </div>
    </section>
  <% end %>

  <%= render "components/sheet_dialog", frame_id: "trade_sheet", url: new_trade_path, label: t("trades.new.titulo") %>

  <%= render "components/segmented",
             label: t("assets.index.titulo"),
             options: [
               [ t("assets.index.cartera"), assets_path, @tab == "cartera" ],
               [ t("assets.index.watchlist"), assets_path(tab: "watchlist"), @tab == "watchlist" ]
             ] %>

  <% if @tab == "cartera" %>
    <% if @positions.any? %>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <% @positions.each do |position| %>
          <%= render "components/asset_row", position: position, declared_currency: @currency,
                     closes: @sparkline_closes[position.asset_id],
                     change: @day_changes[position.asset_id] %>
        <% end %>
      </div>
    <% else %>
      <%= render "components/empty_state",
                 icon: "account_balance_wallet",
                 title: t("assets.index.vacio_cartera_titulo"),
                 description: t("assets.index.vacio_cartera_cuerpo"),
                 cta_text: t("assets.index.importar"),
                 cta_path: new_trade_import_path %>
    <% end %>
  <% else %>
    <% if @watchlist_items.any? %>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <% @watchlist_items.each do |item| %>
          <%= render "components/watch_row", item: item, gap: @watchlist_gaps[item.asset.symbol],
                     closes: @sparkline_closes[item.asset_id],
                     change: @day_changes[item.asset_id] %>
        <% end %>
      </div>
    <% else %>
      <%= render "components/empty_state",
                 icon: "visibility",
                 title: t("assets.index.vacio_watchlist_titulo"),
                 description: t("assets.index.vacio_watchlist_cuerpo") %>
    <% end %>
  <% end %>

  <%# The design drew Historial without a door (D60): its only inbound link was
      from one asset's detail. This follows the foot-of-list pattern the screen
      already uses for Tracked (D9) rather than inventing one. %>
  <%= link_to positions_path,
              class: "flex items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-3.5 transition-colors hover:border-border-strong" do %>
    <span class="material-symbols-outlined text-xl text-fg-subtle" aria-hidden="true">receipt_long</span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-semibold text-fg-default"><%= t("positions.index.titulo") %></span>
      <span class="block text-xs text-fg-subtle"><%= t("assets.index.ver_historial_desc") %></span>
    </span>
    <span class="material-symbols-outlined text-xl text-fg-subtle" aria-hidden="true">chevron_right</span>
  <% end %>

  <%# The second door of Holdings/Vacío (ACT-1), as a foot-of-list row so it is
      reachable once the portfolio has holdings too. One format only, per D62. %>
  <%= link_to new_trade_import_path,
              class: "flex items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-3.5 transition-colors hover:border-border-strong" do %>
    <span class="material-symbols-outlined text-xl text-fg-subtle" aria-hidden="true">upload_file</span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-semibold text-fg-default"><%= t("assets.index.importar") %></span>
      <span class="block text-xs text-fg-subtle"><%= t("assets.index.importar_desc") %></span>
    </span>
    <span class="material-symbols-outlined text-xl text-fg-subtle" aria-hidden="true">chevron_right</span>
  <% end %>

  <%= link_to tracked_assets_path,
              class: "flex items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-3.5 transition-colors hover:border-border-strong" do %>
    <span class="material-symbols-outlined text-xl text-fg-subtle" aria-hidden="true">radar</span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-semibold text-fg-default"><%= t("assets.index.ver_tracked") %></span>
      <span class="block text-xs text-fg-subtle"><%= t("assets.index.ver_tracked_desc") %></span>
    </span>
    <span class="material-symbols-outlined text-xl text-fg-subtle" aria-hidden="true">chevron_right</span>
  <% end %>
</div>

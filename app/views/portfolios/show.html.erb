<%# Consolidado (slice 4). Mobile stacks; desktop puts the chart and the donut
    side by side, then the two comparison cards. %>
<% content_for :page_title, t(".titulo") %>
<% content_for :page_subtitle, t(".tu_patrimonio", currency: @currency) %>

<div class="flex flex-col gap-6">
  <%= render "portfolios/patrimonio_total", summary: @summary, currency: @currency, fx_unavailable: @fx_unavailable %>

  <div class="flex flex-col gap-6 lg:grid lg:grid-cols-12 lg:items-start">
    <section class="lg:col-span-8">
      <div class="<%= card_classes("p-5") %>">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".como_ha_ido") %></h2>
          <% if @twr %>
            <span class="font-mono text-sm font-semibold <%= gain_color(@twr) %>">
              <%= t(".en_el_periodo", percent: signed_percent(@twr)) %>
            </span>
          <% end %>
        </div>

        <% if @series.any? %>
          <p class="mt-2 text-xs text-fg-subtle"><%= t(".rango_real", from: l(@from, format: :long), to: l(@to, format: :long), currency: @currency) %></p>
          <div class="mt-4" data-controller="chart" data-chart-height-value="240"
               data-chart-series-value="<%= chart_series_json(@series) %>"></div>

          <div class="mt-3 flex flex-wrap gap-4 text-xs text-fg-subtle">
            <span class="inline-flex items-center gap-2">
              <span class="size-2 rounded-full bg-positive-fg"></span><%= t(".valor") %>
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="size-2 rounded-full bg-fg-subtle"></span><%= t(".aportado") %>
            </span>
          </div>
          <%# D142: five ranges of a curve that is not there all land on the
              same card, so the control waits for something to cut. %>
          <%= render "components/segmented",
                     variant: :chips,
                     label: t(".como_ha_ido"),
                     options: Trading::UseCases::AssembleConsolidado::PERIODS.keys.map { |key|
                       [ t(".periodo.#{period_key(key)}"), portfolio_path(period: key), @period == key ]
                     } %>
        <% else %>
          <div class="mt-4">
            <%= render "components/empty_state", icon: "show_chart",
                       title: t(".sin_historial_titulo"), description: t(".sin_historial_cuerpo") %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="lg:col-span-4">
      <div class="<%= card_classes("p-5") %>">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".como_repartido") %></h2>
          <span class="font-mono text-[11px] uppercase tracking-wider text-fg-subtle">
            <%= @allocation_view == "sector" ? t(".por_sector", currency: @currency) : t(".por_tipo", currency: @currency) %>
          </span>
        </div>
        <nav class="mt-3 flex gap-2" aria-label="<%= t(".como_repartido") %>">
          <% { "type" => t(".toggle.tipo"), "sector" => t(".toggle.sector") }.each do |view, label| %>
            <%= link_to label, portfolio_path(period: @period, por: (view == "sector" ? "sector" : nil)),
                        class: "rounded-full px-3 py-1.5 text-xs font-semibold #{view == @allocation_view ? 'bg-primary-muted text-primary-fg' : 'bg-bg-muted text-fg-subtle hover:text-fg-default'}",
                        aria: { current: (view == @allocation_view ? "true" : nil) } %>
          <% end %>
        </nav>

        <% segments = @allocation_view == "sector" ? sector_segments(@allocation) : allocation_segments(@allocation) %>
        <% if segments.any? %>
          <%# The partial carries its own legend; the artboard leaves the ring's
              centre empty rather than repeating the total already on the strip. %>
          <div class="mt-4">
            <%= render "components/donut_chart", segments: segments %>
          </div>
        <% else %>
          <p class="mt-4 text-sm text-fg-subtle"><%= t("assets.index.vacio_cartera_cuerpo") %></p>
        <% end %>
      </div>
    </section>
  </div>

  <% if @currency_exposure %>
    <section class="<%= card_classes("flex flex-col gap-2 p-5") %>">
      <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".dolar_titulo") %></h2>
      <p class="text-sm text-fg-default">
        <%= t(".dolar_cuerpo", share: @currency_exposure.usd_share,
              amount: format_currency_mx(@currency_exposure.usd_value, currency: "MXN", precision: 0)) %>
      </p>
      <% if @currency_exposure.usd_value.positive? %>
        <p class="text-sm text-fg-subtle">
          <%= t(".dolar_si_baja", percent: Trading::Domain::CurrencyExposure::MOVE_PERCENT,
                effect: format_currency_mx(@currency_exposure.effect_of(Trading::Domain::CurrencyExposure::MOVE_PERCENT), currency: "MXN", precision: 0)) %>
        </p>
      <% end %>
      <p class="text-xs text-fg-subtle"><%= t(".dolar_nota") %></p>
    </section>
  <% end %>

  <section class="flex flex-col gap-4">
    <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".valio_la_pena") %></h2>

    <div class="grid gap-4 lg:grid-cols-3">
      <%= render "portfolios/comparison_card",
                 label: t(".vs_cetes", term: Trading::Domain::CetesComparison::TERM),
                 card: @vs_cetes,
                 level_label: t(".igual_cetes"),
                 empty_body: (@currency != "MXN" ? t(".cetes_solo_mxn") : nil),
                 body: (@vs_cetes && t(".vs_cetes_cuerpo",
                        mine: signed_percent(@vs_cetes[:mine]),
                        benchmark: signed_percent(@vs_cetes[:benchmark]),
                        term: @vs_cetes[:term],
                        from: l(@from, format: :long), to: l(@to, format: :long))) %>

      <%= render "portfolios/comparison_card",
                 label: t(".vs_ipc"),
                 card: @vs_index,
                 level_label: t(".igual_ipc"),
                 empty_body: (@currency != "MXN" ? t(".ipc_solo_mxn") : nil),
                 body: (@vs_index && t(".vs_ipc_cuerpo",
                        mine: signed_percent(@vs_index[:mine]),
                        benchmark: signed_percent(@vs_index[:benchmark]),
                        from: l(@from, format: :long), to: l(@to, format: :long))) %>

      <% if @vs_hold %>
        <% hold_args = { from: l(@from, format: :long), to: l(@to, format: :long),
                         value: format_currency_mx(@vs_hold[:hold_value], currency: @currency, precision: 0),
                         points: number_with_precision(@vs_hold[:points].abs, precision: 1) } %>
        <% hold_body = case comparison_standing(@vs_hold[:points])
                       when :behind then t(".vs_hold_cuerpo", **hold_args)
                       when :ahead then t(".vs_hold_cuerpo_positivo", **hold_args)
                       else t(".vs_hold_cuerpo_igual", **hold_args)
                       end %>
      <% end %>
      <%= render "portfolios/comparison_card", label: t(".vs_hold"), card: @vs_hold, body: hold_body, level_label: t(".igual_hold") %>
    </div>

    <% if @vs_cetes || @vs_hold || @vs_index %>
      <div class="flex items-start gap-3 rounded-2xl border border-warning bg-warning-bg p-4">
        <%= icon_svg "info", class: "text-lg text-warning-fg", "aria-hidden": "true" %>
        <p class="text-xs text-warning-fg"><%= t(".twr_nota") %></p>
      </div>
    <% end %>
  </section>
</div>

<%# What the answer read, folded: the titles say what, the cards say from where and when. Each [n] in the prose opens its card. Locals: message. %>
<% cards = message.cards %>
<% if cards.any? %>
  <details data-assistant-sources-target="fold" class="group ml-13">
    <summary class="flex cursor-pointer list-none flex-wrap items-center gap-1.5 rounded-lg py-1 text-xs text-fg-subtle [&::-webkit-details-marker]:hidden">
      <span class="font-mono text-[11px] uppercase tracking-widest"><%= t(".lo_que_lei") %></span>
      <% cards.each do |card| %>
        <span class="inline-flex items-center gap-1 rounded-full bg-bg-muted px-2.5 py-1 font-semibold text-fg-default">
          <%= icon_svg "check", class: "text-sm text-primary", "aria-hidden": "true" %>
          <%= card["title"] %>
        </span>
      <% end %>
      <%= icon_svg "expand_more", class: "text-base transition-transform group-open:rotate-180", "aria-hidden": "true" %>
    </summary>

    <div class="mt-2 flex flex-col gap-2">
      <% cards.each_with_index do |card, index| %>
        <section id="assistant_card_<%= message.id %>_<%= index + 1 %>" tabindex="-1"
                 class="<%= card_classes("flex flex-col gap-2 p-4 outline-none focus:ring-2 focus:ring-primary") %>">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="flex items-center gap-2.5 text-sm font-semibold text-fg-default">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-bg-muted font-mono text-xs text-fg-subtle"><%= index + 1 %></span>
              <%= card["title"] %>
            </h3>
            <% if card["figure"].present? %>
              <span class="shrink-0 font-mono text-sm font-semibold tabular-nums text-fg-default"><%= card["figure"] %></span>
            <% end %>
          </div>
          <% if card["body"].present? %>
            <p class="text-sm leading-relaxed text-fg-default"><%= card["body"] %></p>
          <% end %>
          <% if card["source"].present? %>
            <p class="text-xs text-fg-subtle"><%= card["source"] %></p>
          <% end %>
        </section>
      <% end %>
    </div>
  </details>
<% end %>

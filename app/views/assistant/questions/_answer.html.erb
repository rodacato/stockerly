<%# Replaced by AssistantComposeJob as the prose streams in. Locals: message. %>
<div id="assistant_answer_<%= message.id %>" aria-live="polite" class="flex flex-col gap-1.5">
  <% if message.answered? || (message.streaming? && message.answer.present?) %>
    <p class="text-[15px] leading-relaxed text-fg-default"><%= message.answer %></p>
    <% if message.answered? %>
      <p class="text-xs text-fg-subtle"><%= t("assistant.questions.answer.no_es_recomendacion") %></p>
    <% end %>
  <% elsif message.discarded? %>
    <p class="text-sm text-fg-subtle"><%= t("assistant.questions.answer.descartada") %></p>
  <% elsif message.failed? %>
    <p class="text-sm text-negative-fg"><%= t("assistant.questions.answer.fallo") %></p>
  <% else %>
    <p class="text-sm text-fg-subtle"><%= t("assistant.questions.answer.escribiendo") %></p>
  <% end %>
</div>

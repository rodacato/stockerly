<%# Replaced by AssistantComposeJob as the prose streams in. Locals: message. %>
<div id="assistant_answer_<%= message.id %>" aria-live="polite" class="flex items-start gap-3">
  <%= render "assistant/velita", classes: "size-10 shrink-0", state: velita_state(message) %>
  <div class="flex min-w-0 flex-1 flex-col gap-1.5 pt-1.5">
    <% if message.answered? || (message.streaming? && message.answer.present?) %>
      <div class="flex flex-col gap-3 text-[15px] leading-relaxed text-fg-default"><%= assistant_answer_html(message) %></div>
    <% elsif message.discarded? %>
      <p class="text-sm text-fg-subtle"><%= t("assistant.questions.answer.descartada") %></p>
      <%= render "assistant/questions/retry", message: message %>
    <% elsif message.failed? %>
      <%= link_to t("assistant.questions.answer.fallo"), settings_assistant_path, data: { turbo_frame: "_top" },
                  class: "text-sm text-negative-fg underline-offset-2 hover:underline" %>
      <%= render "assistant/questions/retry", message: message %>
    <% elsif message.pending? %>
      <p class="text-sm text-fg-subtle"><%= t("assistant.questions.answer.buscando") %></p>
    <% else %>
      <p class="text-sm text-fg-subtle"><%= t("assistant.questions.answer.escribiendo") %></p>
    <% end %>
  </div>
</div>

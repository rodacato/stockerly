<%# One turn: the reader's question, Velita's answer under it, and what she read folded below (D171). Locals: message. %>
<article id="assistant_message_<%= message.id %>" data-controller="scroll-into-view assistant-sources" class="flex scroll-mt-2 flex-col gap-3">
  <div class="flex flex-col items-end gap-1">
    <p class="max-w-[85%] rounded-2xl rounded-br-md bg-primary-muted px-4 py-2.5 text-[15px] leading-snug text-fg-default"><%= message.question %></p>
    <%= time_tag message.created_at, assistant_asked_at(message.created_at), class: "font-mono text-[11px] text-fg-subtle" %>
  </div>

  <%= render "assistant/questions/answer", message: message %>
  <%= render "assistant/questions/sources", message: message %>
</article>

<% content_for :page_title, t(".titulo") %>
<% content_for :header_bar do %>
  <%= render "components/header_bar", title: t(".titulo"), back_path: (@symbol ? market_asset_path(@symbol) : dashboard_path) %>
<% end %>
<% holdings = @reads_holdings ? t(".lee_tus_posiciones") : t(".no_ve_tus_posiciones") %>
<% subtitle = if @symbol then t(".sobre", symbol: @symbol, posiciones: holdings)
              elsif @from then t(".desde", pantalla: t("nav.#{@from}"), posiciones: holdings)
              else "#{holdings.upcase_first}." end %>
<% suggestions = assistant_suggestions(from: @from, symbol: @symbol, seen: @seen) %>

<%# The same route is a page on its own and the drawer's content (D11): Turbo
    takes this frame out of the response when Velita opened it. %>
<%= turbo_frame_tag "assistant_sheet" do %>
  <div class="mx-auto flex min-h-0 w-full max-w-xl flex-1 flex-col gap-5 <%= "p-5" if turbo_frame_request? %>">
    <% if turbo_frame_request? %>
      <span class="mx-auto -mt-2 h-1 w-10 shrink-0 rounded-full bg-border-strong lg:hidden" aria-hidden="true"></span>
    <% end %>
    <%= render "assistant/sheet_header", title: t(".titulo"), subtitle: subtitle, history: true, context: { from: @from, symbol: @symbol }.compact %>

    <% if @connected %>
      <%= turbo_stream_from "assistant", @token %>
      <div class="flex min-h-0 flex-1 flex-col gap-6 overflow-y-auto">
        <% messages = @conversation&.messages.to_a %>
        <% if suggestions.any? && @question.blank? && messages.blank? %>
          <section id="assistant_suggestions" class="flex flex-col items-start gap-2.5">
            <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle"><%= t(".de_lo_que_ves") %></p>
            <% suggestions.each do |suggestion| %>
              <%= form_with scope: :question, url: assistant_questions_path, data: { turbo_frame: "_top" } do |f| %>
                <%= f.hidden_field :token, value: @token %>
                <%= f.hidden_field :symbol, value: @symbol %>
                <%= f.hidden_field :screen, value: @from %>
                <%= f.hidden_field :question, value: suggestion %>
                <%= f.button suggestion, type: "submit",
                             class: "cursor-pointer rounded-full bg-primary-muted px-4 py-2 text-left text-sm font-semibold text-primary-fg transition-colors hover:bg-primary hover:text-fg-inverse" %>
              <% end %>
            <% end %>
          </section>
        <% end %>
        <%# One line for the whole thread, not one per answer; hidden until something was asked. %>
        <div id="assistant_messages" class="peer flex flex-col gap-6"><%= render partial: "assistant/questions/message", collection: messages, as: :message %></div>
        <p class="hidden text-xs text-fg-subtle peer-has-[article]:block"><%= t(".no_es_recomendacion") %></p>
      </div>
      <%= render "assistant/questions/form", token: @token, symbol: @symbol, screen: @from, asked: messages.present?, value: @question.presence,
                 autofocus: !turbo_frame_request? || @question.present? %>
    <% else %>
      <%= render "components/empty_state", size: :inline, icon: "psychology",
                 title: t(".sin_conexion"), cta_text: t(".conectar"), cta_path: settings_assistant_path, cta_frame: "_top" %>
    <% end %>
  </div>
<% end %>

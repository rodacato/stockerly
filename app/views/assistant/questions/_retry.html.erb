<%# The same question again, in the same conversation, after an answer that could not be kept. Locals: message. %>
<% conversation = message.conversation %>
<%= form_with scope: :question, url: assistant_questions_path, data: { turbo_frame: "_top" } do |f| %>
  <%= f.hidden_field :token, value: conversation.token %>
  <%= f.hidden_field :symbol, value: conversation.symbol %>
  <%= f.hidden_field :screen, value: conversation.screen %>
  <%= f.hidden_field :question, value: message.question %>
  <%= f.button t("assistant.questions.retry.preguntar_de_nuevo"), type: "submit",
               class: "cursor-pointer self-start rounded-full bg-primary-muted px-3 py-1.5 text-xs font-semibold text-primary-fg transition-colors hover:bg-primary hover:text-fg-inverse" %>
<% end %>

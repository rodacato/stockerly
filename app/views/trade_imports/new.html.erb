<% content_for :page_title, t(".titulo") %>

<% content_for :header_bar do %>
  <%= render "components/header_bar", title: t(".titulo"), back_path: assets_path %>
<% end %>

<div class="mx-auto flex w-full max-w-lg flex-col gap-4">
  <p class="text-sm text-fg-subtle"><%= t(".intro") %></p>

  <% if @error.present? %>
    <p class="rounded-lg bg-negative-bg px-3 py-2.5 text-sm text-negative-fg" role="alert"><%= @error %></p>
  <% end %>

  <%# Turbo refuses a 200 to a form POST, and a successful preview renders
      rather than redirects -- it cannot redirect, because the CSV lives in the
      request and nowhere else. Opting out is what makes the happy path load. %>
  <%# turbo: false because preview renders rather than redirects, so the button
      feedback Turbo would give for free is wired by hand instead. %>
  <%= form_with url: preview_trade_import_path, class: "flex flex-col gap-4",
                data: { turbo: false, controller: "submitting", submitting_label_value: t(".revisando") } do |f| %>
    <label class="<%= card_classes("flex cursor-pointer flex-col items-center gap-2 border-dashed px-5 py-7 text-center") %>">
      <%= icon_svg "upload_file", class: "text-2xl text-primary" %>
      <span class="text-sm font-semibold text-primary-fg"><%= t(".elegir") %></span>
      <span class="text-xs text-fg-subtle"><%= t(".arrastra") %></span>
      <%= f.file_field :archivo, accept: ".csv,text/csv", class: "sr-only" %>
    </label>

    <div class="flex items-center gap-3">
      <span class="h-px flex-1 bg-border-default"></span>
      <span class="text-xs text-fg-subtle"><%= t(".o_pega") %></span>
      <span class="h-px flex-1 bg-border-default"></span>
    </div>

    <%= f.text_area :contenido, rows: 6, spellcheck: false,
                    placeholder: t(".ejemplo"),
                    class: field_classes(:md, "font-mono text-xs") %>

    <div class="flex flex-col gap-2 rounded-2xl bg-bg-muted px-4 py-3.5">
      <div class="flex items-center gap-2">
        <%= icon_svg "info", class: "text-sm text-fg-subtle" %>
        <span class="text-xs font-semibold text-fg-default"><%= t(".columnas") %></span>
      </div>
      <p class="font-mono text-[10px] leading-relaxed text-fg-default">asset_symbol · side · shares · price_per_share · executed_at</p>
      <p class="text-xs text-fg-subtle"><%= t(".opcionales") %></p>
    </div>

    <div class="flex flex-col items-center gap-2 pt-1">
      <%= f.submit t(".revisar"), class: button_classes(:primary, :lg, "w-full cursor-pointer") %>
      <p class="text-xs text-fg-subtle"><%= t(".nada_aun") %></p>
    </div>
  <% end %>
</div>

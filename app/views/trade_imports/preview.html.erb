<% content_for :page_title, t(".titulo") %>

<div class="mx-auto flex w-full max-w-lg flex-col gap-4">
  <div class="flex items-center gap-3">
    <%= link_to new_trade_import_path, class: "text-fg-default", aria: { label: t(".volver") } do %>
      <span class="material-symbols-outlined text-xl">arrow_back</span>
    <% end %>
    <h1 class="font-display text-lg font-bold text-fg-default"><%= t(".titulo") %></h1>
  </div>

  <% if @reason.present? %>
    <%# The batch is all-or-nothing: a partial import leaves the portfolio wrong
        without saying so, which is worse than refusing the whole file. %>
    <div class="flex flex-col gap-2 rounded-2xl bg-warning-bg px-4 py-3.5">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-base text-warning-fg">warning</span>
        <span class="text-sm font-semibold text-warning-fg"><%= t(".rechazo.titulo") %></span>
      </div>
      <p class="text-xs leading-relaxed text-warning-fg"><%= t("trade_imports.preview.rechazo.#{@reason}", count: Array(@details).size) %></p>
    </div>

    <% if @reason == :unknown_symbols %>
      <%# Checked by default because every symbol here came out of the owner's
          own file. Unchecking is for the ticker they do not recognise. %>
      <%= form_with url: track_missing_trade_import_path, class: "flex flex-col gap-3",
                    data: { controller: "check-all" } do |f| %>
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-semibold uppercase tracking-widest text-fg-subtle"><%= t(".rechazo.faltan") %></span>
          <button type="button" data-action="check-all#toggle"
                  class="cursor-pointer text-xs font-semibold text-primary"><%= t(".rechazo.alternar") %></button>
        </div>

        <ul class="flex flex-col gap-1.5">
          <% @details.each do |symbol| %>
            <li>
              <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-border-default bg-bg-surface px-3 py-2.5">
                <%= check_box_tag "symbols[]", symbol, true, id: "symbol_#{symbol.downcase.gsub(/[^a-z0-9]+/, "-")}",
                      data: { check_all_target: "box" },
                      class: "size-4 cursor-pointer accent-primary" %>
                <span class="font-mono text-xs font-semibold text-fg-default"><%= symbol %></span>
                <span class="ml-auto text-[10px] text-fg-subtle">
                  <%= @catalogued.include?(symbol) ? t(".rechazo.en_catalogo") : t(".rechazo.preguntar") %>
                </span>
              </label>

              <%# Two escapes for the two things an unresolvable ticker can be.
                  Neither is the default: the row works untouched. %>
              <div class="mt-1.5 flex flex-col gap-1.5 pl-9">
                <label class="flex items-center gap-2">
                  <span class="text-[10px] text-fg-subtle"><%= t(".rechazo.renombrado") %></span>
                  <%= text_field_tag "renames[#{symbol}]", nil, placeholder: t(".rechazo.renombrado_ph"),
                        class: "w-24 rounded border border-border-default bg-bg-canvas px-2 py-1 font-mono text-[11px] uppercase text-fg-default" %>
                </label>
                <label class="flex cursor-pointer items-center gap-2">
                  <%= check_box_tag "delisted[]", symbol, false, id: "dead_#{symbol.downcase.gsub(/[^a-z0-9]+/, "-")}",
                        class: "size-3.5 cursor-pointer accent-warning-fg" %>
                  <span class="text-[10px] text-fg-subtle"><%= t(".rechazo.deslistado") %></span>
                </label>
              </div>
            </li>
          <% end %>
        </ul>

        <p class="rounded-2xl bg-bg-muted px-4 py-3.5 text-xs leading-relaxed text-fg-subtle"><%= t(".rechazo.porque") %></p>
        <%= f.submit t(".rechazo.dar_alta"),
              class: "w-full cursor-pointer rounded-lg bg-primary px-4 py-3 text-center text-sm font-semibold text-fg-inverse" %>
      <% end %>

      <%# The refusal is all-or-nothing so a portfolio is never quietly short a
          trade. Saying which trades leave, and being told to go ahead, is what
          keeps that true while unblocking a file one dead ticker holds up. %>
      <%= form_with url: preview_trade_import_path, class: "flex flex-col gap-2 rounded-2xl bg-bg-muted px-4 py-3.5", data: { turbo: false } do |f| %>
        <%= f.hidden_field :contenido, value: @csv_text %>
        <%= f.hidden_field :skip_unknown, value: "1" %>
        <p class="text-xs leading-relaxed text-fg-subtle">
          <%= t(".rechazo.parcial_cuerpo", count: @blocked_rows, symbols: Array(@details).size) %>
        </p>
        <%= f.submit t(".rechazo.parcial", count: @importable_rows),
              class: "cursor-pointer self-start text-sm font-semibold text-primary" %>
      <% end %>
    <% else %>
      <ul class="flex flex-col gap-1.5">
        <% Array(@details).each do |detail| %>
          <li class="rounded-lg bg-bg-muted px-3 py-2 font-mono text-[11px] text-fg-subtle"><%= detail.is_a?(Hash) ? detail.to_json : detail %></li>
        <% end %>
      </ul>
    <% end %>

    <%= link_to t(".rechazo.otro_archivo"), new_trade_import_path, class: "text-center text-sm font-semibold text-fg-subtle" %>
  <% else %>
    <p class="flex items-center gap-2 rounded-lg bg-info-bg px-3 py-2.5 text-xs text-info-fg" role="status">
      <span class="material-symbols-outlined text-sm">visibility</span>
      <%= t(".nada_guardado") %>
    </p>

    <div class="<%= card_classes("flex flex-col gap-3 px-4 py-4") %>">
      <div class="flex">
        <div class="flex flex-1 flex-col gap-0.5">
          <span class="text-[10px] font-semibold uppercase tracking-widest text-fg-subtle"><%= t(".movimientos") %></span>
          <span class="font-mono text-2xl font-bold text-fg-default"><%= @report[:imported] %></span>
        </div>
        <div class="flex flex-1 flex-col gap-0.5">
          <span class="text-[10px] font-semibold uppercase tracking-widest text-fg-subtle"><%= t(".invertido") %></span>
          <span class="font-mono text-2xl font-bold text-fg-default"><%= format_currency_mx(@report[:invested], currency: @report[:currency]) %></span>
        </div>
      </div>
      <span class="h-px bg-border-default"></span>
      <p class="text-xs text-fg-subtle">
        <%= t(".rango", desde: l(@report[:earliest_on]), hasta: l(@report[:latest_on]), count: @report[:symbols].size) %>
      </p>
    </div>

    <% if @report[:skipped].any? %>
      <p class="flex items-center gap-2 rounded-lg bg-bg-muted px-3 py-2.5 text-xs text-fg-subtle">
        <span class="material-symbols-outlined text-sm">content_copy</span>
        <%= t(".duplicados", count: @report[:skipped].size) %>
      </p>
    <% end %>

    <p class="text-[10px] font-semibold uppercase tracking-widest text-fg-subtle"><%= t(".simbolos") %></p>
    <ul class="flex flex-wrap gap-2">
      <% @report[:symbols].each do |symbol| %>
        <li class="rounded-lg border border-border-default bg-bg-surface px-2.5 py-1.5 font-mono text-xs font-semibold text-fg-default"><%= symbol %></li>
      <% end %>
    </ul>

    <%# Turbo drives this one, so it disables the button and swaps the label
        itself -- an import of a few hundred rows is not instant. %>
    <%= form_with url: trade_imports_path, class: "flex flex-col items-center gap-2 pt-1",
                  data: { turbo_submits_with: t(".confirmando") } do |f| %>
      <%= f.hidden_field :contenido, value: @csv_text %>
      <%= f.submit t(".confirmar", count: @report[:imported]),
                   class: "w-full cursor-pointer rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-fg-inverse" %>
      <%= link_to t(".cancelar"), new_trade_import_path, class: "text-sm font-semibold text-fg-subtle" %>
    <% end %>
  <% end %>
</div>

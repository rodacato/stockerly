<% content_for(:title, "#{t('auth.expirado.titulo')} | Stockerly") %>
<%# State 4 — reset-expired. Rendered by `find_user_by_token` when the token is
    invalid or aged out, or by `update` if the token died between GET and PATCH.
    The window is stated from the constant, not repeated in prose. %>

<div class="flex flex-col items-center space-y-3 text-center">
  <div class="mb-2 flex size-14 items-center justify-center rounded-2xl bg-negative-bg text-negative">
    <span class="material-symbols-outlined text-3xl" aria-hidden="true">link_off</span>
  </div>
  <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-fg-subtle"><%= t("auth.expirado.kicker") %></p>
  <h2 class="text-2xl font-extrabold tracking-tight text-fg-default"><%= t("auth.expirado.titulo") %></h2>
  <p class="max-w-sm text-sm text-fg-subtle">
    <%= t("auth.expirado.cuerpo_html",
          duration: tag.span(duration_in_words_es(User::PASSWORD_RESET_EXPIRES_IN),
                             class: "font-mono font-semibold text-fg-default")) %>
  </p>
</div>

<%= link_to forgot_password_path,
      class: button_classes(:primary, :md, "mt-6 flex w-full items-center justify-center gap-2 shadow-md") do %>
  <%= t("auth.expirado.solicitar") %>
  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
<% end %>

<p class="mt-4 text-center text-sm text-fg-subtle">
  <%= t("auth.expirado.recordaste") %>
  <%= link_to t("auth.expirado.volver"), login_path, class: "font-medium text-primary hover:underline" %>
</p>

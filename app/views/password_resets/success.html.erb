<% content_for(:title, "#{t('auth.exito.titulo')} | Stockerly") %>
<%# State 5 — reset-success. %>

<div class="flex flex-col items-center gap-4 text-center">
  <%= render "shared/auth_header", icon: "check_circle", tone: :positive,
             kicker: t("auth.exito.kicker"), title: t("auth.exito.titulo"),
             subtitle: t("auth.exito.cuerpo") %>
</div>

<%= link_to login_path,
      class: button_classes(:primary, :lg, "mt-6 flex w-full items-center justify-center gap-2") do %>
  <%= t("auth.exito.ir") %>
  <%= icon_svg "arrow_forward", class: "text-[18px]", "aria-hidden": "true" %>
<% end %>

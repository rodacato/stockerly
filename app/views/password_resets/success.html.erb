<% content_for(:title, "#{t('auth.exito.titulo')} | Stockerly") %>
<%# State 5 — reset-success. %>

<div class="flex flex-col items-center space-y-3 text-center">
  <div class="mb-2 flex size-14 items-center justify-center rounded-2xl bg-positive-bg text-positive">
    <span class="material-symbols-outlined text-3xl" aria-hidden="true">check_circle</span>
  </div>
  <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-fg-subtle"><%= t("auth.exito.kicker") %></p>
  <h1 class="font-display text-3xl font-bold tracking-tight text-fg-default"><%= t("auth.exito.titulo") %></h1>
  <p class="max-w-sm text-sm text-fg-subtle"><%= t("auth.exito.cuerpo") %></p>
</div>

<%= link_to login_path,
      class: button_classes(:primary, :lg, "mt-6 flex w-full items-center justify-center gap-2") do %>
  <%= t("auth.exito.ir") %>
  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
<% end %>

<% content_for(:title, "#{t("auth.forgot.titulo")} | Stockerly") %>
<%# State 1 — the forgot form. The "sent" state lives on its own template, never
    as a flash here, so the two are separable screens (S11 #147). %>

<div class="flex flex-col gap-6">
  <%= render "shared/auth_header", title: t("auth.forgot.titulo"), subtitle: t("auth.forgot.subtitulo") %>

  <% if flash[:alert].present? %>
    <%= render "shared/flash_alert", message: flash[:alert] %>
  <% end %>

  <%= form_with url: forgot_password_path, method: :post, class: "flex flex-col gap-4" do %>
    <%= render "shared/auth_field", name: "email", type: "email", label: t("auth.correo"),
               placeholder: t("auth.correo_placeholder"), autocomplete: "email", autofocus: true %>

    <button type="submit"
            class="<%= button_classes(:primary, :lg, "mt-2 w-full") %>">
      <%= t("auth.forgot.enviar") %>
    </button>
  <% end %>

  <p class="text-center text-sm">
    <%= link_to t("auth.volver"), login_path, class: "font-medium text-primary hover:underline" %>
  </p>
</div>

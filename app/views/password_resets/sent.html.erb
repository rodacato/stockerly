<% content_for(:title, "#{t("auth.sent.titulo")} | Stockerly") %>
<%# State 2 — the confirmation. The copy is the same whether or not the address
    exists, which is deliberate (S11 #147) and is where this departs from the
    artboard: that one reads "te enviamos un enlace a tu@correo.com", and naming
    the address confirms it is registered to anyone who can reach this page.
    RequestPasswordReset does the silent no-op; this screen must not undo it. %>

<div class="flex flex-col items-center gap-5 text-center">
  <span class="flex size-14 items-center justify-center rounded-full bg-primary-bg text-primary">
    <span class="material-symbols-outlined text-3xl" aria-hidden="true">mark_email_read</span>
  </span>

  <div>
    <h1 class="font-display text-2xl font-bold tracking-tight text-fg-default"><%= t("auth.sent.titulo") %></h1>
    <p class="mt-2 text-base text-fg-subtle"><%= t("auth.sent.cuerpo") %></p>
    <p class="mt-2 text-sm text-fg-subtle"><%= t("auth.sent.spam") %></p>
  </div>

  <p class="flex items-center gap-2 rounded-xl border border-border-default bg-bg-muted px-4 py-2.5 text-xs text-fg-subtle">
    <span class="material-symbols-outlined text-base" aria-hidden="true">schedule</span>
    <%= t("auth.sent.expira", duration: duration_in_words_es(User::PASSWORD_RESET_EXPIRES_IN)) %>
  </p>

  <div class="flex flex-col gap-3">
    <%# "Reenviar" returns to the form rather than resending behind the scenes:
        a real resend needs the address, and holding it would leak the same fact
        the copy above is careful not to state. %>
    <%= link_to t("auth.sent.reenviar"), forgot_password_path, class: "text-sm font-medium text-primary hover:underline" %>
    <%= link_to t("auth.volver"), login_path, class: "text-sm font-medium text-primary hover:underline" %>
  </div>
</div>

<% content_for(:title, "#{t("auth.reset.titulo")} | Stockerly") %>
<%# State 3 — the reset form. The token comes from the URL and the controller
    resolves the user from it (S11 #147). %>

<div class="flex flex-col gap-6">
  <%= render "shared/auth_header", title: t("auth.reset.titulo"), subtitle: t("auth.reset.subtitulo") %>

  <% if @user&.errors&.any? %>
    <div class="rounded-xl border border-negative bg-negative-bg px-3 py-2.5 text-sm text-negative-fg" role="alert">
      <ul class="flex list-disc flex-col gap-0.5 pl-4">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: reset_password_path(token: params[:token]), method: :patch, class: "flex flex-col gap-4" do %>
    <%= render "shared/auth_field", name: "password", type: "password", label: t("auth.reset.nueva"),
               placeholder: t("auth.reset.nueva_placeholder"), autocomplete: "new-password", autofocus: true %>
    <%= render "shared/auth_field", name: "password_confirmation", type: "password",
               label: t("auth.reset.confirmar"), placeholder: t("auth.reset.confirmar_placeholder"),
               autocomplete: "new-password" %>

    <button type="submit"
            class="mt-2 w-full rounded-xl bg-primary px-4 py-3.5 text-base font-semibold text-fg-inverse transition-colors hover:bg-primary-hover">
      <%= t("auth.reset.guardar") %>
    </button>
  <% end %>

  <p class="text-center text-sm">
    <%= link_to t("auth.volver"), login_path, class: "font-medium text-primary hover:underline" %>
  </p>
</div>

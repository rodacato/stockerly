<%# Panorama (slice 3) — the daily cockpit. Mobile order: patrimonio, sentiment,
    movements, radar. Desktop reorders into three columns at native width, so
    the DOM stays in reading order and CSS does the rearranging. %>
<% content_for :page_title, t(".titulo") %>
<% content_for :page_subtitle, "#{l(Date.current, format: "%a · %d %b %Y").upcase} · CDMX" %>

<div class="flex flex-col gap-6 lg:grid lg:grid-cols-12 lg:items-start">
  <div class="lg:order-1 lg:col-span-12">
    <%= render "dashboard/patrimonio_strip", summary: @summary, currency: @currency, fx_unavailable: @fx_unavailable %>
  </div>

  <%# Sentiment carousel — a horizontal snap strip on a phone, a column on a
      desktop. No dots: they would need JS to follow the scroll, and a static
      row of dots that never moves is worse than the peeking next card. %>
  <% if @sentiment_cards.any? %>
    <section class="lg:order-4 lg:col-span-4" aria-label="<%= t(".carrusel") %>">
      <div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0 lg:pb-0">
        <% @sentiment_cards.each do |card| %>
          <%= render "dashboard/sentiment_card", card: card %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="lg:order-3 lg:col-span-4">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".movimientos_titulo") %></h2>
      <%= link_to market_path, class: "shrink-0 text-sm font-medium text-primary hover:underline" do %>
        <%= t(".ver_mas") %> <span aria-hidden="true">→</span>
      <% end %>
    </div>

    <% if @movements.any? %>
      <p class="mt-1 text-sm text-fg-subtle"><%= t(".movimientos_subtitulo") %></p>
      <div class="mt-3 flex flex-col gap-3">
        <% @movements.each do |observation| %>
          <%= render "dashboard/movement_row", observation: observation %>
        <% end %>
      </div>
    <% else %>
      <div class="mt-3 flex items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-5">
        <span class="material-symbols-outlined text-2xl text-fg-subtle" aria-hidden="true">local_cafe</span>
        <p class="text-sm text-fg-subtle"><%= t(".movimientos_vacio") %></p>
      </div>
    <% end %>
  </section>

  <section class="lg:order-2 lg:col-span-4">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".radar_titulo") %></h2>
      <%= link_to assets_path, class: "shrink-0 text-sm font-medium text-primary hover:underline" do %>
        <%= t(".ver_todos") %> <span aria-hidden="true">→</span>
      <% end %>
    </div>

    <% if @radar.any? %>
      <p class="mt-1 text-sm text-fg-subtle"><%= t(".radar_subtitulo", currency: @currency) %></p>
      <div class="mt-3 flex flex-col gap-3">
        <% @radar.each do |entry| %>
          <% if entry.kind == :position %>
            <%= render "components/asset_row",
                       position: entry.record,
                       declared_currency: @currency,
                       maturity_days: entry.maturity_days %>
          <% else %>
            <%= render "components/watch_row", item: entry.record %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="mt-3">
        <%= render "components/empty_state",
                   icon: "bedtime",
                   title: t(".radar_vacio"),
                   description: t("assets.index.vacio_cartera_cuerpo") %>
      </div>
    <% end %>
  </section>
</div>

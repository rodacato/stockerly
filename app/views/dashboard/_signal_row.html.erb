<%# Locals: observation (TechnicalObservation); optional context
    ADR-013: the verb is a lookup over this persisted row, the phrase that
    produced it stays visible, and a reading older than today says so — unless
    the screen already groups the rows by date and would say it twice.
    D127: the arrow draws the phrase's move, the colour its verb. %>
<% context = local_assigns.fetch(:context, :panorama) %>
<% asset = observation.asset %>
<% signal = observation_reading(observation) %>
<% action = signal&.action %>
<% rsi = observation.indicator_snapshot["rsi"] %>
<% stale = context != :senales && observation.observed_at.to_date < Date.current %>
<%= link_to market_asset_path(asset.symbol),
            class: "flex items-start gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-3.5 transition-colors hover:border-border-strong" do %>
  <%= icon_svg((signal&.move == :up ? "north_east" : "south_east"),
               class: "mt-0.5 shrink-0 text-lg #{action == :sell ? 'text-warning-fg' : 'text-positive-fg'}",
               "aria-hidden": "true") %>

  <div class="min-w-0 flex-1">
    <p class="font-mono text-sm font-bold text-fg-default"><%= asset.symbol %></p>
    <p class="text-xs text-fg-subtle">
      <%= observation_phrase(observation) %><%= " · RSI #{rsi.to_f.round}" if rsi %>
    </p>
    <% if stale %>
      <p class="mt-0.5 font-mono text-[11px] text-fg-subtle"><%= relative_age(observation.observed_at) %></p>
    <% end %>
  </div>

  <% if action %>
    <div class="flex shrink-0 flex-col items-end gap-1">
      <span class="rounded-full px-2.5 py-1 text-xs font-semibold
                   <%= action == :sell ? "bg-warning-bg text-warning-fg" : "bg-positive-bg text-positive-fg" %>">
        <%= t("comun.accion.#{action}") %>
      </span>
      <span class="font-mono text-[10px] uppercase tracking-wider text-fg-subtle"><%= t("comun.logica_senal.#{signal.logic}") %></span>
    </div>
  <% end %>
<% end %>

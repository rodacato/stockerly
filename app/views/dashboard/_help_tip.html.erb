<%# The inline ? of Hoy: a button and its popover, for the caller to place inside
    an element that carries `help_tip_data(figure)`. The copy is the catalogue at
    `dashboard.ayuda.<figure>`; opening one is counted (help_opens).
    Locals: figure; optional classes (placement of the button), inverse (on the brand surface). %>
<% title = t("dashboard.ayuda.#{figure}.titulo") %>
<button type="button" data-action="click->metric-tooltip#toggle"
        class="<%= local_assigns.fetch(:classes, "") %> flex size-9 shrink-0 cursor-help items-center justify-center rounded-lg transition-colors <%= local_assigns[:inverse] ? "text-fg-inverse hover:opacity-80 dark:text-fg-subtle dark:hover:text-primary" : "text-fg-subtle hover:text-primary" %>"
        aria-label="<%= t("dashboard.ayuda.explicar", titulo: title) %>">
  <%= icon_svg "info", class: "text-base", "aria-hidden": "true" %>
</button>

<div data-metric-tooltip-target="popover"
     class="absolute left-0 top-full z-20 mt-1 hidden w-full overflow-hidden rounded-xl border border-border-default bg-bg-surface shadow-xl">
  <div class="flex items-center justify-between gap-2 border-b border-border-default px-4 py-3">
    <h3 class="text-sm font-semibold text-fg-default"><%= title %></h3>
    <button type="button" data-action="click->metric-tooltip#close"
            class="flex size-9 shrink-0 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-fg-default"
            aria-label="<%= t("dashboard.ayuda.cerrar") %>">
      <%= icon_svg "close", class: "text-lg", "aria-hidden": "true" %>
    </button>
  </div>
  <div class="flex flex-col gap-2 p-4 text-sm leading-relaxed text-fg-default">
    <p><%= t("dashboard.ayuda.#{figure}.cuerpo") %></p>
    <% if figure == "veredicto" %>
      <p class="text-xs text-fg-subtle"><%= t("dashboard.ayuda.veredicto.pie") %></p>
    <% end %>
  </div>
  <% if velita_visible? %>
    <%= link_to velita_question_path(title),
                data: { turbo_frame: "assistant_sheet", turbo_action: "advance" },
                class: "flex items-center gap-3 bg-primary-muted px-4 py-3 transition-colors hover:bg-primary-muted/70" do %>
      <%= render "assistant/velita", classes: "size-9 shrink-0 text-primary" %>
      <span class="min-w-0 flex-1">
        <span class="block text-sm font-semibold text-primary-fg"><%= t("assistant.launcher.abrir") %></span>
        <span class="block text-xs text-fg-subtle"><%= t("assistant.launcher.con_la_frase") %></span>
      </span>
      <%= icon_svg "arrow_forward", class: "text-lg text-primary-fg", "aria-hidden": "true" %>
    <% end %>
  <% end %>
</div>

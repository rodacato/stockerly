<%# Hoy (realign A5, D155): the sentence first, then the figures, then at most
    three things of yours worth a look. The patrimonio strip is the figure it
    already was; the rest of the Panorama stays below. Locals: today, summary,
    vs_cetes, plan_status, stale_watched, currency, fx_unavailable, prices_unavailable. %>
<% state = today.state %>
<%# D163: the brand surface only where the sentence is a reading of fresh quotes.
    A stale or empty Hoy stays neutral, because a calm blue would vouch for
    what ADR-0023 says we cannot. %>
<% hero = %i[items calm].include?(state) %>
<section class="flex flex-col gap-6" aria-labelledby="hoy-veredicto">
  <%= tag.header class: class_names("relative flex items-start gap-2", "rounded-2xl bg-primary-fg p-5 dark:bg-primary-muted": hero),
                 data: help_tip_data("veredicto") do %>
    <div class="flex min-w-0 flex-1 flex-col gap-2">
      <p class="<%= class_names("font-mono text-[11px] uppercase tracking-widest", hero ? "text-fg-inverse dark:text-fg-subtle" : "text-fg-subtle") %>">
        <%= t(".fecha", date: l(Date.current, format: "%a · %d %b %Y").upcase) %>
      </p>
      <h2 id="hoy-veredicto"
          class="<%= class_names("font-display text-3xl font-bold leading-tight tracking-tight",
                                 "text-warning-fg": state == :stale,
                                 "text-fg-default": !hero && state != :stale,
                                 "text-fg-inverse dark:text-fg-default": hero) %>">
        <%= t(".veredicto.#{state}", count: today.total) %>
      </h2>
      <% subtitle = hoy_subtitle(state, vs_cetes, has_plan: plan_status.present?) %>
      <% if subtitle %>
        <p class="<%= hero ? "text-base text-fg-inverse dark:text-fg-subtle" : "text-base text-fg-subtle" %>"><%= subtitle %></p>
      <% end %>
    </div>
    <%= render "dashboard/help_tip", figure: "veredicto", classes: hero ? "-mr-2 -mt-1" : "mt-4", inverse: hero %>
  <% end %>

  <% if stale_watched.any? && state != :stale %>
    <p class="-mt-3 text-xs text-fg-subtle"><%= t(".vigilados_sin_cotizacion", symbols: stale_watched.first(3).join(", "), count: stale_watched.size) %></p>
  <% end %>

  <% if state == :first_run %>
    <%= render "components/empty_state", size: :inline, icon: "bedtime",
               title: t(".primera_vez_titulo"),
               cta_text: t("trades.new.titulo"), cta_path: new_trade_path %>
  <% else %>
    <div class="flex flex-col gap-3">
      <% if summary %>
        <%= tag.div class: "relative", data: help_tip_data("patrimonio") do %>
          <%= render "dashboard/patrimonio_strip", summary: summary, currency: currency, fx_unavailable: fx_unavailable %>
          <%= render "dashboard/help_tip", figure: "patrimonio", classes: "absolute right-1 top-1" %>
        <% end %>
      <% else %>
        <%= render "dashboard/patrimonio_strip", summary: summary, currency: currency, fx_unavailable: fx_unavailable %>
      <% end %>
      <% if vs_cetes && state != :stale %>
        <%= tag.div class: "relative flex items-center justify-between gap-4 rounded-2xl border border-border-default bg-bg-surface px-5 py-4", data: help_tip_data("vs_cetes") do %>
          <div class="min-w-0">
            <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle"><%= t(".vs_cetes_rotulo") %></p>
            <p class="mt-1 text-xs text-fg-subtle">
              <%= t(".vs_cetes_nota", term: vs_cetes[:term], date: l(vs_cetes[:as_of], format: :short)) %>
            </p>
          </div>
          <p class="shrink-0 font-display text-2xl font-bold tracking-tight text-fg-default">
            <%= signed_points(vs_cetes[:points]) %>
          </p>
          <%= render "dashboard/help_tip", figure: "vs_cetes", classes: "absolute right-1 top-1" %>
        <% end %>
      <% end %>
    </div>

    <% if today.items.any? %>
      <section class="flex flex-col gap-3" aria-labelledby="hoy-lo-tuyo">
        <div class="flex items-baseline justify-between gap-3">
          <h3 id="hoy-lo-tuyo" class="font-display text-lg font-bold tracking-tight text-fg-default"><%= t(".lo_tuyo") %></h3>
          <span class="font-mono text-xs text-fg-subtle"><%= t(".de", shown: today.items.size, total: today.total) %></span>
        </div>
        <% today.items.each do |item| %>
          <%= render "dashboard/hoy_item", item: item %>
        <% end %>
      </section>
    <% elsif state == :calm %>
      <%= render "components/empty_state", size: :inline, icon: "local_cafe", title: t(".calma") %>
    <% end %>

    <% if state != :stale %>
      <%= render "dashboard/hoy_plan", plan_status: plan_status %>
    <% end %>

    <a href="#radar" class="text-sm font-semibold text-primary-fg hover:underline">
      <%= t(".ver_radar") %> <span aria-hidden="true">→</span>
    </a>
  <% end %>
</section>

<%# One distinct failure as a card: class, message, where it came from, and how
    many times. The class gets the full width — it is what identifies the error,
    and sharing a line with the timestamp truncated exactly that. The backtrace
    lives on the detail screen. Locals: event %>
<li class="<%= card_classes %>">
  <%= link_to admin_error_path(event), class: "flex items-start gap-3 p-4" do %>
    <div class="min-w-0 flex-1">
      <p class="break-all font-mono font-semibold text-fg-default"><%= event.exception_class %></p>

      <p class="mt-0.5 line-clamp-2 text-sm text-fg-subtle"><%= event.message %></p>

      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="rounded bg-bg-muted px-2 py-0.5 font-mono text-xs text-fg-subtle">
          <%= admin_error_origin(event) %>
        </span>
        <% if event.occurrences > 1 %>
          <span class="rounded bg-bg-muted px-2 py-0.5 font-mono text-xs text-fg-subtle">
            <%= t("admin.errors.index.veces", count: event.occurrences) %>
          </span>
        <% end %>
        <span class="text-xs text-fg-subtle"><%= relative_age(event.last_seen_at) %></span>
      </div>
    </div>

    <%= icon_svg "chevron_right", class: "shrink-0 text-lg text-fg-subtle", "aria-hidden": "true" %>
  <% end %>
</li>

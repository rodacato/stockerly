<% content_for(:title, "#{t('.titulo')} | Stockerly") %>
<% content_for(:page_title, t(".titulo")) %>
<% content_for :header_bar do %>
  <%= render "components/header_bar", title: t(".titulo"), back_path: settings_path %>
<% end %>

<div class="mx-auto flex max-w-3xl flex-col gap-6">
  <p class="text-fg-subtle"><%= t(".descripcion") %></p>

  <% if @sources.any? %>
    <p class="font-mono text-xs uppercase tracking-widest text-fg-subtle">
      <%= t(".resumen",
            count: @sources.size,
            near: @sources.count { |s| s.state == :connected && s.quota.near_limit? },
            blocked: t(".bloqueadas", count: @sources.count { |s| s.state == :blocked })) %>
    </p>

    <ul class="flex flex-col gap-3">
      <% @sources.each do |entry| %>
        <%= render "provider_card", entry: entry, integration: @integrations[entry.provider] %>
      <% end %>
    </ul>

    <p class="flex items-start gap-2 rounded-xl bg-bg-muted px-4 py-3 text-sm text-fg-subtle">
      <%= icon_svg "info", class: "text-lg", "aria-hidden": "true" %>
      <%= t(".api_key_nota") %>
    </p>
  <% else %>
    <div class="<%= card_classes("flex flex-col items-center gap-3 border-dashed px-6 py-10 text-center") %>">
      <%= icon_svg "hub", class: "text-3xl text-fg-subtle", "aria-hidden": "true" %>
      <p class="font-semibold text-fg-default"><%= t(".vacio_titulo") %></p>
      <p class="max-w-sm text-sm text-fg-subtle"><%= t(".vacio_cuerpo_html") %></p>
    </div>
  <% end %>
</div>

<% content_for(:title, "#{t('.titulo')} | Stockerly") %>
<% content_for(:page_title, t(".titulo")) %>

<div class="mx-auto flex max-w-3xl flex-col gap-6">
  <p class="text-fg-subtle"><%= t(".descripcion") %></p>

  <% if @sources.any? %>
    <p class="font-mono text-xs uppercase tracking-widest text-fg-subtle">
      <%= t(".resumen",
            count: @sources.size,
            near: @sources.count { |s| s.state == :connected && s.quota.near_limit? },
            blocked: @sources.count { |s| s.state == :blocked }) %>
    </p>

    <ul class="flex flex-col gap-3">
      <% @sources.each do |entry| %>
        <%= render "provider_card", entry: entry, integration: @integrations[entry.provider] %>
      <% end %>
    </ul>

    <p class="flex items-start gap-2 rounded-xl bg-bg-muted px-4 py-3 text-sm text-fg-subtle">
      <span class="material-symbols-outlined text-lg" aria-hidden="true">info</span>
      <%= t(".llave_nota") %>
    </p>
  <% else %>
    <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-border-default bg-bg-surface px-6 py-10 text-center">
      <span class="material-symbols-outlined text-3xl text-fg-subtle" aria-hidden="true">hub</span>
      <p class="font-semibold text-fg-default"><%= t(".vacio_titulo") %></p>
      <p class="max-w-sm text-sm text-fg-subtle"><%= t(".vacio_cuerpo") %></p>
      <%= link_to t(".configurar"), onboarding_integrations_path,
            class: "rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-fg-inverse transition-colors hover:bg-primary-hover" %>
    </div>
  <% end %>
</div>

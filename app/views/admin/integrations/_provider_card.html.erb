<%# One source per `ajustes-integraciones`: what it brings, in what role, how
    much of its own quota is left, and — when it is not working — whose problem
    that is. Locals: entry (SourceCatalogue::Entry), integration %>
<%
  style  = source_state_style(entry.state)
  reason = source_state_reason(entry.state)
%>
<li data-controller="reveal" class="<%= card_classes("flex flex-col gap-3 p-4") %>">
  <div class="flex items-start gap-3">
    <span class="mt-1.5 size-2 shrink-0 rounded-full <%= style[:dot] %>" aria-hidden="true"></span>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <p class="font-semibold text-fg-default"><%= entry.provider %></p>
        <span class="rounded-full bg-bg-muted px-2 py-0.5 text-[10px] font-semibold text-fg-subtle">
          <%= source_role_label(entry.role) %>
        </span>
      </div>
      <p class="text-sm text-fg-subtle"><%= entry.description || capabilities_label(entry.capabilities) %></p>
    </div>
    <span class="shrink-0 font-mono text-xs uppercase <%= style[:fg] %>"><%= source_state_label(entry.state) %></span>
    <%# The artboard puts a chevron here, to a per-source detail screen that
        does not exist. Rather than draw a dead affordance, it opens in place. %>
    <button type="button" data-action="reveal#toggle"
            aria-label="<%= t("admin.integrations.index.administrar") %>"
            class="flex size-8 shrink-0 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-fg-default">
      <span class="material-symbols-outlined text-lg" aria-hidden="true">expand_more</span>
    </button>
  </div>

  <div class="flex flex-col gap-1.5">
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-mono text-sm <%= entry.quota.known? ? "text-fg-default" : "text-fg-subtle" %>">
        <%= source_quota_label(entry.quota) %>
      </span>
      <span class="font-mono text-xs text-fg-subtle"><%= relative_age(integration.last_sync_at, blank: "nunca") %></span>
    </div>
    <%# No track where there is no reading: an empty bar reads as 0% used,
        which is a number we do not have. %>
    <% if entry.quota.known? %>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-bg-muted">
        <div class="h-full rounded-full <%= source_bar_classes(entry) %>"
             style="width: <%= (entry.quota.ratio * 100).round %>%"></div>
      </div>
    <% end %>
  </div>

  <% if reason %>
    <p class="flex items-start gap-2 rounded-lg <%= reason[:bg] %> px-3 py-2 text-sm <%= reason[:fg] %>">
      <span class="material-symbols-outlined text-base" aria-hidden="true"><%= reason[:icon] %></span>
      <span>
        <%= t("admin.integrations.index.#{reason[:key]}") %>
        <%# What the reader is losing right now, in this source's own terms. %>
        <% if entry.state == :no_key && (info = MarketData::Domain::ProviderDirectory.for(entry.provider))&.without %>
          <%= info.without %>
        <% end %>
      </span>
    </p>
  <% end %>

  <% if entry.maintainer_only %>
    <p class="flex items-start gap-2 rounded-lg bg-warning-bg px-3 py-2 text-sm text-warning-fg">
      <span class="material-symbols-outlined text-base" aria-hidden="true">lock_clock</span>
      <%= t("admin.integrations.index.solo_maintainer") %>
    </p>
  <% end %>

  <div data-reveal-target="content" class="hidden flex-col gap-3 border-t border-border-default pt-3">
    <div class="flex flex-wrap items-center gap-2">
      <%= button_to t("admin.integrations.index.verificar"), refresh_sync_admin_integration_path(integration), method: :post,
            form_class: "inline-flex",
            class: "rounded-lg bg-primary-muted px-3 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-fg-inverse" %>
      <%= form_with url: admin_integration_path(integration), method: :patch, class: "flex flex-wrap items-end gap-2" do |f| %>
        <%= f.password_field :api_key_encrypted, name: "integration[api_key_encrypted]", value: nil,
              placeholder: integration_key_placeholder(integration),
              autocomplete: "off",
              class: "min-w-[160px] flex-1 rounded-lg border border-border-default bg-bg-canvas px-3 py-2 font-mono text-sm text-fg-default placeholder:font-sans placeholder:text-fg-subtle focus:outline-none focus:ring-2 focus:ring-focus" %>
        <label class="flex flex-col gap-1">
          <span class="text-[11px] uppercase tracking-wide text-fg-subtle"><%= t("admin.integrations.index.limite_diario") %></span>
          <%= f.number_field :daily_call_limit, name: "integration[daily_call_limit]", value: integration.daily_call_limit,
                placeholder: t("admin.integrations.index.sin_limite"),
                class: "w-24 rounded-lg border border-border-default bg-bg-canvas px-2 py-2 font-mono text-sm text-fg-default focus:outline-none focus:ring-2 focus:ring-focus" %>
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-[11px] uppercase tracking-wide text-fg-subtle"><%= t("admin.integrations.index.limite_minuto") %></span>
          <%= f.number_field :max_requests_per_minute, name: "integration[max_requests_per_minute]", value: integration.max_requests_per_minute,
                placeholder: t("admin.integrations.index.sin_limite"),
                class: "w-24 rounded-lg border border-border-default bg-bg-canvas px-2 py-2 font-mono text-sm text-fg-default focus:outline-none focus:ring-2 focus:ring-focus" %>
        </label>
        <%= f.submit t("admin.integrations.index.guardar"),
              class: "cursor-pointer rounded-lg border border-border-default px-3 py-2 text-sm font-medium text-fg-default" %>
      <% end %>
      <%= button_to admin_integration_path(integration), method: :delete,
            form: { class: "inline-flex", data: { turbo_confirm: t("admin.integrations.index.confirmar_fuente", provider: entry.provider) } },
            class: "flex size-10 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-negative",
            aria: { label: t("admin.integrations.index.eliminar_fuente") } do %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">delete</span>
      <% end %>
    </div>
  </div>
</li>

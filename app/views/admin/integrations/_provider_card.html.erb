<%# One source, per `ajustes-integraciones`: a state dot, what it brings, and
    how much of its free limit is spent. It was a three-zone grid that only
    resolved on a wide screen. Locals: integration %>
<%
  state = integration_pill_state(integration)
  pill  = integration_pill_meta(state)
  used, limit, window = integration_usage(integration)
  keys  = integration.api_key_configured? ? 1 : 0
%>
<li data-controller="reveal" class="flex flex-col gap-3 rounded-xl border border-border-default bg-bg-surface p-4">
  <div class="flex items-start gap-3">
    <span class="mt-1.5 size-2 shrink-0 rounded-full <%= pill[:dot] || 'bg-fg-subtle' %>"
          title="<%= pill[:label] %>" aria-hidden="true"></span>
    <div class="min-w-0 flex-1">
      <p class="font-semibold text-fg-default"><%= integration.provider_name %></p>
      <p class="text-sm text-fg-subtle"><%= integration_capabilities_label(integration) %></p>
    </div>
    <span class="shrink-0 font-mono text-xs uppercase <%= pill[:fg] %>"><%= pill[:label] %></span>
    <%# The artboard puts a chevron here, to a per-source detail screen that
        does not exist. Rather than draw a dead affordance, it opens in place. %>
    <button type="button" data-action="reveal#toggle"
            aria-label="<%= t("admin.integrations.index.administrar") %>"
            class="flex size-8 shrink-0 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-fg-default">
      <span class="material-symbols-outlined text-lg" aria-hidden="true">expand_more</span>
    </button>
  </div>

  <% if used && limit.to_i.positive? %>
    <div class="flex flex-col gap-1.5">
      <div class="flex items-baseline justify-between gap-3">
        <span class="font-mono text-sm text-fg-default">
          <%= t("admin.integrations.index.uso", used: number_with_delimiter(used), limit: number_with_delimiter(limit), window: t("admin.integrations.index.#{window}")) %>
        </span>
        <span class="font-mono text-xs text-fg-subtle">
          <%= t("admin.integrations.index.llaves", count: keys) %> · <%= integration_last_check_label(integration) %>
        </span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-bg-muted">
        <div class="h-full rounded-full <%= integration_usage_bar_classes(used, limit) %>"
             style="width: <%= [ (used.to_f / limit * 100).round, 100 ].min %>%"></div>
      </div>
    </div>
  <% else %>
    <p class="font-mono text-xs text-fg-subtle">
      <%= t("admin.integrations.index.llaves", count: keys) %> · <%= integration_last_check_label(integration) %>
    </p>
  <% end %>

  <div data-reveal-target="content" class="hidden flex-col gap-3 border-t border-border-default pt-3">
    <% if state == :error %>
      <p class="rounded-lg bg-negative-bg px-3 py-2 text-sm text-negative-fg"><%= t("admin.integrations.index.sin_respuesta") %></p>
    <% elsif state == :paused && integration.requires_api_key? && !integration.api_key_configured? %>
      <p class="rounded-lg bg-warning/10 px-3 py-2 text-sm text-warning"><%= t("admin.integrations.index.sin_llave") %></p>
    <% end %>

    <div class="flex flex-wrap items-center gap-2">
      <%= button_to t("admin.integrations.index.verificar"), refresh_sync_admin_integration_path(integration), method: :post,
            form_class: "inline-flex",
            class: "rounded-lg bg-primary/10 px-3 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary/15" %>
      <%= form_with url: admin_integration_path(integration), method: :patch, class: "flex flex-wrap items-end gap-2" do |f| %>
        <%= f.password_field :api_key_encrypted, name: "integration[api_key_encrypted]", value: nil,
              placeholder: integration_key_placeholder(integration),
              autocomplete: "off",
              class: "min-w-[160px] flex-1 rounded-lg border border-border-default bg-bg-canvas px-3 py-2 font-mono text-sm text-fg-default placeholder:font-sans placeholder:text-fg-subtle focus:outline-none focus:ring-2 focus:ring-primary/20" %>
        <label class="flex flex-col gap-1">
          <span class="text-[11px] uppercase tracking-wide text-fg-subtle"><%= t("admin.integrations.index.limite_diario") %></span>
          <%= f.number_field :daily_call_limit, name: "integration[daily_call_limit]", value: integration.daily_call_limit,
                placeholder: t("admin.integrations.index.sin_limite"),
                class: "w-24 rounded-lg border border-border-default bg-bg-canvas px-2 py-2 font-mono text-sm text-fg-default focus:outline-none focus:ring-2 focus:ring-primary/20" %>
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-[11px] uppercase tracking-wide text-fg-subtle"><%= t("admin.integrations.index.limite_minuto") %></span>
          <%= f.number_field :max_requests_per_minute, name: "integration[max_requests_per_minute]", value: integration.max_requests_per_minute,
                placeholder: t("admin.integrations.index.sin_limite"),
                class: "w-24 rounded-lg border border-border-default bg-bg-canvas px-2 py-2 font-mono text-sm text-fg-default focus:outline-none focus:ring-2 focus:ring-primary/20" %>
        </label>
        <%= f.submit t("admin.integrations.index.guardar"),
              class: "cursor-pointer rounded-lg border border-border-default px-3 py-2 text-sm font-medium text-fg-default" %>
      <% end %>
      <%= button_to admin_integration_path(integration), method: :delete,
            form: { class: "inline-flex", data: { turbo_confirm: t("admin.integrations.index.confirmar_fuente", provider: integration.provider_name) } },
            class: "flex size-10 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-negative",
            aria: { label: t("admin.integrations.index.eliminar_fuente") } do %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">delete</span>
      <% end %>
    </div>
  </div>
</li>

<%# One flip of an instance switch, per `ajustes-estado`. Locals: change %>
<li class="flex items-start gap-3">
  <span class="material-symbols-outlined mt-0.5 text-lg text-fg-subtle" aria-hidden="true">history</span>
  <div class="min-w-0 flex-1">
    <p class="text-sm text-fg-subtle">
      <%= setting_audit_key(change.key) %> ·
      <%= setting_audit_value(change.old_value) %> → <%= setting_audit_value(change.new_value) %>
    </p>
  </div>
  <span class="shrink-0 font-mono text-xs text-fg-subtle"><%= absolute_stamp(change.created_at) %></span>
</li>

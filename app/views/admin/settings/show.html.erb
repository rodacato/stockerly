<% content_for(:title, "#{t('.titulo')} | Stockerly") %>
<% content_for(:page_title, t(".titulo")) %>
<% content_for :header_bar do %>
  <%= render "components/header_bar", title: t(".titulo"), back_path: settings_path %>
<% end %>

<div class="mx-auto flex max-w-3xl flex-col gap-8">
  <%# `ajustes-estado` puts the diagnosis first: what the instance is, before
      what you can change about it. %>
  <section class="flex flex-col gap-3">
    <h2 class="font-display text-2xl font-bold text-fg-default"><%= t(".diagnostico") %></h2>
    <dl class="divide-y divide-border-default rounded-xl border border-border-default bg-bg-surface px-4">
      <% [ [ t(".version"),     @diagnostics[:version] ],
           [ "Ruby",            @diagnostics[:ruby] ],
           [ "Rails",           @diagnostics[:rails] ],
           [ t(".entorno"),     @diagnostics[:environment] ],
           [ t(".trabajos"),    @diagnostics[:solid_queue] ],
           [ t(".cache"),       @diagnostics[:cache_entries] ? t(".entradas", count: number_with_delimiter(@diagnostics[:cache_entries])) : "—" ],
           [ t(".errores"),     @diagnostics[:errors_last_24h] ],
           [ t(".descubrir"),   t(".descubrir_semanas", count: @diagnostics[:discover_weeks],
                                  window: @diagnostics[:discover_window]) ] ].each do |label, value| %>
        <div class="flex items-baseline justify-between gap-4 py-3">
          <dt class="text-fg-subtle"><%= label %></dt>
          <dd class="text-right font-mono text-sm text-fg-default"><%= value %></dd>
        </div>
      <% end %>
    </dl>
    <% if @developer_mode %>
      <%= link_to t(".abrir_errores"), admin_errors_path,
            class: "inline-flex items-center gap-1.5 self-start text-sm font-semibold text-primary hover:underline" %>
    <% end %>
    <%= link_to "/admin/jobs", target: "_blank", rel: "noopener",
          class: "inline-flex items-center gap-1.5 self-start text-sm font-semibold text-primary hover:underline" do %>
      <%= t(".abrir_jobs") %>
      <span class="material-symbols-outlined text-sm" aria-hidden="true">open_in_new</span>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-display text-2xl font-bold text-fg-default"><%= t(".interruptores") %></h2>

    <%# No Guardar button: the artboard has none, and the controller already
        accepts a partial payload, so each switch is its own PATCH. The audit
        trail is unchanged — SiteConfigChange still records every flip. %>
    <div class="divide-y divide-border-default rounded-xl border border-border-default bg-bg-surface px-4">
      <% [ [ "auto_sync_enabled", t(".sync"), t(".sync_desc"), @auto_sync_enabled ],
           [ "email_notifications_enabled", t(".correo"), t(".correo_desc"), @email_notifications_enabled ],
           [ "maintenance_mode", t(".mantenimiento"), t(".mantenimiento_desc"), @maintenance_mode ],
           [ "developer_mode", t(".desarrollador"), t(".desarrollador_desc"), @developer_mode ] ].each do |key, label, description, on| %>
        <div class="flex items-center gap-4 py-4">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-fg-default"><%= label %></p>
            <p class="text-sm text-fg-subtle"><%= description %></p>
          </div>
          <%= button_to admin_settings_path, method: :patch, params: { key => on ? "0" : "1" },
                form_class: "shrink-0",
                aria: { label: label },
                class: "relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full transition-colors #{on ? 'bg-primary' : 'bg-bg-muted'}" do %>
            <span class="inline-block size-5 rounded-full bg-white shadow transition-transform <%= on ? 'translate-x-5' : 'translate-x-0.5' %>" aria-hidden="true"></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @maintenance_mode %>
      <p class="flex items-start gap-2 rounded-xl bg-warning/10 px-4 py-3 text-sm text-warning" role="status">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">campaign</span>
        <%= t(".banner_activo") %>
      </p>
    <% end %>
  </section>

  <%# The manual triggers the deleted admin dashboard carried. `ajustes-estado`
      does not draw them, but losing them leaves a failed source with no way
      back before its next scheduled run. %>
  <section class="flex flex-col gap-3">
    <h2 class="font-display text-2xl font-bold text-fg-default"><%= t(".manual") %></h2>
    <p class="text-sm text-fg-subtle"><%= t(".manual_desc") %></p>
    <div class="flex flex-wrap gap-2">
      <% @data_sources.each do |source| %>
        <%= button_to admin_trigger_data_source_path(key: source.key), method: :post,
              form_class: "inline-flex",
              class: "inline-flex items-center gap-1.5 rounded-lg border border-border-default bg-bg-surface px-3 py-2 text-sm font-medium text-fg-default transition-colors hover:border-primary hover:text-primary" do %>
          <span class="material-symbols-outlined text-base" aria-hidden="true"><%= source.icon %></span>
          <%# The full registry name, not its first half: two sources are both
              "US Stocks" and only the provider after the dash tells them apart. %>
          <%= source.name %>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-display text-2xl font-bold text-fg-default"><%= t(".cambios") %></h2>
    <% if @recent_changes.any? %>
      <ul class="flex flex-col gap-2">
        <% @recent_changes.each do |change| %>
          <%= render "audit_entry", change: change %>
        <% end %>
      </ul>
      <%= link_to t(".ver_todos"), admin_logs_path(module_name: "admin"),
            class: "self-start text-sm font-semibold text-primary hover:underline" %>
    <% else %>
      <p class="rounded-xl border border-border-default bg-bg-surface p-4 text-sm text-fg-subtle"><%= t(".sin_cambios") %></p>
    <% end %>
  </section>
</div>

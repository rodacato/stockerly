<%# Cards, per `ajustes-registros`. It was a six-column table with a header
    row — the same shape Reglas had, and it overflowed a phone the same way.
    Locals: logs, pagy %>
<div class="flex flex-col gap-4">
  <ul class="flex flex-col gap-3">
    <% logs.each do |log| %>
      <%= render "admin/logs/log_row", log: log %>
    <% end %>
  </ul>

  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs text-fg-subtle">
      <%= t("admin.logs.index.mostrando", shown: logs.length, total: number_with_delimiter(pagy.count)) %>
    </p>
    <% if pagy.pages > 1 %>
      <div class="text-sm"><%== pagy.series_nav %></div>
    <% end %>
  </div>
</div>

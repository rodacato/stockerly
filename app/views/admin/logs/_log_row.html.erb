<%# One entry as a card, per `ajustes-registros`: severity dot, task, message,
    timestamp. The payload panel the artboard does not draw stays behind the
    card — an error you cannot open is a log entry that tells you nothing.
    Locals: log %>
<%
  payload = admin_log_payload(log)
  has_details = log.error_message.present?
  message = admin_log_message(log)
  log_id = log.log_uid.presence || "log_#{log.id}"
%>
<li data-controller="reveal" class="rounded-xl border border-border-default bg-bg-surface p-4">
  <div class="flex items-start gap-3">
    <span class="mt-1.5 size-2 shrink-0 rounded-full <%= admin_log_severity_dot_classes(log.severity) %>"
          title="<%= log.severity.to_s.capitalize %>" aria-hidden="true"></span>

    <div class="min-w-0 flex-1">
      <div class="flex items-baseline justify-between gap-3">
        <p class="truncate font-mono font-semibold text-fg-default"><%= log.task_name %></p>
        <span class="shrink-0 font-mono text-xs text-fg-subtle"><%= admin_log_timestamp(log) %></span>
      </div>
      <p class="text-sm text-fg-subtle"><%= message %></p>
      <% if log.module_name.present? %>
        <span class="mt-1 inline-block rounded bg-bg-muted px-2 py-0.5 font-mono text-xs text-fg-subtle"><%= log.module_name %></span>
      <% end %>
    </div>

    <% if has_details %>
      <button type="button" data-action="reveal#toggle"
              aria-label="<%= t("admin.logs.index.ver_detalle") %>"
              class="flex size-8 shrink-0 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-fg-default">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">expand_more</span>
      </button>
    <% end %>
  </div>

  <% if has_details %>
    <div data-reveal-target="content" class="mt-4 hidden flex-col gap-3 border-t border-border-default pt-4">
      <div class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs">
        <span><span class="text-fg-subtle">ID · </span><span class="text-fg-default"><%= log_id %></span></span>
        <span>
          <span class="text-fg-subtle">Severidad · </span>
          <span class="font-semibold uppercase <%= admin_log_severity_text_classes(log.severity) %>"><%= log.severity %></span>
        </span>
        <% if log.duration_seconds.present? %>
          <span><span class="text-fg-subtle">Duración · </span><span class="text-fg-default"><%= log.duration_seconds %> s</span></span>
        <% end %>
      </div>

      <div class="overflow-hidden rounded-lg bg-bg-muted">
        <p class="px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-fg-subtle"><%= t("admin.logs.index.carga_util") %></p>
        <pre class="overflow-x-auto px-3 py-2 font-mono text-xs text-fg-default"><%= JSON.pretty_generate(payload) %></pre>
      </div>

      <%# The column is named error_message and every job writes its outcome
          there, success included. Painting it red by name reported a healthy
          sync as a failure. %>
      <% tone = log.success? ? { bg: "bg-bg-muted", fg: "text-fg-subtle", body: "text-fg-default", label: "detalle" }
                             : { bg: "bg-negative-bg", fg: "text-negative-fg", body: "text-negative-fg", label: "detalle_error" } %>
      <div class="overflow-hidden rounded-lg <%= tone[:bg] %>">
        <p class="px-3 py-1.5 font-mono text-xs uppercase tracking-widest <%= tone[:fg] %>"><%= t("admin.logs.index.#{tone[:label]}") %></p>
        <pre class="overflow-x-auto whitespace-pre-wrap break-all px-3 py-2 font-mono text-xs <%= tone[:body] %>"><%= log.error_message %></pre>
      </div>
    </div>
  <% end %>
</li>

<%# One entry as a card, per `ajustes-registros`: severity dot, task, message,
    module and timestamp. The task gets the full width, as on `_error_row`. Its
    id, severity and duration open behind the card. Locals: log %>
<%
  has_details = log.error_message.present?
  message = admin_log_message(log)
  log_id = log.log_uid.presence || "log_#{log.id}"
%>
<li data-controller="reveal" class="<%= card_classes("p-4") %>">
  <div class="flex items-start gap-3">
    <span class="mt-1.5 size-2 shrink-0 rounded-full <%= admin_log_severity_dot_classes(log.severity) %>"
          title="<%= log.severity.to_s.capitalize %>" aria-hidden="true"></span>

    <div class="min-w-0 flex-1">
      <p class="break-all font-mono font-semibold text-fg-default"><%= log.task_name %></p>
      <p class="text-sm text-fg-subtle"><%= message %></p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <% if log.module_name.present? %>
          <span class="rounded bg-bg-muted px-2 py-0.5 font-mono text-xs text-fg-subtle"><%= log.module_name %></span>
        <% end %>
        <span class="font-mono text-xs text-fg-subtle"><%= absolute_stamp(log.created_at, seconds: true) %></span>
      </div>
    </div>

    <% if has_details %>
      <button type="button" data-action="reveal#toggle"
              aria-label="<%= t("admin.logs.index.ver_detalle") %>"
              class="flex size-8 shrink-0 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-fg-default">
        <%= icon_svg "expand_more", class: "text-lg", "aria-hidden": "true" %>
      </button>
    <% end %>
  </div>

  <% if has_details %>
    <div data-reveal-target="content" class="mt-4 hidden flex-col gap-3 border-t border-border-default pt-4">
      <div class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs">
        <span><span class="text-fg-subtle"><%= t("admin.logs.index.id") %> · </span><span class="text-fg-default"><%= log_id %></span></span>
        <span>
          <span class="text-fg-subtle"><%= t("admin.logs.index.severidad") %> · </span>
          <span class="font-semibold uppercase <%= admin_log_severity_text_classes(log.severity) %>"><%= log.severity %></span>
        </span>
        <% if log.duration_seconds.present? %>
          <span><span class="text-fg-subtle"><%= t("admin.logs.index.duracion") %> · </span><span class="text-fg-default"><%= log.duration_seconds %> s</span></span>
        <% end %>
      </div>
    </div>
  <% end %>
</li>

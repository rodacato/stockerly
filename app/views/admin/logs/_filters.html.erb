<%# The artboard draws three severity chips and nothing else. Search, module
    and range stay: a 90-day log you cannot search is a wall of text, and D8's
    grounding caveat is what the artboard is drawn against. They wear the new
    vocabulary rather than the old filter bar. %>
<%= form_with(url: admin_logs_path, method: :get, data: { turbo_action: "replace" },
      class: "flex flex-col gap-3") do |f| %>

  <div class="<%= card_classes("flex items-center gap-2 px-4 py-3") %>">
    <%= icon_svg "search", class: "text-lg text-fg-subtle", "aria-hidden": "true" %>
    <%= f.text_field :search, value: params[:search],
        placeholder: t("admin.logs.index.buscar"),
        autocomplete: "off",
        class: "w-full bg-transparent text-sm text-fg-default placeholder:text-fg-subtle outline-none" %>
  </div>

  <%# Severity is a link-based control, so it rides along when search submits. %>
  <%= hidden_field_tag :severity, params[:severity] if params[:severity].present? %>

  <%= render "components/segmented", variant: :chips,
        label: t("admin.logs.index.severidad"),
        options: admin_log_severity_options.map { |slug, label, value|
          [ label,
            admin_logs_path(search: params[:search], module_name: params[:module_name],
                            range: params[:range], severity: value),
            (params[:severity].presence || "todos") == slug ]
        } %>

  <div class="flex flex-wrap items-center gap-2">
    <% [ [ :module_name, admin_log_module_options.map { |_s, label, value| [ "#{t('admin.logs.index.modulo')}: #{label}", value.to_s ] }, params[:module_name].to_s ],
         [ :range, admin_log_range_options.map { |_s, label, value| [ "#{t('admin.logs.index.rango')}: #{label}", value ] }, (params[:range].presence || Admin::LogsHelper::DEFAULT_RANGE) ] ].each do |field, options, selected| %>
      <%= f.select field, options_for_select(options, selected), {},
            onchange: "this.form.requestSubmit()",
            class: field_classes(:md) %>
    <% end %>

    <% if admin_logs_any_filter_active? %>
      <%= link_to t("admin.logs.index.limpiar"), admin_logs_path,
            class: "ml-auto text-sm font-medium text-fg-subtle transition-colors hover:text-fg-default" %>
    <% end %>
  </div>
<% end %>

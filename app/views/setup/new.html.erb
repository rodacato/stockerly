<% content_for(:title, "#{t('setup.new.titulo')} | Stockerly") %>

<div class="flex flex-col gap-6">
  <%= render "shared/auth_header", title: t("setup.new.titulo"), subtitle: t("setup.new.subtitulo") %>

  <% if @errors.present? %>
    <div class="rounded-xl border border-negative bg-negative-bg px-3 py-2.5 text-sm text-negative-fg" role="alert">
      <p class="flex items-center gap-2 font-medium">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">error</span>
        <%= t("setup.new.corrige") %>
      </p>
      <ul class="mt-1 list-disc space-y-0.5 pl-9">
        <% @errors.each do |field, messages| %>
          <% Array(messages).each do |message| %>
            <li><%= field.to_s.humanize %> <%= message %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: setup_path, method: :post, class: "flex flex-col gap-4" do %>
    <%= render "shared/auth_field", name: "full_name", type: "text", label: t("setup.new.nombre"),
               placeholder: t("setup.new.nombre_placeholder"), autocomplete: "name", autofocus: true %>
    <%= render "shared/auth_field", name: "email", type: "email", label: t("auth.correo"),
               placeholder: t("auth.correo_placeholder"), autocomplete: "email" %>
    <%= render "shared/auth_field", name: "password", type: "password", label: t("auth.contrasena"),
               placeholder: t("auth.reset.nueva_placeholder"), autocomplete: "new-password" %>
    <%= render "shared/auth_field", name: "password_confirmation", type: "password",
               label: t("auth.reset.confirmar"), placeholder: t("auth.reset.confirmar_placeholder"),
               autocomplete: "new-password" %>

    <button type="submit"
            class="mt-2 w-full rounded-xl bg-primary px-4 py-3.5 text-base font-semibold text-fg-inverse transition-colors hover:bg-primary-hover">
      <%= t("setup.new.submit") %>
    </button>
  <% end %>

  <p class="text-center font-mono text-xs text-fg-subtle"><%= t("auth.open_source") %></p>
</div>

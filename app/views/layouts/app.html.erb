<% content_for(:body) do %>
  <%= turbo_stream_from "notifications_#{current_user.id}" if current_user %>
  <div data-controller="progress-bar" class="flex min-h-screen bg-bg-canvas">
    <div data-progress-bar-target="bar" class="progress-bar fixed left-0 top-0 z-60 h-0.75 w-0 bg-primary opacity-0"></div>

    <%= render "components/sidebar_nav" %>

    <div class="flex min-w-0 flex-1 flex-col">
      <%= render "components/top_bar" %>
      <%= render "components/top_bar_desktop" %>

      <div id="flash_messages" class="fixed right-4 top-20 z-50 flex max-w-sm flex-col gap-3" style="pointer-events: none;">
        <%= render "shared/flash" %>
      </div>

      <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
        <%= yield %>
      </main>

      <%= render "components/bottom_nav" %>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>

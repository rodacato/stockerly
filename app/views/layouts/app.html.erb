<% content_for(:body) do %>
  <%= turbo_stream_from "notifications_#{current_user.id}" if current_user %>
  <div data-controller="progress-bar" class="flex min-h-screen bg-bg-canvas">
    <div data-progress-bar-target="bar" class="progress-bar fixed left-0 top-0 z-60 h-0.75 w-0 bg-primary opacity-0"></div>

    <%= render "components/sidebar_nav" %>

    <div class="flex min-w-0 flex-1 flex-col">
      <%# Screens behind the hub swap the logo+bell bar for a HeaderBar that
          gives them a way back. The artboards draw one or the other. %>
      <%= content_for?(:header_bar) ? content_for(:header_bar) : render("components/top_bar") %>
      <%= render "components/top_bar_desktop" %>

      <div id="flash_messages" class="fixed right-4 top-20 z-50 flex max-w-sm flex-col gap-3" style="pointer-events: none;">
        <%= render "shared/flash" %>
      </div>

      <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
        <%# The mobile bar carries no title, so the page needs an h1 from
            somewhere. A screen whose artboard heads it with its own name sets
            :own_heading and renders that h1 itself; the rest get this one, and
            two h1s on one page stays the defect it was. %>
        <% unless content_for?(:own_heading) || content_for?(:header_bar) %>
          <h1 class="sr-only lg:hidden">
            <%= content_for(:page_title) || t("nav.#{main_nav_items.find { |i| i[:active] }&.dig(:key) || "panorama"}") %>
          </h1>
        <% end %>
        <%= yield %>
      </main>

      <%= render "components/bottom_nav" %>
      <%= render "shared/pwa_update" %>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>

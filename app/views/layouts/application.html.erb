<!DOCTYPE html>
<html lang="es-MX" data-theme="lumen" class="<%= content_for(:html_class) %>">
  <head>
    <% page_title       = content_for(:title)       || t("brand.title") %>
    <% page_description = content_for(:description) || t("brand.description") %>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Stockerly">
    <meta name="theme-color" content="#5B6CFF">

    <%# Open Graph / Social Sharing %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Stockerly">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:image" content="<%= "#{request.base_url}/og-image.png?v=3" %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Stockerly">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= "#{request.base_url}/og-image.png?v=3" %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# Cache-bust query param: bump when /favicon.svg, /apple-touch-icon.png,
        or /manifest.json content changes. PWA-spec URLs must stay stable
        (browsers/iOS expect them at well-known paths), so we ride the query
        string to invalidate Cloudflare's edge cache on brand updates. %>
    <link rel="manifest" href="/manifest.json?v=3">
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png?v=3" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500..800&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400..700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# Early-paint theme apply — reads the same localStorage key the
        theme Stimulus controller writes (/profile preference card,
        S11 #146). Runs before <body> renders so reloads don't FOUC. %>
    <script nonce="<%= request.content_security_policy_nonce %>">
      (function () {
        try {
          var stored = localStorage.getItem("stockerly.theme") || "system";
          var wantsDark =
            stored === "dark" ||
            (stored === "system" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", wantsDark);
        } catch (_) { /* private mode / no storage — fall back to light */ }
      })();
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans bg-bg-canvas text-fg-default antialiased">
    <%= content_for?(:body) ? yield(:body) : yield %>
  </body>
</html>

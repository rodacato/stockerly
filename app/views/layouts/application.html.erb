<!DOCTYPE html>
<html lang="es-MX" data-theme="lumen" class="<%= content_for(:html_class) %>">
  <head>
    <% page_title       = content_for(:title)       || t("brand.title") %>
    <% page_description = content_for(:description) || t("brand.description") %>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <%# viewport-fit=cover is what makes env(safe-area-inset-*) resolve to
        anything but 0 — the bottom nav already pads itself with it. %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="<%= page_description %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Stockerly">
    <meta name="application-name" content="Stockerly">
    <%# The chrome the app runs in, not the brand: this paints the status bar,
        so it tracks bg-surface and the theme the user picked. The manifest
        keeps #5B6CFF for the splash and the task switcher. %>
    <meta name="theme-color" content="#FFFFFF" data-light="#FFFFFF" data-dark="#23242E">

    <%# Open Graph / Social Sharing %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Stockerly">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:image" content="<%= request.base_url %>/og-image.png?v=<%= BrandAssets::VERSION %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Stockerly">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= request.base_url %>/og-image.png?v=<%= BrandAssets::VERSION %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# PWA-spec URLs must stay stable (browsers/iOS expect them at well-known
        paths), so brand updates ride BrandAssets::VERSION in the query string
        to invalidate Cloudflare's edge cache. %>
    <link rel="manifest" href="/manifest.json?v=<%= BrandAssets::VERSION %>">
    <link rel="icon" href="/favicon.svg?v=<%= BrandAssets::VERSION %>" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png?v=<%= BrandAssets::VERSION %>" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= BrandAssets::VERSION %>">
    <%= render "shared/ios_splash" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# Two links, because `display` is per request and the two kinds of font
        want opposite answers. Text swaps: reading a fallback beats reading
        nothing. Material Symbols blocks: it is a LIGATURE font, so a fallback
        renders the word `info` where the icon belongs, which is what shipped —
        icons showing as text on mobile, and only correct on desktop once the
        font was cached. `block` draws nothing until the file lands. %>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500..800&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# Early-paint theme apply — reads the same localStorage key the
        theme Stimulus controller writes (/profile preference card,
        S11 #146). Runs before <body> renders so reloads don't FOUC. %>
    <script nonce="<%= request.content_security_policy_nonce %>">
      (function () {
        try {
          var stored = localStorage.getItem("stockerly.theme") || "system";
          var wantsDark =
            stored === "dark" ||
            (stored === "system" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", wantsDark);
          var themeColor = document.querySelector('meta[name="theme-color"]');
          themeColor.content = wantsDark ? themeColor.dataset.dark : themeColor.dataset.light;
        } catch (_) { /* private mode / no storage — fall back to light */ }
      })();
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans bg-bg-canvas text-fg-default antialiased">
    <%= content_for?(:body) ? yield(:body) : yield %>
  </body>
</html>

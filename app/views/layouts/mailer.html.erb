<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title>Stockerly</title>
  </head>
  <body style="margin:0; padding:0; background:<%= BrandAssets.color("bg-canvas") %>; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color:<%= BrandAssets.color("fg-default") %>;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:<%= BrandAssets.color("bg-canvas") %>;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="560" style="max-width:560px; width:100%; background:<%= BrandAssets.color("bg-surface") %>; border:1px solid <%= BrandAssets.color("border-default") %>; border-radius:12px; overflow:hidden;">
            <%# Logo header band. The one surface that still reads the wordmark
                from a file: a mail client reliably renders a PNG and absolute URL, so the ink-on-light artwork is flat here and
                the URL absolute. %>
            <tr>
              <td style="padding:28px 32px 0;">
                <a href="<%= root_url %>" style="display:inline-block; text-decoration:none;">
                  <%= image_tag "#{root_url}brand/wordmark-light.png?v=#{BrandAssets::VERSION}", alt: "Stockerly",
                        height: "32", style: "display:block; height:32px; width:auto;" %>
                </a>
              </td>
            </tr>
            <%# Body %>
            <tr>
              <td style="padding:24px 32px 32px;">
                <%= yield %>
              </td>
            </tr>
            <%# Footer band %>
            <tr>
              <td style="padding:20px 32px; background:<%= BrandAssets.color("bg-canvas") %>; border-top:1px solid <%= BrandAssets.color("border-default") %>; font-size:11px; color:<%= BrandAssets.color("fg-subtle") %>;">
                <%= t("brand.mail_footer") %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

<%# The auth zone: no navbar, no footer, nothing to click but the card, which
    is one column at every width (AU-06). %>
<% content_for(:body) do %>
  <div class="flex min-h-screen items-center justify-center bg-bg-canvas p-4">
    <div id="flash_messages" class="fixed right-4 top-4 z-50 flex max-w-sm flex-col gap-3" style="pointer-events: none;">
      <%= render "shared/flash" %>
    </div>

    <main class="<%= card_classes("flex w-full max-w-md flex-col justify-center p-8 shadow-sm lg:p-10") %>">
      <%= yield %>
    </main>
  </div>
<% end %>
<%= render template: "layouts/application" %>

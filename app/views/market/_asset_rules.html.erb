<%# Locals: rules. The artboard's "VS. TU PLAN" also showed a Meta; no target
    price exists anywhere in the code, so the card carries the rules, which do. %>
<section class="rounded-2xl border border-border-default bg-bg-surface p-5">
  <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle"><%= t("posicion.plan_titulo") %></p>

  <% if rules.any? %>
    <ul class="mt-3 flex flex-col gap-2">
      <% rules.each do |rule| %>
        <li class="flex items-center justify-between gap-3 text-sm">
          <span class="min-w-0 truncate text-fg-default"><%= alert_condition_summary(rule) %></span>
          <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold
                       <%= rule.active? ? "bg-positive-bg text-positive-fg" : "bg-bg-muted text-fg-subtle" %>">
            <%= rule.active? ? "activa" : "en pausa" %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-fg-subtle"><%= t("posicion.plan_sin_reglas") %></p>
  <% end %>
</section>

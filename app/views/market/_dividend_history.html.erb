<%# Historial de dividendos — annual rollup + the records on hand. %>
<% if @dividends.present? %>
  <%
    annual_totals = @dividends.group_by { |d| d.ex_date.year }.transform_values do |divs|
      divs.sum { |d| d.amount_per_share.to_f }
    end
    ccy = @asset.currency
  %>

  <div class="flex flex-col gap-4">
    <h4 class="text-sm font-semibold text-fg-default"><%= t(".titulo") %></h4>

    <% if annual_totals.size >= 2 %>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <% annual_totals.first(4).each do |year, total| %>
          <div class="rounded-xl border border-border-default bg-bg-muted p-3 text-center">
            <p class="font-mono text-[10px] uppercase tracking-widest text-fg-subtle"><%= year %></p>
            <p class="mt-1 font-mono text-base font-medium text-fg-default">
              <%= format_currency_mx(total, currency: ccy) %>
            </p>
            <p class="text-[10px] text-fg-subtle"><%= t(".por_accion") %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="overflow-x-auto rounded-xl border border-border-default">
      <table class="w-full text-sm">
        <thead class="bg-bg-muted">
          <tr>
            <% [ [ t(".col_ex"), "text-left" ], [ t(".col_pago"), "text-left" ],
                 [ t(".col_monto"), "text-right" ] ].each do |label, align| %>
              <th class="px-4 py-3 font-mono text-[11px] uppercase tracking-widest text-fg-subtle <%= align %>"><%= label %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default">
          <% @dividends.each do |div| %>
            <tr>
              <td class="px-4 py-3 font-medium text-fg-default"><%= short_date_es(div.ex_date) %></td>
              <td class="px-4 py-3 text-fg-subtle"><%= short_date_es(div.pay_date) %></td>
              <td class="px-4 py-3 text-right font-mono font-semibold text-positive-fg">
                <%= format_currency_mx(div.amount_per_share, currency: ccy, precision: 4) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <%= render "components/empty_state", icon: "paid",
             title: t(".vacio_titulo"), description: t(".vacio_cuerpo") %>
<% end %>

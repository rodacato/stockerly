<%# Reportes trimestrales — historical EPS results, lazy-loaded into a
    turbo_frame. Reachable via the lazy endpoint even though it is no longer
    surfaced as a tab on the show page. %>
<% if @earnings_events.present? %>
  <% reported = @earnings_events.select { |e| e.actual_eps.present? }.reverse %>
  <% if reported.size >= 2 %>
    <div class="mb-8 flex flex-col gap-4">
      <h4 class="text-sm font-semibold text-fg-default"><%= t(".historial") %></h4>

      <div class="flex h-40 items-end gap-3">
        <% max_eps = reported.map { |e| [ e.actual_eps.to_f.abs, e.estimated_eps.to_f.abs ].max }.max %>
        <% max_eps = 1.0 if max_eps.zero? %>
        <% reported.each do |event| %>
          <div class="flex flex-1 flex-col items-center gap-1">
            <div class="flex h-28 w-full items-end gap-0.5">
              <% est_h = max_eps.positive? ? (event.estimated_eps.to_f.abs / max_eps * 100).round : 0 %>
              <div class="flex-1 rounded-t bg-bg-muted" style="height: <%= est_h %>%"
                   title="<%= t(".estimado_valor", value: event.estimated_eps) %>"></div>
              <% act_h = max_eps.positive? ? (event.actual_eps.to_f.abs / max_eps * 100).round : 0 %>
              <div class="flex-1 rounded-t <%= event.beat_miss == :beat ? "bg-positive" : "bg-negative" %>"
                   style="height: <%= act_h %>%" title="<%= t(".real_valor", value: event.actual_eps) %>"></div>
            </div>
            <span class="text-[10px] text-fg-subtle"><%= short_month_year_es(event.report_date) %></span>
          </div>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <% [ [ "bg-bg-muted", t(".estimado") ], [ "bg-positive", t(".supero") ],
             [ "bg-negative", t(".por_debajo") ] ].each do |swatch, label| %>
          <div class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-sm <%= swatch %>" aria-hidden="true"></span>
            <span class="text-[10px] font-medium text-fg-subtle"><%= label %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-xl border border-border-default">
    <table class="w-full text-sm">
      <thead class="bg-bg-muted">
        <tr>
          <% [ [ t(".col_fecha"), "text-left" ], [ t(".col_estimado"), "text-right" ],
               [ t(".col_real"), "text-right" ], [ t(".col_sorpresa"), "text-right" ],
               [ t(".col_resultado"), "text-center" ] ].each do |label, align| %>
            <th class="px-4 py-3 font-mono text-[11px] uppercase tracking-widest text-fg-subtle <%= align %>"><%= label %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-border-default">
        <% @earnings_events.each do |event| %>
          <tr>
            <td class="px-4 py-3 font-medium text-fg-default">
              <%= short_date_es(event.report_date) %>
              <span class="ml-1 text-[10px] text-fg-subtle">
                <%= event.before_market_open? ? t(".pre_apertura") : t(".cierre") %>
              </span>
            </td>
            <td class="px-4 py-3 text-right font-mono text-fg-subtle">
              <%= event.estimated_eps ? format_currency_mx(event.estimated_eps, currency: event.asset.currency) : "—" %>
            </td>
            <td class="px-4 py-3 text-right font-mono font-semibold text-fg-default">
              <%= event.actual_eps ? format_currency_mx(event.actual_eps, currency: event.asset.currency) : t(".por_reportar") %>
            </td>
            <td class="px-4 py-3 text-right font-mono">
              <% if event.eps_surprise_percent %>
                <% positive = event.eps_surprise_percent >= 0 %>
                <span class="font-semibold <%= positive ? "text-positive-fg" : "text-negative-fg" %>">
                  <%= "+" if positive %><%= event.eps_surprise_percent %>%
                </span>
              <% else %>
                <span class="text-fg-subtle">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <%
                icon, label, tone =
                  case event.beat_miss
                  when :beat then [ "trending_up",   t(".supero"),     "bg-positive-bg text-positive-fg" ]
                  when :miss then [ "trending_down", t(".por_debajo"), "bg-negative-bg text-negative-fg" ]
                  else            [ "schedule",      t(".pendiente"),  "bg-warning/10 text-warning" ]
                  end
              %>
              <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold <%= tone %>">
                <span class="material-symbols-outlined text-xs" aria-hidden="true"><%= icon %></span>
                <%= label %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render "components/empty_state", icon: "event_note",
             title: t(".vacio_titulo"), description: t(".vacio_cuerpo") %>
<% end %>

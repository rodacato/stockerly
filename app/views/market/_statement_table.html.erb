<%# Statement table — renders financial data in a multi-year table using structured line items %>
<% line_items = line_items_for(statement_type) %>

<div class="overflow-hidden rounded-xl border border-border-default bg-bg-surface">
  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr class="bg-bg-muted">
          <th class="sticky left-0 min-w-[280px] border-b border-border-default bg-bg-muted px-6 py-4 text-left font-mono text-xs uppercase tracking-wider text-fg-subtle">
            <%= t("market.statement_table.concepto") %>
          </th>
          <% statements.each do |stmt| %>
            <th class="min-w-[120px] border-b border-border-default px-6 py-4 text-right font-mono text-xs uppercase tracking-wider text-fg-subtle">
              FY<%= stmt.fiscal_year || stmt.fiscal_date_ending&.year %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-border-default">
        <% line_items.each do |item| %>
          <% if item[:section] %>
            <%# Section header row %>
            <tr class="bg-bg-muted">
              <td class="px-6 py-3 text-sm font-bold text-fg-default" colspan="<%= statements.size + 1 %>">
                <%= item[:section] %>
              </td>
            </tr>
          <% else %>
            <tr class="<%= "border-b-2 border-border-default" if item[:bold] && item[:margin_key] %>">
              <td class="sticky left-0 bg-bg-surface px-6 py-3.5 text-sm <%= item[:bold] ? "font-bold text-fg-default" : "font-medium text-fg-subtle" %> <%= "pl-10" if item[:indent] %>">
                <%= item[:label] %>
                <% if item[:margin_key] %>
                  <div class="mt-0.5 text-[10px] font-normal text-fg-subtle"><%= t("market.statement_table.margen") %></div>
                <% end %>
              </td>
              <% statements.each do |stmt| %>
                <% raw_value = stmt.data[item[:key]] %>
                <td class="py-3.5 px-6 text-right tabular-nums">
                  <% if item[:bold] && item[:accent] %>
                    <div class="text-sm font-bold text-primary"><%= format_statement_value(raw_value) %></div>
                  <% elsif item[:bold] %>
                    <div class="text-sm font-bold"><%= format_statement_value(raw_value) %></div>
                  <% else %>
                    <span class="text-sm text-fg-subtle"><%= format_statement_value(raw_value) %></span>
                  <% end %>
                  <% if item[:margin_key] && stmt.data["totalRevenue"]&.to_f&.nonzero? %>
                    <% margin = (raw_value.to_f / stmt.data["totalRevenue"].to_f * 100).round(1) %>
                    <div class="text-xs text-fg-subtle"><%= margin %>%</div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

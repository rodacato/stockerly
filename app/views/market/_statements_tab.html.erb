<%# Financial statements — sub-tabs for income statement / balance sheet /
    cash flow. Line-item labels live in StatementsHelper (BMV-emisora es-MX). %>
<% if @asset.financial_statements.exists? %>
  <%
    panels = [
      [ t(".resultados"), :income_statement, t(".sin_resultados") ],
      [ t(".balance"),    :balance_sheet,    t(".sin_balance") ],
      [ t(".flujo"),      :cash_flow,        t(".sin_flujo") ]
    ]
  %>
  <div data-controller="tabs" class="flex flex-col gap-6">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div class="inline-flex items-center gap-1 rounded-lg border border-border-default bg-bg-muted p-1">
        <% panels.each_with_index do |(label, _type, _empty), idx| %>
          <% active = idx.zero? %>
          <button type="button" data-tabs-target="tab" data-action="tabs#switch"
                  class="rounded-md px-3.5 py-1.5 text-xs font-medium <%= active ? "bg-bg-surface text-fg-default shadow-sm" : "text-fg-subtle hover:text-fg-default" %>">
            <%= label %>
          </button>
        <% end %>
      </div>
      <p class="font-mono text-[10.5px] uppercase tracking-widest text-fg-subtle">
        <%= t(".fuente", gaap: gaap_label(@asset), currency: @asset.currency) %>
      </p>
    </div>

    <% panels.each_with_index do |(_label, type, empty_copy), idx| %>
      <div data-tabs-target="panel" class="<%= "hidden" unless idx.zero? %>">
        <% stmts = @asset.financial_statements.where(statement_type: type, period_type: :annual)
                         .order(fiscal_date_ending: :desc).limit(5) %>
        <% if stmts.any? %>
          <%= render "market/statement_table", statements: stmts, asset: @asset, statement_type: type %>
        <% else %>
          <p class="py-8 text-center text-sm text-fg-subtle"><%= empty_copy %></p>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "components/empty_state", icon: "description",
             title: t(".vacio_titulo"), description: t(".vacio_cuerpo") %>
<% end %>

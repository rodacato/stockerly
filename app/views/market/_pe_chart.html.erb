<%# The P/U series, drawn and NOT judged. It used to shade three bands and
    label them Atractiva (<15) / Neutral (15-25) / Cara (>25) — universal
    thresholds applied to every issuer, which is exactly the invented threshold
    D36 forbids: 25 is cheap for software and expensive for a utility.

    The footnote is not decoration either. PeHistoryCalculator divides the price
    series by a STATIC eps, so this line moved because the price moved, and a
    reader who takes it for the company's own history is reading it wrong. %>
<% if @pe_history.present? && @pe_history.size >= 2 %>
  <section class="<%= card_classes("shadow-sm overflow-hidden") %>">
    <div class="border-b border-border-default bg-bg-muted px-5 py-4">
      <h3 class="flex items-center gap-2 text-sm font-semibold text-fg-default">
        <span class="material-symbols-outlined text-base text-primary" aria-hidden="true">analytics</span>
        <%= t(".titulo", days: MarketData::UseCases::LoadAssetDetail::PE_CHART_DAYS) %>
      </h3>
    </div>
    <div class="p-5">
      <%
        points = @pe_history
        pe_values = points.map { |p| p[:pe_ratio].to_f }
        min_pe, max_pe = pe_values.minmax
        pe_range = (max_pe - min_pe).zero? ? 1.0 : max_pe - min_pe

        left_margin = 45
        right_margin = 10
        total_width = 500
        chart_width = total_width - left_margin - right_margin
        height = 180
        padding_y = 15
        bottom_margin = 20
        usable_height = height - padding_y - bottom_margin
        step_x = chart_width.to_f / (points.size - 1)

        y_for = ->(pe) { height - bottom_margin - (((pe - min_pe) / pe_range) * usable_height) }
        polyline_pts = points.each_with_index.map { |point, i|
          "#{(left_margin + (i * step_x)).round(1)},#{y_for.call(point[:pe_ratio].to_f).round(1)}"
        }.join(" ")

        last_pe = pe_values.last
        mid_pe = (min_pe + max_pe) / 2.0
        y_ticks = [ [ max_pe, padding_y ], [ mid_pe, padding_y + (usable_height / 2.0) ], [ min_pe, height - bottom_margin ] ]
        date_indices = [ 0, points.size / 3, (points.size * 2) / 3, points.size - 1 ].uniq
      %>
      <svg viewBox="0 0 <%= total_width %> <%= height %>" class="w-full" style="height: 180px;" preserveAspectRatio="xMidYMid meet"
           role="img" aria-label="<%= t(".titulo", days: MarketData::UseCases::LoadAssetDetail::PE_CHART_DAYS) %>">
        <% y_ticks.each do |value, y| %>
          <text x="<%= left_margin - 5 %>" y="<%= y.round(1) %>" text-anchor="end" dominant-baseline="middle"
                class="fill-fg-subtle" font-size="10" font-weight="500"><%= value.round(1) %></text>
          <line x1="<%= left_margin %>" y1="<%= y.round(1) %>" x2="<%= total_width - right_margin %>" y2="<%= y.round(1) %>"
                class="stroke-border-default" stroke-width="0.5" stroke-dasharray="4,4"/>
        <% end %>

        <% date_indices.each do |idx| %>
          <% x_pos = (left_margin + (idx * step_x)).round(1) %>
          <text x="<%= x_pos %>" y="<%= height - 3 %>" text-anchor="middle"
                class="fill-fg-subtle" font-size="9" font-weight="500"><%= short_date_es(points[idx][:date], include_year: false) %></text>
          <line x1="<%= x_pos %>" y1="<%= padding_y %>" x2="<%= x_pos %>" y2="<%= height - bottom_margin %>"
                class="stroke-border-default" stroke-width="0.3" stroke-dasharray="2,4"/>
        <% end %>

        <polyline points="<%= polyline_pts %>" fill="none" class="stroke-primary"
                  stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
        <circle cx="<%= (left_margin + ((points.size - 1) * step_x)).round(1) %>" cy="<%= y_for.call(last_pe).round(1) %>"
                r="3" class="fill-primary"/>
      </svg>

      <p class="mt-3 text-xs text-fg-subtle">
        <%= t(".actual") %>
        <span class="font-mono font-semibold text-fg-default"><%= last_pe.round(2) %></span>
      </p>
      <p class="mt-1 text-[11px] text-fg-subtle"><%= t(".como_se_calcula") %></p>
    </div>
  </section>
<% end %>

<%# Recent technical-zone transitions (S10 #93), descriptive per ADR-001.
    Phrases, tags and accents come from MarketHelper.

    D114: a section of `market/reading`. Its copy moves to the locale with this
    slice, per ADR-0011 — it was the last of the three carrying hardcoded
    es-MX, which is why the "no recomendaciones" line survived here after it
    was dropped from its two siblings. Locals: asset, observations. %>
<% if observations.any? %>
  <div class="border-t border-border-default px-5 pt-4 pb-1">
    <h3 class="font-mono text-[11px] font-semibold uppercase tracking-widest text-fg-subtle">
      <%= t(".seccion") %>
    </h3>
    <p class="mt-1 text-[11px] leading-relaxed text-fg-subtle">
      <%= t(".alcance", symbol: asset.symbol, dias: MarketData::UseCases::LoadAssetDetail::OBSERVATION_WINDOW_DAYS) %>
    </p>
  </div>

  <ul class="divide-y divide-border-default border-t border-border-default">
    <% observations.each do |observation| %>
      <li class="grid grid-cols-[8px_1fr_auto] sm:grid-cols-[8px_1fr_140px_120px] items-center gap-3.5 px-5 py-3.5">
        <span class="inline-block h-1.5 w-1.5 rounded-full <%= observation_dot_class(observation_accent(observation)) %>"></span>
        <p class="text-sm text-fg-default leading-snug">
          <%= observation_phrase(observation) %>
        </p>
        <span class="hidden sm:block font-mono text-[10.5px] font-semibold uppercase tracking-[0.08em] text-fg-subtle">
          <%= observation_tag(observation) %>
        </span>
        <span class="text-right text-xs text-fg-subtle">
          <%= relative_age(observation.observed_at) %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>

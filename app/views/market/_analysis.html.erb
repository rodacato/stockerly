<%# The Análisis side of the asset detail. `cockpit-asset-analisis` draws one
    continuous scroll, so the sub-tabs that used to hold the fundamentals are
    gone (D36): Estados financieros keeps its lazy frame at the foot, and the
    rest reads top to bottom. Locals: asset. %>
<%= render "market/range_52w", range: @range_52w, currency: @asset.currency,
           cost: @anchors[:cost]&.reference if @range_52w %>

<%= render "market/state_verdict", state: @state, state_source: @state_source, holding: @holding %>

<%# No price chart for fixed income (D98). Nothing writes `asset_price_histories`
    for a CETE — no registered source carries :historical for the type, and the
    auction curve lands in CetesRateHistory instead — so the branch that used to
    render one could never have data. Its absence is the honest state. %>
<% if @price_histories.size >= 2 && !@asset.asset_type_fixed_income? %>
  <section class="<%= card_classes("p-5") %>">
    <h3 class="font-display text-base font-semibold tracking-tight text-fg-default">
      <%= t("market.precio.titulo", currency: @asset.currency) %>
    </h3>
    <%# The window control and the last session's numbers read as one row: the
        control says what is plotted, the strip says what the latest bar did. %>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <%= render "components/segmented",
                 label: t("market.precio.rango_label"),
                 options: chart_range_options(@asset, @chart_range) %>
      <%= render "market/chart_stats", bar: @price_histories.last, currency: @asset.currency if @price_histories.last %>
    </div>

    <div data-controller="chart" data-chart-height-value="<%= MarketHelper::CHART_HEIGHT %>"
         data-chart-series-value="<%= price_series_json(@price_histories) %>"
         data-chart-levels-value="<%= chart_levels_json(@layers, holding: @holding) %>"
         data-chart-anchors-value="<%= chart_anchors_json(@anchors[:cost]&.reference, @asset.currency) %>">
      <div class="mt-4" data-chart-target="canvas"></div>

      <% if @layers.present? %>
        <div class="mt-3">
          <%= render "market/chart_layers", layers: @layers %>
        </div>
      <% end %>
    </div>

    <%= render "market/tradingview_toggle", asset: @asset if tradingview_available?(@asset) %>
  </section>
<% end %>

<% unless @asset.asset_type_fixed_income? %>
  <% if @anchors[:cost] || @anchors[:threshold] || @asset_rules.any? %>
    <%= render "market/vs_plan", cost_anchor: @anchors[:cost], threshold_anchor: @anchors[:threshold],
               threshold_currency: @anchors[:threshold_rule]&.currency, rules: @anchors[:other_rules],
               currency: @asset.currency %>
  <% end %>
<% end %>

<% if @asset.asset_type_fixed_income? %>
  <%= render "market/fixed_income_detail", asset: @asset, yield_data: @yield_data %>
<% else %>
  <%= render "market/market_context", asset: @asset, context: @market_context %>
  <%= render "market/signals", signals: @signals, reading: @reading %>
  <%= render "market/layers", layers: @layers, asset: @asset, holding: @holding %>
  <%= render "market/recent_observations", asset: @asset, observations: @recent_observations %>
  <%= render "market/news", asset: @asset, news: @news %>
  <%= render "market/fundamentals_block", asset: @asset, presenter: @presenter, has_fundamentals: @has_fundamentals %>
  <%= render "market/pe_chart" if @asset.asset_type_stock? %>
  <%= render "market/company_facts", asset: @asset, company_overview: @company_overview %>

  <% if @dividends.present? %>
    <section class="<%= card_classes("p-5") %>">
      <%= render "market/dividend_history" %>
    </section>
  <% end %>

  <% if @has_statements %>
    <section class="<%= card_classes("flex flex-col gap-4 p-5") %>">
      <h3 class="font-display text-base font-semibold tracking-tight text-fg-default">
        <%= t("market.statements_tab.titulo") %>
      </h3>
      <%= turbo_frame_tag "asset_statements_tab", src: market_asset_statements_tab_path(@asset.symbol), loading: "lazy" do %>
        <%= render "components/skeleton", type: "table_row", count: 5 %>
      <% end %>
    </section>
  <% end %>
<% end %>

<%# The artboard closes on two actions. Registrar movimiento is the sheet the
    Consolidado already mounts; Crear regla lands on the rule form with the
    symbol filled in. %>
<div class="flex flex-wrap gap-3">
  <%= link_to new_alert_path(asset_symbol: @asset.symbol),
        class: "flex-1 rounded-lg border border-border-default px-4 py-2.5 text-center text-sm font-semibold text-fg-default transition-colors hover:border-primary hover:text-primary" do %>
    <%= t("market.actions.crear_regla") %>
  <% end %>
  <%= render "components/sheet_dialog", frame_id: "trade_sheet", url: new_trade_path(symbol: @asset.symbol),
             label: t("trades.new.titulo") %>
</div>

<%= render "market/disclaimer" %>

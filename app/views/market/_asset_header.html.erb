<%# Asset detail header, 2.0. The pre-2.0 version carried a three-level
    breadcrumb, a badge, five chips and three action buttons; the artboard is a
    back link, the name, the price and a bookmark. The capture button moved to
    the foot of Mi posición, where the artboard puts it.
    Locals: asset, is_watchlisted, day_change. %>
<header class="flex flex-col gap-4">
  <div class="flex items-start justify-between gap-4">
    <%# Back to Activos: the listing this used to return to was deleted with D31,
        and Activos is where the reader came from anyway. %>
    <%= link_to assets_path, class: "flex min-w-0 items-center gap-2 text-fg-default transition-colors hover:text-primary" do %>
      <span class="material-symbols-outlined shrink-0 text-xl" aria-hidden="true">chevron_left</span>
      <span class="min-w-0">
        <span class="font-display text-xl font-bold tracking-tight"><%= asset.symbol %></span>
        <span class="ml-2 truncate text-base text-fg-subtle"><%= asset.name %></span>
      </span>
    <% end %>

    <%# One chip the artboard does not draw, kept on purpose: the exchange and
        currency chips are redundant (both appear below), but the type is only
        inferable from which blocks the page renders, and five specs defended
        it. Losing it would leave it visible only on Tracked. %>
    <span class="ml-auto shrink-0 rounded-md bg-bg-muted px-2 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-fg-subtle">
      <%= asset_type_label_es(asset.asset_type) %>
    </span>

    <%= turbo_frame_tag "watchlist_button_#{asset.id}", class: "shrink-0" do %>
      <% if is_watchlisted %>
        <%= button_to watchlist_item_path(asset.watchlist_items.find_by(user: current_user)),
                      method: :delete,
                      "aria-label": t("market.header.quitar_watchlist"),
                      class: "flex size-11 items-center justify-center rounded-lg text-primary transition-colors hover:bg-bg-muted" do %>
          <span class="material-symbols-outlined text-xl" aria-hidden="true">bookmark_added</span>
        <% end %>
      <% else %>
        <%= button_to watchlist_items_path, params: { asset_id: asset.id },
                      "aria-label": t("market.header.agregar_watchlist"),
                      class: "flex size-11 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:bg-bg-muted hover:text-primary" do %>
          <span class="material-symbols-outlined text-xl" aria-hidden="true">bookmark_add</span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= render "components/asset_price", asset: asset, user: current_user, change: day_change %>
</header>

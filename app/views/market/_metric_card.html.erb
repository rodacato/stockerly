<%# One metric, with its educational popover. Locals: definition, value.
    The name, description and guidance come from `market.metricas.<key>.*`;
    the domain carries the key only. The chip is built for the three metrics
    whose threshold is definitional (D36) and omitted everywhere else. %>
<% chip = metric_chip(definition, value) %>
<div class="relative flex flex-col gap-3 rounded-2xl border border-border-default bg-bg-surface p-5"
     data-controller="metric-tooltip">
  <div class="flex items-center justify-between gap-2">
    <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle">
      <%= metric_name(definition) %>
    </p>
    <button type="button" data-action="click->metric-tooltip#toggle"
            class="shrink-0 cursor-help text-fg-subtle transition-colors hover:text-primary"
            aria-label="<%= t("market.metricas_detalle", metric: metric_name(definition)) %>">
      <span class="material-symbols-outlined text-sm" aria-hidden="true">info</span>
    </button>
  </div>

  <div class="flex flex-col gap-1.5">
    <div class="flex flex-wrap items-baseline gap-2">
      <p class="font-mono text-2xl font-medium tracking-tight text-fg-default">
        <%= format_metric_value(value, definition.format_type) %>
      </p>
      <% if chip %>
        <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold <%= chip.last %>"><%= chip.first %></span>
      <% end %>
    </div>
    <p class="text-sm text-fg-subtle"><%= metric_desc(definition) %></p>
  </div>

  <div data-metric-tooltip-target="popover"
       class="absolute left-0 top-full z-20 mt-3 hidden w-full overflow-hidden rounded-xl border border-border-default bg-bg-surface shadow-xl">
    <div class="flex items-center justify-between gap-2 border-b border-border-default px-4 py-3">
      <h3 class="flex items-center gap-2 text-sm font-semibold text-fg-default">
        <span class="material-symbols-outlined text-lg text-primary" aria-hidden="true">school</span>
        <%= metric_name(definition) %>
      </h3>
      <button type="button" data-action="click->metric-tooltip#close"
              class="text-fg-subtle transition-colors hover:text-fg-default"
              aria-label="<%= t("market.metricas_cerrar") %>">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">close</span>
      </button>
    </div>

    <div class="flex flex-col gap-3 p-4">
      <section class="flex flex-col gap-1">
        <h4 class="font-mono text-[10.5px] uppercase tracking-widest text-fg-subtle"><%= t("market.metricas_que_mide") %></h4>
        <p class="text-sm leading-relaxed text-fg-default"><%= metric_desc(definition) %></p>
      </section>
      <section class="flex flex-col gap-1">
        <h4 class="font-mono text-[10.5px] uppercase tracking-widest text-fg-subtle"><%= t("market.metricas_como_leerlo") %></h4>
        <p class="text-sm leading-relaxed text-fg-default"><%= metric_guidance(definition) %></p>
      </section>
    </div>

    <p class="border-t border-border-default bg-bg-muted px-4 py-2 text-center text-[10px] italic text-fg-subtle">
      <%= t("market.metricas_referencial") %>
    </p>
  </div>
</div>

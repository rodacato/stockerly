<%# One metric, as a row. Locals: definition, value, currency; optional reading (D115).
    The name, description and guidance come from `market.metricas.<key>.*`;
    the domain carries the key only. The chip is built for the three metrics
    whose threshold is definitional (D36) and omitted everywhere else.

    D111: a row, not a card. This rendered as a bordered card inside the
    bordered card that lists them, which reads as chrome about chrome — the
    artboard has always drawn one card holding divided rows. The ⓘ stays: it
    carries "cómo leerlo", which is the half of this block that answers why it
    is here at all. %>
<% chip = metric_chip(definition, value) %>
<div class="relative flex flex-col gap-1 px-5 py-3.5" data-controller="metric-tooltip">
  <div class="flex items-baseline justify-between gap-3">
    <div class="flex items-center gap-1.5">
      <span class="text-sm text-fg-default"><%= metric_name(definition) %></span>
      <button type="button" data-action="click->metric-tooltip#toggle"
              class="shrink-0 cursor-help text-fg-subtle transition-colors hover:text-primary"
              aria-label="<%= t("market.metricas_detalle", metric: metric_name(definition)) %>">
        <%= icon_svg "info", class: "text-sm", "aria-hidden": "true" %>
      </button>
    </div>

    <div class="flex flex-wrap items-baseline justify-end gap-2">
      <span class="font-mono text-sm font-semibold text-fg-default">
        <%= format_metric_value(value, definition.format_type, currency: currency) %>
      </span>
      <% if chip %>
        <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold <%= chip.last %>"><%= chip.first %></span>
      <% end %>
    </div>
  </div>

  <p class="text-xs leading-snug text-fg-subtle"><%= local_assigns[:reading] || metric_desc(definition) %></p>

  <%= render "market/glossary_popover", name: metric_name(definition), desc: metric_desc(definition), guide: metric_guidance(definition) %>
</div>

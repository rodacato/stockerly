<%# CETE / fixed income detail. Replaces the tab system: yield hero + fact grid
    + maturity progress + investment simulation. Locals: asset, yield_data. %>
<%
  # `total_days` only comes from the symbol pattern (CETES_28D / CETES_91D / ...).
  # No `issue_date` on Asset yet, so for non-CETES fixed-income instruments
  # we can't compute progress — leave it nil and hide the maturity-progress block.
  parsed_term     = asset.symbol.to_s.match(/CETES?_(\d+)D/i)
  total_days      = parsed_term ? parsed_term[1].to_i : nil
  days_remaining  = yield_data[:days_to_maturity].to_i
  days_elapsed    = total_days ? [ total_days - days_remaining, 0 ].max : nil
  progress_pct    = total_days ? (days_elapsed.to_f / total_days * 100).clamp(0, 100) : nil
  show_progress   = total_days.present? && asset.maturity_date.present?
  label_class     = "font-mono text-[10.5px] uppercase tracking-widest text-fg-subtle"
  figure_class    = "mt-1 font-mono text-lg font-medium text-fg-default"
%>

<section class="<%= card_classes("flex flex-col gap-5 p-6") %>">
  <div class="flex flex-wrap items-baseline gap-2">
    <h2 class="font-display text-lg font-semibold tracking-tight text-fg-default"><%= t(".titulo") %></h2>
    <span class="text-xs text-fg-subtle"><%= t(".fuente") %></span>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[300px_1fr] lg:items-center lg:gap-8">
    <div class="flex flex-col gap-1.5 rounded-xl border border-border-default bg-bg-muted px-5 py-5">
      <p class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle">
        <%= total_days.present? ? t(".tasa_plazo", days: total_days) : t(".tasa_anual") %>
      </p>
      <p class="font-mono text-5xl font-medium leading-none tracking-tight text-fg-default">
        <%= number_with_precision(asset.yield_rate || 0, precision: 2) %>%
      </p>
      <p class="text-xs text-fg-subtle"><%= t(".antes_isr") %></p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="border-t border-border-default pt-3">
        <p class="<%= label_class %>"><%= t(".plazo") %></p>
        <p class="<%= figure_class %>"><%= total_days.present? ? t(".dias", count: total_days) : "—" %></p>
      </div>

      <div class="border-t border-border-default pt-3">
        <p class="<%= label_class %>"><%= t(".vencimiento") %></p>
        <p class="<%= figure_class %>"><%= short_date_upper_es(asset.maturity_date) %></p>
        <% if days_remaining.positive? %>
          <p class="text-[11px] text-fg-subtle"><%= t(".faltan", count: days_remaining) %></p>
        <% end %>
      </div>

      <div class="border-t border-border-default pt-3">
        <p class="<%= label_class %>"><%= t(".valor_nominal") %></p>
        <p class="<%= figure_class %>">MXN <%= number_with_precision(asset.face_value || 0, precision: 2, delimiter: ",") %></p>
        <p class="text-[11px] text-fg-subtle"><%= t(".por_titulo") %></p>
      </div>

      <div class="border-t border-border-default pt-3">
        <p class="<%= label_class %>"><%= t(".precio_descuento") %></p>
        <p class="<%= figure_class %>">
          <%= yield_data[:discount_price] ? "MXN #{number_with_precision(yield_data[:discount_price], precision: 4, delimiter: ",")}" : "—" %>
        </p>
        <p class="text-[11px] text-fg-subtle"><%= t(".via_cetes_directo") %></p>
      </div>
    </div>
  </div>
</section>

<section class="<%= card_classes("flex flex-col gap-4 p-6") %>">
  <h3 class="flex items-center gap-2 text-sm font-semibold text-fg-default">
    <span class="material-symbols-outlined text-base text-primary" aria-hidden="true">calendar_today</span>
    <%= t(".avance") %>
  </h3>

  <% if show_progress %>
    <div class="flex flex-col gap-2">
      <div class="flex justify-between text-[11px] font-medium text-fg-subtle">
        <span><%= t(".emision") %></span>
        <span><%= t(".vencimiento") %></span>
      </div>
      <div class="h-2.5 w-full overflow-hidden rounded-full bg-bg-muted">
        <div class="h-full rounded-full bg-primary transition-all"
             style="width: <%= number_with_precision(progress_pct, precision: 1) %>%"></div>
      </div>
      <div class="flex justify-between text-[11px] font-medium">
        <span class="text-fg-subtle"><%= t(".transcurridos", count: days_elapsed) %></span>
        <span class="text-primary"><%= t(".restantes", count: days_remaining) %></span>
      </div>
    </div>
  <% elsif asset.maturity_date.present? %>
    <div class="flex flex-col gap-1">
      <p class="text-sm text-fg-subtle">
        <%= t(".vence_el", date: short_date_upper_es(asset.maturity_date), count: days_remaining) %>
      </p>
      <p class="text-[11px] text-fg-subtle"><%= t(".sin_avance") %></p>
    </div>
  <% else %>
    <p class="text-sm text-fg-subtle"><%= t(".sin_vencimiento") %></p>
  <% end %>
</section>

<section class="<%= card_classes("flex flex-col gap-4 p-6") %>">
  <div class="flex flex-col gap-1">
    <h3 class="flex items-center gap-2 text-sm font-semibold text-fg-default">
      <span class="material-symbols-outlined text-base text-primary" aria-hidden="true">calculate</span>
      <%= t(".simulacion") %>
    </h3>
    <p class="text-sm text-fg-subtle"><%= t(".simulacion_base") %></p>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    <% [ [ t(".inversion_inicial"), yield_data[:investment_cost_100], false ],
         [ t(".valor_vencimiento"), yield_data[:face_value_100], false ],
         [ t(".rendimiento_estimado"), yield_data[:total_return_100], true ] ].each do |label, amount, positive| %>
      <div class="rounded-xl border p-4 text-center <%= positive ? "border-positive-fg/25 bg-positive-bg" : "border-border-default bg-bg-muted" %>">
        <p class="font-mono text-[10.5px] uppercase tracking-widest <%= positive ? "text-positive-fg" : "text-fg-subtle" %>"><%= label %></p>
        <p class="mt-1 font-mono text-xl font-medium <%= positive ? "text-positive-fg" : "text-fg-default" %>">
          <%= amount ? "#{"+" if positive}MXN #{number_with_precision(amount, precision: 2, delimiter: ",")}" : "—" %>
        </p>
      </div>
    <% end %>
  </div>
</section>

<aside class="flex items-start gap-2 rounded-xl border border-warning/25 bg-warning/10 px-4 py-3">
  <span class="material-symbols-outlined text-base text-warning" aria-hidden="true">info</span>
  <p class="text-xs leading-snug text-warning"><%= t(".aviso") %></p>
</aside>

<% content_for :page_title, @asset.symbol %>
<%# Asset detail — Stockerly-2.0 (S10 #93). Adaptive layout by asset type:
    - Equity / ETF: header → observations → chart → tabs (Resumen + optional
      Valoración / Dividendos / Estados financieros)
    - Crypto: header → observations → chart → tabs (Resumen + Mercado)
    - Fixed income (CETE): header → observations → yield card (replaces tabs)
    Tabs are skipped entirely when their underlying data is missing. %>
<%= turbo_stream_from "asset_#{@asset.id}" %>

<div class="mx-auto max-w-6xl space-y-6">
  <%= render "market/asset_header", asset: @asset, presenter: @presenter, is_watchlisted: @is_watchlisted,
                                   day_change: @day_change %>

  <%# D159: lo tuyo goes first, above both tabs, for the holder and the watcher. %>
  <% unless @asset.asset_type_fixed_income? %>
    <% if @position_data || @anchors[:cost] || @anchors[:threshold] || @asset_rules.any? || @next_earnings %>
      <%= render "market/mine", position_data: @position_data, cost_anchor: @anchors[:cost],
                 threshold_anchor: @anchors[:threshold], threshold_currency: @anchors[:threshold_rule]&.currency,
                 rules: @anchors[:other_rules], currency: @asset.currency, next_earnings: @next_earnings %>
    <% end %>
  <% end %>

  <%# Two tabs (D8's asset-detail shape). "Mi posición" only exists when you
      hold the asset, so a watched asset shows Análisis alone rather than an
      empty second tab. %>
  <% if @position_data %>
    <%# The look of components/_segmented, which renders links; these switch panels in place. %>
    <div data-controller="tabs" class="space-y-6"
         data-tabs-active-class="bg-bg-surface font-semibold text-fg-default shadow-sm"
         data-tabs-inactive-class="font-normal text-fg-default">
      <div role="tablist" class="flex w-full gap-1 rounded-xl bg-bg-muted p-1 sm:w-fit">
        <% [ t("posicion.tab_analisis"), t("posicion.tab_posicion") ].each_with_index do |label, index| %>
          <button id="position-tab-<%= index %>" aria-controls="position-panel-<%= index %>" type="button" role="tab" data-tabs-target="tab" data-action="tabs#switch keydown->tabs#navigate"
                  aria-selected="<%= index.zero? %>"
                  class="min-h-11 flex-1 whitespace-nowrap rounded-lg px-4 py-2.5 text-center text-sm transition-colors <%= index.zero? ? "bg-bg-surface font-semibold text-fg-default shadow-sm" : "font-normal text-fg-default hover:text-fg-default" %>">
            <%= label %>
          </button>
        <% end %>
      </div>

      <div id="position-panel-0" role="tabpanel" aria-labelledby="position-tab-0" data-tabs-target="panel" class="space-y-6">
        <%= render "market/analysis", asset: @asset %>
      </div>

      <div id="position-panel-1" role="tabpanel" aria-labelledby="position-tab-1" data-tabs-target="panel" class="hidden space-y-6">
        <%= render "market/position_summary", data: @position_data %>
        <%= render "market/returns", returns: @returns, currency: current_user.preferred_currency if @returns %>
        <% if @position_data[:retrospective] %>
          <%= render "market/purchase_retrospective", retrospective: @position_data[:retrospective] %>
        <% end %>
        <%= render "market/position_trades", trades: @position_data[:trades], asset: @asset %>
        <% if @dividends.present? %>
          <%= render "market/dividend_history" %>
        <% end %>

        <%# The tab had no actions at all: the pair at the foot of Análisis sits
            inside that panel, so switching here lost them. Cerrar posición is a
            shortcut into the sell sheet, not a second way to close — selling
            everything is what closes a position (execute_trade.rb), and it has
            to stay a trade so RealizedGain has legs to read.

            Both are plain links into the frame _analysis already mounts. A
            second components/sheet_dialog here would mount a SECOND turbo frame
            under the same name: Turbo fills the first, so the button on this
            tab would open an empty drawer. %>
        <div class="flex flex-wrap gap-3">
          <%= link_to t("posicion.cerrar"),
                new_trade_path(symbol: @asset.symbol, side: "sell", shares: @position_data[:position].shares),
                data: { turbo_frame: "trade_sheet", turbo_action: "advance" },
                class: button_classes(:secondary, :md, "flex-1 text-center") %>
          <%= link_to t("trades.new.titulo"),
                new_trade_path(symbol: @asset.symbol),
                data: { turbo_frame: "trade_sheet", turbo_action: "advance" },
                class: button_classes(:primary, :md, "flex-1 text-center") %>
        </div>
      </div>
    </div>
  <% else %>
    <%= render "market/analysis", asset: @asset %>
  <% end %>
</div>

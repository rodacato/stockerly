<%# Resumen tab — Stockerly-2.0 (S10 #93, S11 #144). Adaptive metric grid
    by asset type plus the analyst target band for stocks. Closes with the
    "Acerca de la empresa / Ficha" 2-col block (#144). es-MX. %>
<% if @has_fundamentals %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% summary_metrics_for(@asset).each do |key| %>
      <% defn = MarketData::Domain::MetricDefinitions.find(key) rescue nil %>
      <% next unless defn %>
      <% value = resolve_metric_value(@presenter, key) %>
      <%= render "market/metric_card", definition: defn, value: value %>
    <% end %>
  </div>

  <% if @asset.asset_type_stock? %>
    <div class="mt-6">
      <%= render "market/analyst_target" %>
    </div>
  <% end %>
<% else %>
  <%= render "components/empty_state", icon: "analytics",
             title: t(".vacio_titulo"), description: t(".vacio_cuerpo") %>
<% end %>

<%= render "market/company_facts", asset: @asset, company_overview: @company_overview %>

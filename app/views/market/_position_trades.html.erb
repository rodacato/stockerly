<%# Locals: trades, asset. The five most recent, with a way to all of them —
    the global list lives at /positions since the Consolidado took /portfolio. %>
<section class="<%= card_classes("p-5") %>">
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="font-display text-base font-semibold tracking-tight text-fg-default">
      <%= t("posicion.movimientos") %>
    </h3>
    <%= link_to positions_path(tab: "trades"), class: "shrink-0 text-sm font-medium text-primary hover:underline" do %>
      <%= t("posicion.ver_todas") %> <span aria-hidden="true">→</span>
    <% end %>
  </div>

  <ul class="mt-3 flex flex-col gap-3">
    <% trades.each do |trade| %>
      <li class="flex items-center justify-between gap-3">
        <span class="min-w-0">
          <span class="inline-flex items-center gap-2">
            <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold
                         <%= trade.buy? ? "bg-positive-bg text-positive-fg" : "bg-warning-bg text-warning-fg" %>">
              <%= trade.buy? ? "Compra" : "Venta" %>
            </span>
            <span class="text-sm font-medium text-fg-default">
              <%= l(trade.executed_at.to_date, format: :short) %>
            </span>
          </span>
          <span class="mt-0.5 block font-mono text-[11px] text-fg-subtle">
            <%= number_with_precision(trade.shares, precision: trade.shares.to_d.frac.zero? ? 0 : 4) %>
            @ <%= format_currency_mx(trade.price_per_share, currency: trade.currency) %>
          </span>
        </span>
        <span class="shrink-0 font-mono text-sm font-semibold text-fg-default">
          <%= format_currency_mx(trade.shares * trade.price_per_share, currency: trade.currency) %>
        </span>
      </li>
    <% end %>
  </ul>
</section>

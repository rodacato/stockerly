<%# Confirms in place instead of through a JS dialog, which is hostile on a
    phone. Same dom_id as the card it replaces. %>
<li id="<%= dom_id(trade) %>" class="flex flex-col gap-3 rounded-2xl border border-negative bg-negative-bg px-4 py-3 sm:flex-row sm:items-center">
  <span class="material-symbols-outlined shrink-0 text-negative-fg" aria-hidden="true">delete</span>

  <div class="min-w-0 flex-1">
    <p class="text-sm font-semibold text-negative-fg"><%= t("positions.index.confirmar_borrado") %></p>
    <p class="mt-0.5 text-xs text-negative-fg">
      <span class="font-mono font-semibold"><%= trade.asset.symbol %></span> ·
      <%= t("positions.index.movimiento_linea",
             fecha: l(trade.executed_at.to_date, format: :short),
             lado: t("positions.index.lado_#{trade.side}"),
             titulos: t("assets.index.titulos", count: format_shares(trade.shares)),
             precio: format_currency_mx(trade.price_per_share, currency: trade.currency, precision: 2)) %>
    </p>
  </div>

  <div class="flex shrink-0 items-center gap-2">
    <%= link_to t("comun.cancelar"), positions_path,
          class: "rounded-lg border border-border-default bg-bg-surface px-3 py-1.5 text-sm font-semibold text-fg-subtle" %>
    <%= button_to t("positions.index.si_eliminar"), trade_path(trade), method: :delete,
          class: "cursor-pointer rounded-lg bg-negative px-3 py-1.5 text-sm font-semibold text-fg-inverse" %>
  </div>
</li>

<%# Replaces the movement card in place. Same dom_id, so the Turbo Stream
    lands on the row the reader clicked. %>
<li id="<%= dom_id(trade) %>" class="rounded-2xl border border-primary bg-primary-muted px-4 py-3">
  <%= form_with(url: trade_path(trade), scope: :trade, method: :patch, class: "flex flex-col gap-3") do |f| %>
    <div class="flex items-center gap-2">
      <span class="font-mono text-sm font-bold text-fg-default"><%= trade.asset.symbol %></span>
      <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= trade.buy? ? "bg-positive-bg text-positive-fg" : "bg-warning-bg text-warning-fg" %>">
        <%= t("positions.index.lado_#{trade.side}") %>
      </span>
    </div>

    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <% [ [ :executed_at, t("trades.new.fecha") ], [ :shares, t("trades.new.titulos") ],
           [ :price_per_share, t("trades.new.precio") ], [ :fee, t("trades.new.comision") ] ].each do |field, label| %>
        <label class="flex flex-col gap-1">
          <span class="text-[11px] font-semibold uppercase tracking-wide text-fg-subtle"><%= label %></span>
          <% classes = "rounded-lg border border-border-default bg-bg-surface px-2 py-1.5 font-mono text-sm text-fg-default focus:outline-none focus:ring-2 focus:ring-focus" %>
          <% if field == :executed_at %>
            <%= f.datetime_local_field field, value: trade.executed_at.strftime("%Y-%m-%dT%H:%M"), class: classes %>
          <% else %>
            <%= f.number_field field, value: trade.public_send(field), step: "any", min: 0, class: "#{classes} text-right" %>
          <% end %>
        </label>
      <% end %>
    </div>

    <div class="flex items-center justify-end gap-2">
      <%= link_to t("comun.cancelar"), positions_path,
            class: "rounded-lg border border-border-default px-3 py-1.5 text-sm font-semibold text-fg-subtle transition-colors hover:border-border-strong" %>
      <%= f.submit t("comun.guardar"),
            class: "cursor-pointer rounded-lg bg-primary px-3 py-1.5 text-sm font-semibold text-fg-inverse transition-colors hover:bg-primary-hover" %>
    </div>
  <% end %>
</li>

<%# The kit's MovementItem, not a table row (KIT-4). It renders inside
    Historial and is the target of the Turbo Stream replaces that the inline
    edit and delete flows send, so the dom_id is load-bearing. %>
<% is_buy = trade.buy? %>
<li id="<%= dom_id(trade) %>" class="group flex items-center gap-3 rounded-2xl border border-border-default bg-bg-surface px-4 py-3">
  <div class="min-w-0 flex-1">
    <p class="font-mono text-sm font-bold text-fg-default"><%= trade.asset.symbol %></p>
    <p class="text-xs text-fg-subtle">
      <%= t("positions.index.movimiento_linea",
             fecha: l(trade.executed_at.to_date, format: :short),
             lado: t("positions.index.lado_#{trade.side}"),
             titulos: t("assets.index.titulos", count: number_with_precision(trade.shares, precision: trade.shares.to_d.frac.zero? ? 0 : 4)),
             precio: format_currency_mx(trade.price_per_share, currency: trade.currency, precision: 2)) %>
    </p>
  </div>

  <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= is_buy ? "bg-positive-bg text-positive-fg" : "bg-warning-bg text-warning-fg" %>">
    <%= t("positions.index.lado_#{trade.side}") %>
  </span>

  <% if trade.editable? %>
    <div class="flex shrink-0 items-center gap-1">
      <%= link_to edit_trade_path(trade), data: { turbo_method: :get, turbo_stream: true },
            class: "flex size-8 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-primary",
            aria: { label: t("positions.index.editar") } do %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">edit</span>
      <% end %>
      <%= link_to confirm_destroy_trade_path(trade), data: { turbo_method: :get, turbo_stream: true },
            class: "flex size-8 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:text-negative",
            aria: { label: t("positions.index.eliminar") } do %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">delete</span>
      <% end %>
    </div>
  <% end %>
</li>

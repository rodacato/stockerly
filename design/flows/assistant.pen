            {
              "type": "text",
              "id": "icjkJ",
              "name": "b",
              "fill": "$fg-default",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The assistant (ADR-031): ask about what is on screen, get a short answer written only over the data it read, with that data folded under it. Serves J7 — learning to read the numbers while using the app. Shipped (#872, #880, #884, #890): these artboards mirror the code (D78).",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "sgwXn",
          "name": "Entry points",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "w1NwN7",
              "name": "h",
              "fill": "$fg-subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",

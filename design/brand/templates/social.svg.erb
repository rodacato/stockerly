<svg xmlns="http://www.w3.org/2000/svg" width="<%= width %>" height="<%= height %>" viewBox="0 0 <%= width %> <%= height %>">
  <rect width="100%" height="100%" fill="<%= BrandAssets.color("bg-canvas") %>"/>
  <rect x="48" y="48" width="<%= width - 96 %>" height="<%= height - 96 %>" rx="20" fill="<%= BrandAssets.color("bg-surface") %>" stroke="<%= BrandAssets.color("border-default") %>"/>
  <g transform="translate(92 84) scale(2.1)" color="<%= BrandAssets.color("fg-default") %>"><%= wordmark %></g>
  <g font-family="Arial, sans-serif" fill="<%= BrandAssets.color("fg-default") %>">
    <text x="92" y="<%= height * 0.47 %>" font-size="52" font-weight="700"><%= copy.fetch("headline") %></text>
    <text x="92" y="<%= height * 0.47 + 72 %>" font-size="52" font-weight="700"><%= copy.fetch("headline_second") %></text>
    <text x="92" y="<%= height - 144 %>" font-size="25" fill="<%= BrandAssets.color("fg-subtle") %>"><%= copy.fetch("detail") %></text>
    <text x="92" y="<%= height - 94 %>" font-size="21" fill="<%= BrandAssets.color("primary-fg") %>"><%= copy.fetch("packaging") %></text>
  </g>
</svg>

<!DOCTYPE html>
<!-- Generated by bin/brand-assets; edit design/brand/templates/offline.html.erb. -->
<html lang="es-MX">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= copy.fetch("title") %></title>
  <style>
    :root {<% BrandAssets.palette.each do |role, color| %>--<%= role %>:<%= color %>;<% end %>}
    @media (prefers-color-scheme:dark) { :root {<% BrandAssets.palette(:dark).each do |role, color| %>--<%= role %>:<%= color %>;<% end %>} }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; display:grid; place-items:center; padding:24px; background:var(--bg-canvas); color:var(--fg-default); font-family:system-ui,sans-serif; }
    main { width:100%; max-width:440px; padding:28px; border:1px solid var(--border-default); border-radius:20px; background:var(--bg-surface); }
    .logo { width:174px; max-width:100%; height:40px; }
    h1 { margin:32px 0 12px; font-size:28px; line-height:1.3; }
    p { margin:0 0 24px; color:var(--fg-subtle); line-height:1.6; }
    a { display:inline-block; padding:12px 20px; border-radius:12px; background:var(--primary-fg); color:var(--fg-inverse); font-weight:600; text-decoration:none; }
    a:hover { background:var(--primary-hover); }
    a:focus-visible { outline:2px solid var(--primary-fg); outline-offset:4px; }
  </style>
</head>
<body>
  <main>
    <svg class="logo" viewBox="0 0 174 40" role="img" aria-label="Stockerly"><%= wordmark %></svg>
    <h1><%= copy.fetch("heading") %></h1>
    <p><%= copy.fetch("body") %></p>
    <a href="/dashboard"><%= copy.fetch("retry") %></a>
  </main>
</body>
</html>

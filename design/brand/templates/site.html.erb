<!doctype html>
<!-- Generated by bin/brand-preview; edit design/brand/templates/site.html.erb and site.yml. -->
<% base = "https://rodacato.github.io/stockerly/"
   og = c[:lang] == "en" ? "og-image.png" : "og-image-es.png"
   cmd = ->(label, tag, body) { %(<div class="rounded-card border border-border-default bg-bg-surface p-4"><div class="mb-3 flex justify-between gap-3 text-xs font-semibold uppercase tracking-widest text-fg-subtle"><span>#{label}</span><span>#{tag}</span></div><pre class="overflow-x-auto font-mono text-sm leading-relaxed">#{body}</pre></div>) }
   p_ = %(<span class="text-primary-fg" aria-hidden="true">$</span>)
   h2 = "text-3xl font-bold tracking-tight sm:text-4xl"
   sub = "mt-4 max-w-2xl text-base leading-relaxed text-fg-subtle"
   sect = "mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20"
   code_css = "[&_code]:rounded [&_code]:bg-bg-muted [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.9em]" %>
<html lang="<%= c[:lang] %>" data-theme="lumen">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= c[:title] %></title>
  <meta name="description" content="<%= c[:description].strip %>">
  <meta name="color-scheme" content="light dark">
  <link rel="canonical" href="<%= base %><%= c[:lang] == "en" ? "en.html" : "" %>">
  <link rel="alternate" hreflang="es-MX" href="<%= base %>">
  <link rel="alternate" hreflang="en" href="<%= base %>en.html">
  <link rel="alternate" hreflang="x-default" href="<%= base %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="<%= c[:og_locale] %>">
  <meta property="og:title" content="<%= c[:title] %>">
  <meta property="og:description" content="<%= c[:description].strip %>">
  <meta property="og:image" content="<%= base %><%= og %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= c[:og_alt] %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="assets/brand/glyph.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/application.css">
</head>
<body class="overflow-x-hidden bg-bg-canvas font-sans text-fg-default antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-bg-surface focus:p-4"><%= c[:skip] %></a>

  <header class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-4 sm:px-8">
    <a href="<%= c[:file] %>" aria-label="Stockerly"><%= logo %></a>
    <nav aria-label="Main" class="flex flex-wrap items-center gap-1 text-sm font-medium sm:gap-4">
      <a class="hidden min-h-11 items-center px-2 md:flex" href="#what"><%= c[:nav][:what] %></a>
      <a class="hidden min-h-11 items-center px-2 md:flex" href="#screens"><%= c[:nav][:screens] %></a>
      <a class="flex min-h-11 items-center px-2" href="#run"><%= c[:nav][:run] %></a>
      <a class="flex min-h-11 items-center px-2" href="https://github.com/rodacato/stockerly"><%= c[:nav][:github] %></a>
      <a class="flex min-h-11 items-center rounded-lg border border-border-strong px-3" href="<%= c[:other_file] %>" hreflang="<%= c[:lang] == "en" ? "es-MX" : "en" %>" lang="<%= c[:lang] == "en" ? "es-MX" : "en" %>"><%= c[:lang] == "en" ? "ES" : "EN" %></a>
      <button id="theme-toggle" type="button" aria-pressed="false" class="min-h-11 rounded-lg border border-border-strong px-3"><%= c[:theme][0] %></button>
    </nav>
  </header>

  <main id="main">
    <section class="mx-auto max-w-6xl px-5 pb-12 pt-8 sm:px-8 sm:pb-20 sm:pt-14" aria-labelledby="hero-title">
      <div class="grid items-start gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
        <div class="min-w-0">
          <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-primary-fg"><%= c[:eyebrow] %></p>
          <h1 id="hero-title" class="max-w-xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl"><%= c[:h1] %></h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-fg-subtle sm:text-lg"><%= c[:lede].strip %></p>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-fg-subtle"><%= c[:scope].strip %></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#run" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-primary-fg px-5 py-3 font-semibold text-bg-surface dark:text-fg-inverse"><%= c[:cta_run] %></a>
            <a href="https://github.com/rodacato/stockerly" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-xl border border-border-strong px-5 py-3 font-semibold"><%= c[:cta_code] %> <span aria-hidden="true">↗</span></a>
          </div>
          <div class="mt-8 min-w-0 max-w-xl"><%= cmd.(c[:hero_cmd], c[:hero_cmd_tag], "#{p_} git clone https://github.com/rodacato/stockerly.git\n#{p_} cd stockerly\n#{p_} bin/setup") %></div>
        </div>
        <figure class="min-w-0">
          <img src="assets/screens/cockpit-panorama-desktop.png" alt="<%= c[:shot_alt].strip %>" class="w-full rounded-card border border-border-default shadow-sm" width="1440" height="1000" fetchpriority="high">
        </figure>
      </div>
      <p class="mt-8 max-w-3xl text-sm leading-relaxed text-fg-subtle <%= code_css %>"><%= c[:shot_caption].strip %> <span class="block pt-3 text-xs"><%= c[:disclaimer].strip %></span></p>
    </section>

    <section id="what" class="border-y border-border-default bg-bg-surface">
      <div class="<%= sect %>">
        <h2 class="max-w-2xl <%= h2 %>"><%= c[:what][:h2] %></h2>
        <p class="<%= sub %>"><%= c[:what][:sub].strip %></p>
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
          <% c[:what][:cards].each_with_index do |card, i| %>
          <article class="border-t border-border-strong pt-5"><p class="font-mono text-xs text-primary-fg"><%= format("%02d", i + 1) %></p><h3 class="mt-4 text-lg font-bold"><%= card[:h] %></h3><p class="mt-3 text-sm leading-relaxed text-fg-subtle"><%= card[:p].strip %></p></article>
          <% end %>
        </div>
        <ul class="mt-10 flex flex-wrap gap-2 font-mono text-xs">
          <% c[:what][:stack].each do |s| %><li class="rounded-lg bg-bg-muted px-3 py-1.5"><%= s %></li><% end %>
        </ul>
      </div>
    </section>

    <section id="screens" class="<%= sect %>">
      <h2 class="<%= h2 %>"><%= c[:screens][:h2] %></h2>
      <p class="<%= sub %>"><%= c[:screens][:sub] %></p>
      <div class="mt-10 grid items-start gap-6 lg:grid-cols-2">
        <% c[:screens][:items].each do |s| %>
        <figure class="<%= s[:phone] ? "mx-auto w-full max-w-[220px]" : "min-w-0" %>"><a href="assets/screens/<%= s[:img] %>"><img src="assets/screens/<%= s[:img] %>" alt="<%= s[:alt] %>" loading="lazy" class="w-full rounded-card border border-border-default"></a><figcaption class="mt-3 text-sm text-fg-subtle"><b class="text-fg-default"><%= s[:b] %></b> — <%= s[:cap] %></figcaption></figure>
        <% end %>
      </div>
    </section>

    <section class="border-y border-border-default bg-bg-surface">
      <div class="<%= sect %>">
        <h2 class="<%= h2 %>"><%= c[:band][:h2] %></h2>
        <p class="<%= sub %>"><%= c[:band][:lede].strip %></p>
        <dl class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
          <% c[:band][:items].each do |i| %>
          <div class="border-t border-border-strong pt-4"><dt class="font-mono text-4xl font-medium"><%= i[:n] %></dt><dd class="mt-2 text-sm leading-relaxed text-fg-subtle"><%= i[:d] %></dd></div>
          <% end %>
        </dl>
      </div>
    </section>

    <section id="run" class="<%= sect %> <%= code_css %>">
      <h2 class="<%= h2 %>"><%= c[:run][:h2] %></h2>
      <p class="<%= sub %>"><%= c[:run][:sub].strip %></p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <% c[:run][:cards].each do |card| %>
        <div class="rounded-card border border-border-default bg-bg-surface p-5"><h3 class="font-bold"><%= card[:h] %></h3><p class="mt-2 text-sm leading-relaxed text-fg-subtle"><%= card[:p].strip %></p></div>
        <% end %>
      </div>
      <div class="mt-4 min-w-0"><%= cmd.(c[:run][:cmd_label], c[:run][:cmd_tag], "#{p_} bin/setup   <span class=\"text-fg-subtle\"># #{c[:run][:c1]}</span>\n#{p_} bin/jobs    <span class=\"text-fg-subtle\"># #{c[:run][:c2]}</span>\n\n  open http://localhost:4100") %></div>
      <p class="mt-4 rounded-xl bg-bg-muted p-5 text-sm leading-relaxed"><%= c[:run][:note].strip %></p>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-fg-subtle"><%= c[:run][:deploy].strip %></p>
    </section>

    <section id="notfor" class="border-y border-border-default bg-bg-surface">
      <div class="<%= sect %>">
        <h2 class="<%= h2 %>"><%= c[:notfor][:h2] %></h2>
        <p class="<%= sub %>"><%= c[:notfor][:sub].strip %></p>
        <dl class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <% c[:notfor][:items].each do |i| %>
          <div class="border-t border-border-strong pt-4"><dt class="font-bold"><%= i[:t] %></dt><dd class="mt-2 text-sm leading-relaxed text-fg-subtle"><%= i[:d] %></dd></div>
          <% end %>
        </dl>
      </div>
    </section>

    <section id="facts" class="<%= sect %> <%= code_css %>">
      <h2 class="<%= h2 %>"><%= c[:facts][:h2] %></h2>
      <dl class="mt-8 divide-y divide-border-default border-y border-border-default">
        <% c[:facts][:items].each do |i| %>
        <div class="grid gap-1 py-5 sm:grid-cols-[11rem_1fr] sm:gap-8"><dt class="text-sm font-semibold text-fg-subtle"><%= i[:k] %></dt><dd><%= i[:v].gsub("{version}", Stockerly::VERSION) %><span class="mt-1 block text-sm leading-relaxed text-fg-subtle"><%= i[:s].strip %></span></dd></div>
        <% end %>
      </dl>
    </section>
  </main>

  <footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-border-default px-5 py-6 text-xs text-fg-subtle sm:px-8">
    <p><%= c[:footer][:made] %> · v<%= Stockerly::VERSION %></p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2"><% c[:footer][:links].each do |label, href| %><a class="underline-offset-2 hover:underline" href="<%= href %>"><%= label %></a><% end %></nav>
  </footer>
  <script>
    const toggle = document.getElementById("theme-toggle");
    const labels = <%= c[:theme].to_json %>;
    const setDark = dark => {
      document.documentElement.classList.toggle("dark", dark);
      toggle.setAttribute("aria-pressed", String(dark));
      toggle.textContent = labels[dark ? 1 : 0];
    };
    toggle.addEventListener("click", () => setDark(!document.documentElement.classList.contains("dark")));
    setDark(window.matchMedia("(prefers-color-scheme: dark)").matches);
  </script>
</body>
</html>

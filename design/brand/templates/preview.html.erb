<!doctype html>
<!-- Generated by bin/brand-preview; edit design/brand/templates/preview.html.erb. -->
<html lang="en" data-theme="lumen">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A self-hosted, single-user investment tracker for stocks, crypto and Mexican fixed income, with MXN and USD support.">
  <% if preview %><meta name="robots" content="noindex, nofollow"><% else %>
  <link rel="canonical" href="https://rodacato.github.io/stockerly/">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://rodacato.github.io/stockerly/">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="Stockerly — Your investments, in one clear view">
  <meta property="og:description" content="Self-hosted investment tracking for one person. Stocks, crypto and Mexican fixed income across MXN and USD.">
  <meta property="og:image" content="https://rodacato.github.io/stockerly/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Stockerly. Your investments, in one clear view. Self-hosted tracking in MXN and USD.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Stockerly — Your investments, in one clear view">
  <meta name="twitter:description" content="Self-hosted investment tracking for one person, across MXN and USD.">
  <meta name="twitter:image" content="https://rodacato.github.io/stockerly/og-image.png">
  <meta name="twitter:image:alt" content="Stockerly. Your investments, in one clear view. Self-hosted tracking in MXN and USD.">
  <% end %>
  <title>Stockerly — Your investments, in one clear view</title>
  <link rel="icon" href="assets/brand/glyph.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/application.css">
  <style>
    .preview-section { scroll-margin-top: 2rem; }
    .preview-swatch { background: var(--swatch); }
    .preview-light { background: <%= BrandAssets.color("bg-canvas") %>; color: <%= BrandAssets.color("fg-default") %>; }
    .preview-dark { background: <%= BrandAssets.color("bg-canvas", :dark) %>; color: <%= BrandAssets.color("fg-default", :dark) %>; }
  </style>
</head>
<body class="bg-bg-canvas font-sans text-fg-default antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-bg-surface focus:p-4">Skip to content</a>
  <% if preview %><div class="border-b border-border-default bg-bg-muted px-4 py-2 text-center text-xs text-fg-default">Branding &amp; marketing preview · G / Soft Candle · Local draft</div><% end %>
  <header class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-6 sm:px-8">
    <a href="#main" aria-label="Stockerly home"><%= logo %></a>
    <nav aria-label="Main navigation" class="flex flex-wrap items-center gap-1 text-sm font-medium sm:gap-5">
      <a class="flex min-h-11 items-center px-2" href="#product">Product</a>
      <a class="flex min-h-11 items-center px-2" href="#brand">Brand</a>
      <a class="flex min-h-11 items-center px-2" href="#downloads">Downloads</a>
      <button id="theme-toggle" type="button" aria-pressed="false" class="min-h-11 rounded-xl border border-border-strong px-4 text-fg-default">Dark mode</button>
    </nav>
  </header>

  <main id="main">
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-10 sm:px-8 sm:pb-24 sm:pt-16 lg:grid-cols-2 lg:gap-10" aria-labelledby="hero-title">
      <div>
        <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-primary-fg">A personal view of your investments</p>
        <h1 id="hero-title" class="max-w-xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Your investments,<br>in one clear view.</h1>
        <p class="mt-6 max-w-lg text-base leading-relaxed text-fg-subtle sm:text-lg">A self-hosted portfolio tracker for stocks, crypto and Mexican fixed income. Understand your holdings, cost basis and currency effects across MXN and USD.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://github.com/rodacato/stockerly" class="inline-flex min-h-12 items-center justify-center gap-5 rounded-xl bg-primary-fg px-5 py-3 font-semibold text-bg-surface dark:text-fg-inverse">Explore the project <span aria-hidden="true">↗</span></a>
          <a href="#run" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-border-strong px-5 py-3 font-semibold">Run your instance</a>
        </div>
        <p class="mt-5 text-sm text-fg-subtle">Open source <span aria-hidden="true">·</span> Single user <span aria-hidden="true">·</span> MXN / USD</p>
      </div>

      <figure class="min-w-0 rounded-card border border-border-default bg-bg-surface p-5 shadow-sm sm:p-7" aria-labelledby="demo-label">
        <figcaption id="demo-label" class="mb-6 flex flex-wrap items-center justify-between gap-2 border-b border-border-default pb-4">
          <span class="flex items-center gap-2 font-display text-sm font-bold"><%= mark.call(26) %> Portfolio overview</span>
          <span class="rounded-md bg-bg-muted px-2 py-1 text-xs text-fg-default">Illustrative data</span>
        </figcaption>
        <p class="text-sm text-fg-subtle">Investment value</p>
        <p class="mt-2 flex flex-wrap items-baseline gap-x-2 font-mono"><span class="text-3xl font-medium tracking-tight sm:text-4xl">124,800.00</span><span class="text-sm text-fg-subtle">MXN</span></p>
        <div class="mt-6 grid grid-cols-2 gap-4 border-y border-border-default py-5">
          <div><p class="text-xs text-fg-subtle">Cost basis</p><p class="mt-2 font-mono text-sm font-medium">110,000.00 <span class="text-xs text-fg-subtle">MXN</span></p></div>
          <div><p class="text-xs text-fg-subtle">Unrealized result</p><p class="mt-2 font-mono text-sm font-medium text-positive-fg">+14,800.00 <span class="text-xs">MXN</span></p><p class="mt-1 text-xs text-fg-subtle">+13.5% vs. cost basis</p></div>
        </div>
        <div class="mt-5 flex items-center justify-between gap-3"><h2 class="font-sans text-sm font-semibold">Two currencies. One view.</h2><span class="font-mono text-xs text-fg-subtle">MXN</span></div>
        <div class="mt-3 flex h-2 overflow-hidden rounded-full bg-bg-muted" aria-label="Demo USD stock: 84.6 percent; demo MXN stock: 15.4 percent"><span class="w-[84.6%] bg-primary"></span><span class="flex-1 bg-chart-2"></span></div>
        <dl class="mt-4 space-y-4 text-sm">
          <div class="flex justify-between gap-3"><dt><span class="mr-2 inline-block h-2 w-2 rounded-full bg-primary"></span>Demo USD stock <span class="block pl-4 text-xs text-fg-subtle">6,000.00 USD</span></dt><dd class="font-mono text-right">105,600.00 <span class="block text-xs text-fg-subtle">MXN</span></dd></div>
          <div class="flex justify-between gap-3"><dt><span class="mr-2 inline-block h-2 w-2 rounded-full bg-chart-2"></span>Demo MXN stock <span class="block pl-4 text-xs text-fg-subtle">192 shares × 100.00 MXN</span></dt><dd class="font-mono text-right">19,200.00 <span class="block text-xs text-fg-subtle">MXN</span></dd></div>
        </dl>
        <p class="mt-5 border-t border-border-default pt-4 text-xs leading-relaxed text-fg-subtle">Example conversion: 1 USD = 17.60 MXN.<br>Fictional quotes · 12 Oct 2026, 16:00 Mexico City.<br>No live prices or account data.</p>
      </figure>
    </section>

    <section id="product" class="preview-section border-y border-border-default bg-bg-surface" aria-labelledby="product-title">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
        <div class="grid gap-6 sm:grid-cols-2 sm:gap-12">
          <h2 id="product-title" class="max-w-sm text-3xl font-bold leading-tight tracking-tight">Know what you own.<br>Understand what changed.</h2>
          <p class="max-w-lg text-base leading-relaxed text-fg-subtle">Built for a personal portfolio, with the Mexican market in mind. Stockerly describes what it observes, so you can read the numbers in their context.</p>
        </div>
        <div class="mt-10 grid gap-8 lg:grid-cols-3 lg:gap-10">
          <% [
            ["01", "Holdings without guesswork", "Record trades or review a CSV import. Bring stocks, crypto and CETES together with their original currencies and cost basis."],
            ["02", "Returns with context", "Read portfolio history and unrealized results. Where available, separate asset movement from the effect of MXN / USD conversion."],
            ["03", "A tool you can run yourself", "One account, created at first setup. Configure optional data providers and keep the application on your own infrastructure."]
          ].each do |number, title, detail| %>
          <article class="border-t border-border-strong pt-5"><p class="font-mono text-xs text-primary-fg"><%= number %></p><h3 class="mt-4 text-lg font-bold"><%= title %></h3><p class="mt-3 text-sm leading-relaxed text-fg-subtle"><%= detail %></p></article>
          <% end %>
        </div>
        <aside class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-xl bg-bg-muted p-5">
          <div class="max-w-xl"><h3 class="font-sans text-sm font-semibold">Missing data should look like missing data.</h3><p class="mt-1 text-sm leading-relaxed text-fg-default">An unavailable quote is shown as unavailable. A value of zero means zero. Dates, currencies and sources make the difference visible.</p></div>
          <span class="rounded-lg border border-border-strong bg-bg-surface px-4 py-3 font-mono text-sm">— <span class="ml-2 font-sans text-fg-subtle">Quote unavailable</span></span>
        </aside>
      </div>
    </section>

    <section id="brand" class="preview-section mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20" aria-labelledby="brand-title">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-fg">Lumen / Brand identity</p>
      <div class="mt-4 grid gap-6 sm:grid-cols-2 sm:gap-12"><h2 id="brand-title" class="text-3xl font-bold tracking-tight">One candle.<br>A clear point of view.</h2><p class="max-w-lg text-base leading-relaxed text-fg-subtle">A rounded market candle, drawn with one continuous line. It connects Stockerly to the language of markets without promising a direction, a trade or a result.</p></div>
      <div class="mt-9 grid gap-4 sm:grid-cols-2">
        <div class="preview-light flex min-h-64 flex-col items-center justify-center gap-6 rounded-card border border-border-default p-6"><%= mark.call(112, BrandAssets.color("primary")) %><img src="assets/brand/wordmark-light.svg" width="174" height="40" alt="Stockerly light wordmark"><p class="text-xs" style="color:<%= BrandAssets.color("fg-subtle") %>">Light / warm canvas</p></div>
        <div class="preview-dark flex min-h-64 flex-col items-center justify-center gap-6 rounded-card border border-border-default p-6"><%= mark.call(112, BrandAssets.color("primary", :dark)) %><img src="assets/brand/wordmark-dark.svg" width="174" height="40" alt="Stockerly dark wordmark"><p class="text-xs" style="color:<%= BrandAssets.color("fg-subtle", :dark) %>">Dark / quiet surface</p></div>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-card border border-border-default bg-bg-surface p-6"><h3 class="font-sans text-sm font-semibold">Recognizable at small sizes</h3><div class="mt-5 flex items-end gap-8"><% [16, 32, 64].each do |size| %><div class="flex flex-col items-center gap-3"><%= mark.call(size) %><span class="font-mono text-xs text-fg-subtle"><%= size %> px</span></div><% end %></div><p class="mt-5 text-sm leading-relaxed text-fg-subtle">Keep the supplied viewBox and stroke. Give the mark space; use the wordmark when the name needs to be read.</p></div>
        <div class="min-w-0 rounded-card border border-border-default bg-bg-surface p-6"><h3 class="font-sans text-sm font-semibold">Works in one color</h3><div class="mt-5 flex flex-wrap items-center gap-6"><%= mark.call(64, "currentColor") %><svg class="h-10 w-auto" viewBox="0 0 174 40" role="img" aria-label="Stockerly monochrome wordmark"><g transform="scale(.625)"><%= glyph %></g><%= letters %></svg></div><p class="mt-5 text-sm leading-relaxed text-fg-subtle">The lettering is outlined SVG geometry. The logo stays intact without installed fonts.</p></div>
      </div>

      <div class="mt-12 grid gap-9 lg:grid-cols-2 lg:gap-16">
        <div><h3 class="text-xl font-bold">A calm, specific voice.</h3><p class="mt-3 text-sm leading-relaxed text-fg-subtle">Describe observations. Name currencies, dates and periods. Say when information is missing. Avoid investment advice, guarantees and manufactured social proof.</p><div class="mt-5 border-l-2 border-primary pl-5"><p class="text-base font-medium">“Unrealized result · +14,800.00 MXN”</p><p class="mt-2 text-sm text-fg-subtle">“Quote unavailable · last update shown when known”</p></div></div>
        <div><h3 class="text-xl font-bold">Type with a purpose.</h3><dl class="mt-5 space-y-4"><div class="flex flex-wrap justify-between gap-2 border-b border-border-default pb-3"><dt class="font-display text-lg font-bold">Plus Jakarta Sans</dt><dd class="text-sm text-fg-subtle">Headings / identity</dd></div><div class="flex flex-wrap justify-between gap-2 border-b border-border-default pb-3"><dt class="font-sans text-lg">Inter</dt><dd class="text-sm text-fg-subtle">Interface / reading</dd></div><div class="flex flex-wrap justify-between gap-2 border-b border-border-default pb-3"><dt class="font-mono text-base">JetBrains Mono</dt><dd class="text-sm text-fg-subtle">Values / precision</dd></div></dl></div>
      </div>
      <div class="mt-12"><h3 class="text-xl font-bold">The same Lumen tokens as the app.</h3><p class="mt-2 text-sm text-fg-subtle">Color roles adapt together. These values come from application.css.</p><div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4"><% swatches.each do |role| %><div class="overflow-hidden rounded-xl border border-border-default bg-bg-surface"><div class="preview-swatch h-16 border-b border-border-default" style="--swatch:var(--color-<%= role %>)"></div><p class="px-3 pt-3 font-mono text-xs"><%= role %></p><p class="token-value px-3 pb-3 pt-1 font-mono text-xs text-fg-subtle" data-role="<%= role %>" data-light="<%= BrandAssets.color(role) %>" data-dark="<%= BrandAssets.color(role, :dark) %>"><%= BrandAssets.color(role) %></p></div><% end %></div></div>
    </section>

    <section id="downloads" class="preview-section border-y border-border-default bg-bg-surface" aria-labelledby="downloads-title">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
        <div class="grid gap-6 sm:grid-cols-2 sm:gap-12"><div><p class="text-xs font-semibold uppercase tracking-widest text-primary-fg">Brand files</p><h2 id="downloads-title" class="mt-4 text-3xl font-bold tracking-tight">Ready to use.<br>Easy to reproduce.</h2></div><p class="max-w-lg self-end text-sm leading-relaxed text-fg-subtle">Editable SVGs and generated PNGs share one mark and the current application tokens. The outlined wordmark works without installed fonts.</p></div>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <% [
            ["Glyph", "Editable SVG / single continuous path", "brand/glyph.svg"],
            ["Wordmark · light", "Outlined SVG / no font dependency", "brand/wordmark-light.svg"],
            ["Wordmark · dark", "Outlined SVG / dark surfaces", "brand/wordmark-dark.svg"],
            ["Wordmark · monochrome", "Outlined SVG / one-color use", "brand/wordmark-mono.svg"],
            ["App icon", "PNG / 192 × 192", "icon-192.png"],
            ["Maskable icon", "PNG / 512 × 512", "icon-maskable-512.png"],
            ["Social card", "PNG / 1200 × 630", "../og-image.png"],
            ["GitHub Social Preview", "PNG / 1280 × 640", "../github-social-preview.png"]
          ].each do |title, detail, path| %><a href="assets/<%= path %>" download class="flex min-h-20 items-center justify-between gap-4 rounded-xl border border-border-default p-4 hover:border-primary"><span><span class="block text-sm font-semibold"><%= title %></span><span class="mt-1 block text-xs text-fg-subtle"><%= detail %></span></span><span class="text-primary-fg" aria-hidden="true">↓</span></a><% end %>
        </div>
      </div>
    </section>
    <section id="run" class="preview-section mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16"><h2 class="text-2xl font-bold tracking-tight">Your portfolio. Your instance.</h2><p class="mt-3 max-w-2xl text-sm leading-relaxed text-fg-subtle">Run Stockerly with the documented devcontainer or manual setup. The first-boot wizard creates the single account. Market data depends on the providers you configure; portfolio pages require a network connection. Offline, the app shows a retry page.</p><div class="mt-6 flex flex-wrap gap-3"><a href="https://github.com/rodacato/stockerly/blob/master/GETTING_STARTED.md" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-primary-fg px-5 py-3 font-semibold text-bg-surface dark:text-fg-inverse">Read setup instructions <span class="ml-5" aria-hidden="true">↗</span></a><a href="https://github.com/rodacato/stockerly/blob/master/design/brand/README.md" class="inline-flex min-h-12 items-center rounded-xl border border-border-strong px-5 py-3 font-semibold">Brand sources and generation</a></div></section>
  </main>
  <footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-border-default px-5 py-6 text-xs text-fg-subtle sm:px-8"><p>Stockerly · <span data-version><%= Stockerly::VERSION %></span> · Self-hosted investment tracking</p><p><%= "Local presentation draft · " if preview %>All displayed figures are fictional.</p></footer>
  <script>
    const toggle = document.getElementById("theme-toggle");
    const setDark = dark => {
      document.documentElement.classList.toggle("dark", dark);
      toggle.setAttribute("aria-pressed", String(dark));
      toggle.textContent = dark ? "Light mode" : "Dark mode";
      document.querySelectorAll(".token-value").forEach(value => { value.textContent = dark ? value.dataset.dark : value.dataset.light; });
    };
    toggle.addEventListener("click", () => setDark(!document.documentElement.classList.contains("dark")));
    setDark(window.matchMedia("(prefers-color-scheme: dark)").matches);
  </script>
</body>
</html>

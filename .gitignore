# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Local workspace artifacts (design mockups, scratch notes, etc.) that should
# never be committed to the repo.
/.local/

# Local research workspace (audits, market studies, technical primers).
# Source material for future issues/sprints; not part of the codebase.
/.research/

# Ignore bundler config.
/.bundle

# Ignore all environment files (except .env.example).
/.env*
!/.env.example

# Local, non-secret Kamal values for the devcontainer.
/.devcontainer/local.env

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore SimpleCov coverage output
/coverage

# Ignore key files for decrypting credentials and more.
/config/*.key
# Anchored above, so it misses the per-environment keys Rails nests here.
/config/credentials/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# LLM / AI tool files
.claude/
.cursor/
.cursorignore
.cursorindexingignore
.cursorrules
.gemini/
.aider*
.copilot/
.github/copilot*
.openai/
.codeium/
.continue/
.windsurf/

# kwik-e: personal AI memory + local overrides — synced via rodacato/kwik-e-mart, never committed
.kwik-e/
CLAUDE.local.md
CLAUDE.kwik.md
.mcp.json

# redesign/: 2.0 discovery + design hub — kept local while we clean up in place
/redesign/

# Pencil design system: device captures with real user data — local only
design/references/

# Pencil editor stray at repo root
/base.pen

# Python venv for the yfinance bridge
/.venv

# Personal blog-post scratchpad — kept locally, never published with the repo
/BITACORA_2_0.md

# Bytecode from the bundled Python bridge
lib/python/__pycache__/

# Copy to .devcontainer/local.env (gitignored) to run read-only Kamal commands
# such as `kamal config` from inside the devcontainer.
#
# Non-secret values only. Never add SECRET_KEY_BASE, POSTGRES_PASSWORD,
# DATABASE_URL, the Active Record Encryption keys, or any API token: a
# compromised container would hand over production. Deploys run in CI.
#
# GITHUB_REPOSITORY and GITHUB_ACTOR are derived from the git remote, so they
# are not listed here.

HOST_IP=

# Copy to .devcontainer/local.env (gitignored) to run Kamal against your server
# from the devcontainer, then rebuild the container. See .devcontainer/README.md.
#
# Only what cannot be derived. GITHUB_REPOSITORY, GITHUB_REPOSITORY_OWNER,
# GITHUB_ACTOR and GH_TOKEN come from the host through initialize.sh; a value
# set here overrides it.
#
# No production secrets: never SECRET_KEY_BASE, POSTGRES_PASSWORD, DATABASE_URL,
# the Active Record Encryption keys or a provider API key. A compromised
# container would hand over production. Deploys run in GitHub Actions.

HOST_IP=
APP_HOST=

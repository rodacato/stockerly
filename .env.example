# Database (devcontainer defaults)
DATABASE_HOST=db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Active Record Encryption (generate with: bin/rails db:encryption:init)
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ---------------------------------------------------------------------------
# Market data providers
#
# The app does NOT read provider keys from ENV. They live encrypted in the
# integrations table — paste them in Admin > Integrations. Each self-hoster
# brings their own accounts; no credential ships with this repo.
#
# The names below are the exact Integration#provider_name the gateways resolve
# against, so what you paste has to match the name, not the vendor's branding.
#
#   Polygon.io      https://polygon.io/dashboard/signup
#                   retiring — rebranded to Massive.com, api.polygon.io phasing out
#   Finnhub         https://finnhub.io/register
#   Alpha Vantage   https://www.alphavantage.co/support/#api-key
#                   free tier is 25 calls/day; unlimited for verified OSS projects
#   FMP             https://site.financialmodelingprep.com/developer/docs
#                   /api/v3 is legacy-gated to accounts created before 2025-08-31
#   ExchangeRate    https://www.exchangerate-api.com/
#   Banxico         https://www.banxico.org.mx/SieAPIRest/service/v1/token
#                   one token serves both FX and CETES; abuse blocks it a full day
#   CoinGecko       https://www.coingecko.com/en/api/pricing
#   Yahoo Finance   no key
#   Alternative.me  no key
#
# Planned — gateways not built yet:
#   Alpaca          https://app.alpaca.markets/signup
#                   paper account is enough; historical SIP needs feed=sip
#   DataBursatil    https://databursatil.com
#                   BMV/BIVA; quota is 200,000 credits/month, 1 credit = 1 KiB
#
# ---------------------------------------------------------------------------
# Provider exploration (redesign/probes/probe.rb only — never read by the app)
#
# Local, throwaway, and the only place ENV holds provider credentials. Keep the
# real values in .env (gitignored) or export them in your shell.
#
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# DATABURSATIL_TOKEN=
# DB_BASE_URL=                   # base that answered 200 in databursatil-discover

# Error tracking (Sentry)
# SENTRY_DSN=                    # get from https://sentry.io project settings
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=

# Email (Resend SMTP)
# RESEND_API_KEY=                # get from https://resend.com/api-keys
# RESEND_WEBHOOK_SECRET=         # whsec_... from https://resend.com/webhooks (signing secret)

# Deployment (only needed for Kamal deploy)
# SECRET_KEY_BASE=        # generate with: bin/rails secret
# DATABASE_URL=
# POSTGRES_PASSWORD=
# HOST_IP=
# KAMAL_REGISTRY_PASSWORD=
